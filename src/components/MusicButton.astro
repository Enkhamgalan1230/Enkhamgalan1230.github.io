<button class="music-button" type="button" aria-label="Open music" title="Music">
  <span aria-hidden="true">&#9834;</span>
</button>

<div class="music-overlay" aria-hidden="true">
  <div class="music-card" role="dialog" aria-modal="true" aria-label="Music">
    <button class="music-card-close" type="button" aria-label="Close music dialog">&times;</button>
    <div class="music-card-note" aria-hidden="true">&#9834;</div>

    <div class="music-card-content">
      <div class="music-heading-row">
        <div>
          <span class="music-card-label" data-listening-label>NOW PLAYING</span>
          <h2 data-listening-heading>What I’m listening to</h2>
        </div>
        <button class="spotify-connect" type="button" data-spotify-connect>UPDATE</button>
      </div>

      <a class="current-track" data-now-playing href="#" target="_blank" rel="noreferrer">
        <span class="current-track-placeholder" data-now-playing-placeholder>Loading my listening activity...</span>
        <img data-now-playing-image alt="" hidden />
          <span data-now-playing-copy hidden>
            <strong data-now-playing-title></strong>
            <small data-now-playing-artist></small>
            <small class="now-playing-status"><i data-now-playing-dot></i><span data-now-playing-state>PLAYING NOW</span><span data-now-playing-time></span></small>
          </span>
        <span class="music-track-arrow" aria-hidden="true">&#8599;</span>
      </a>

      <h3 class="music-section-title">MY TOP ARTISTS</h3>
      <div class="music-artists" data-top-artists><p class="music-muted">Your top artists will appear here.</p></div>

      <p class="music-taste">
        My music taste is wonderfully unpredictable. It changes with the weather,
        what I am doing and whatever mood I happen to be in. Soft rock can
        soundtrack a gym session, while an evening at home might call for drill.
        Hip hop, pop and indie rock are always in the mix, with Brazilian phonk
        for intense workouts and Mongolian music making up a surprisingly large
        part of my playlists. Biggie Smalls and Ariana Grande also both get
        regular play — I know, quite the combination.
      </p>

      <h3 class="music-section-title top-tracks-heading">MY TOP TRACKS</h3>
      <ol class="music-track-list" data-top-tracks><li class="music-muted">Your top tracks will appear here.</li></ol>

      <h3 class="music-section-title recommendation-heading">RECOMMEND SOMETHING</h3>
      <p class="recommendation-note">
        I am getting tired of my playlist, so send me a recommendation.
        <em>I hate techno, so please do not send that.</em>
      </p>

      <form class="recommendation-form" data-recommendation-form>
        <label class="sr-only" for="recommended-song">Song recommendation</label>
        <div class="song-search-wrap">
          <input id="recommended-song" name="song" type="search" autocomplete="off" placeholder="Search Spotify for a song..." required />
          <div class="song-search-results" data-search-results></div>
        </div>
        <label class="sr-only" for="recommender-name">Your name</label>
        <input id="recommender-name" name="name" type="text" placeholder="Your name" required />
        <button type="submit">SEND IT TO ME &#8599;</button>
        <p class="recommendation-status" data-recommendation-status role="status" aria-live="polite"></p>
      </form>
    </div>
  </div>
</div>

<script>
  const SPOTIFY_API_URL = "https://enkhamgalan-spotify-api.zaecisama.workers.dev/api/spotify";
  const musicButton = document.querySelector<HTMLButtonElement>(".music-button");
  const overlay = document.querySelector<HTMLElement>(".music-overlay");
  const closeButton = document.querySelector<HTMLButtonElement>(".music-card-close");
  const connectButton = document.querySelector<HTMLButtonElement>("[data-spotify-connect]");
  const label = document.querySelector<HTMLElement>("[data-listening-label]");
  const heading = document.querySelector<HTMLElement>("[data-listening-heading]");
  const nowPlaying = document.querySelector<HTMLAnchorElement>("[data-now-playing]");
  const placeholder = document.querySelector<HTMLElement>("[data-now-playing-placeholder]");
  const nowImage = document.querySelector<HTMLImageElement>("[data-now-playing-image]");
  const nowCopy = document.querySelector<HTMLElement>("[data-now-playing-copy]");
  const nowTitle = document.querySelector<HTMLElement>("[data-now-playing-title]");
  const nowArtist = document.querySelector<HTMLElement>("[data-now-playing-artist]");
  const nowDot = document.querySelector<HTMLElement>("[data-now-playing-dot]");
  const nowState = document.querySelector<HTMLElement>("[data-now-playing-state]");
  const nowTime = document.querySelector<HTMLElement>("[data-now-playing-time]");
  const artistsContainer = document.querySelector<HTMLElement>("[data-top-artists]");
  const tracksContainer = document.querySelector<HTMLOListElement>("[data-top-tracks]");
  const form = document.querySelector<HTMLFormElement>("[data-recommendation-form]");
  const status = document.querySelector<HTMLElement>("[data-recommendation-status]");
  const songInput = document.querySelector<HTMLInputElement>("#recommended-song");
  const searchResults = document.querySelector<HTMLElement>("[data-search-results]");
  let refreshTimer: number | undefined;
  let searchTimer: number | undefined;
  let selectedSongUrl = "";

  async function spotify(type: string, query = "") {
    const url = new URL(SPOTIFY_API_URL);
    url.searchParams.set("type", type);
    if (query) url.searchParams.set("q", query);
    const response = await fetch(url);
    if (!response.ok) return null;
    return response.json();
  }

  const names = (items: Array<{ name: string }> = []) => items.map((item) => item.name).join(", ");
  const escapeHtml = (value: unknown) => String(value ?? "").replace(/[&<>'"]/g, (character) => ({ "&": "&amp;", "<": "&lt;", ">": "&gt;", "'": "&#39;", '"': "&quot;" })[character] ?? character);
  const formatTime = (milliseconds: number) => {
    const seconds = Math.max(0, Math.floor(milliseconds / 1000));
    return `${Math.floor(seconds / 60)}:${String(seconds % 60).padStart(2, "0")}`;
  };

  function renderListening(current: any, recent: any) {
    const track = current ?? recent;
    const playing = Boolean(current?.isPlaying);
    if (!track) {
      if (label) label.textContent = "SPOTIFY OFFLINE";
      if (heading) heading.textContent = "Nothing playing right now.";
      if (placeholder) { placeholder.hidden = false; placeholder.textContent = "Start a song on Spotify and it will appear here."; }
      if (nowImage) { nowImage.hidden = true; nowImage.removeAttribute("src"); }
      if (nowCopy) nowCopy.hidden = true;
      if (nowDot) nowDot.classList.remove("is-playing");
      if (nowState) nowState.textContent = "NOT PLAYING";
      if (nowTime) nowTime.textContent = "";
      if (nowPlaying) nowPlaying.href = "#";
      return;
    }
    if (label) label.textContent = playing ? "CURRENTLY LISTENING TO" : "LAST LISTENED";
    if (heading) heading.textContent = playing ? "What am I listening to?" : "The last thing I played.";
    if (placeholder) placeholder.hidden = true;
    if (nowImage) { nowImage.hidden = false; nowImage.src = track.image; nowImage.alt = `${track.name} album art`; }
    if (nowCopy) nowCopy.hidden = false;
    if (nowTitle) nowTitle.textContent = track.name;
    if (nowArtist) nowArtist.textContent = `${track.artists} · ${track.album}`;
    if (nowDot) nowDot.classList.toggle("is-playing", playing);
    if (nowState) nowState.textContent = playing ? "PLAYING NOW" : "LAST PLAYED";
    if (nowTime) nowTime.textContent = track.progress != null && track.duration != null ? `${formatTime(track.progress)} / ${formatTime(track.duration)}` : "";
    if (nowPlaying) nowPlaying.href = track.url;
  }

  function renderArtists(items: any[] = []) {
    if (!artistsContainer) return;
    artistsContainer.innerHTML = items.length ? items.map((artist) => `<article class="artist-card"><img src="${escapeHtml(artist.image)}" alt="" loading="lazy" /><a href="${escapeHtml(artist.url)}" target="_blank" rel="noreferrer"><span>${escapeHtml(artist.name)}</span></a><small>OPEN &#8599;</small></article>`).join("") : `<p class="music-muted">No top artist data available yet.</p>`;
  }

  function renderTracks(items: any[] = []) {
    if (!tracksContainer) return;
    tracksContainer.innerHTML = items.length ? items.map((item, index) => `<li><a class="music-track" href="${item.url}" target="_blank" rel="noreferrer"><span class="music-track-number">${String(index + 1).padStart(2, "0")}</span><img src="${item.image}" alt="" loading="lazy" /><span class="music-track-copy"><strong>${item.name}</strong><small>${item.artists} · ${item.album}</small></span><span class="music-track-arrow" aria-hidden="true">&#8599;</span></a></li>`).join("") : `<li class="music-muted">No top track data available yet.</li>`;
  }

  async function loadData() {
    if (connectButton) { connectButton.hidden = false; connectButton.disabled = true; connectButton.textContent = "LOADING..."; }
    try {
      const data = await spotify("all");
      if (!data) throw new Error("The Spotify service is unavailable.");
      renderListening(data.current, data.recent);
      renderArtists(data.artists);
      renderTracks(data.tracks);
      if (data.errors?.some((item: any) => item.section === "currentlyPlaying")) {
        if (label) label.textContent = "SPOTIFY NEEDS ATTENTION";
        if (heading) heading.textContent = "Playback is temporarily unavailable.";
        if (placeholder) { placeholder.hidden = false; placeholder.textContent = "The Spotify Worker needs to be re-authorized."; }
      }
    } catch (error) {
      if (label) label.textContent = "SPOTIFY UNAVAILABLE";
      if (heading) heading.textContent = "I cannot check Spotify right now.";
      if (placeholder) { placeholder.hidden = false; placeholder.textContent = "Please try refreshing in a moment."; }
      console.error("Could not load Spotify data", error);
    } finally {
      if (connectButton) { connectButton.disabled = false; connectButton.textContent = "REFRESH"; }
    }
  }

  async function search(query: string) {
    if (!searchResults || query.trim().length < 2) { if (searchResults) searchResults.innerHTML = ""; return; }
    const result = await spotify("search", query);
    searchResults.innerHTML = (result?.tracks ?? []).map((item: any) => `<button type="button" class="search-result" data-song-url="${item.url}" data-song-label="${item.name} — ${item.artists}"><img src="${item.image}" alt="" /><span><strong>${item.name}</strong><small>${item.artists}</small></span></button>`).join("");
  }

  function open() { if (!overlay) return; overlay.classList.add("is-open"); overlay.setAttribute("aria-hidden", "false"); document.body.style.overflow = "hidden"; closeButton?.focus(); loadData(); refreshTimer = window.setInterval(loadData, 15000); }
  function close() { if (!overlay) return; overlay.classList.remove("is-open"); overlay.setAttribute("aria-hidden", "true"); document.body.style.overflow = ""; if (refreshTimer) window.clearInterval(refreshTimer); musicButton?.focus(); }
  connectButton?.addEventListener("click", loadData);
  musicButton?.addEventListener("click", open);
  closeButton?.addEventListener("click", close);
  overlay?.addEventListener("click", (event) => { if (event.target === overlay) close(); });
  songInput?.addEventListener("input", () => { selectedSongUrl = ""; if (searchTimer) window.clearTimeout(searchTimer); searchTimer = window.setTimeout(() => search(songInput.value), 350); });
  searchResults?.addEventListener("click", (event) => { const result = (event.target as HTMLElement).closest<HTMLButtonElement>("[data-song-url]"); if (!result || !songInput) return; songInput.value = result.dataset.songLabel ?? ""; selectedSongUrl = result.dataset.songUrl ?? ""; searchResults.innerHTML = ""; });
  form?.addEventListener("submit", (event) => { event.preventDefault(); const data = new FormData(form); const song = String(data.get("song") ?? "").trim(); const name = String(data.get("name") ?? "").trim(); if (!song || !name) return; const subject = encodeURIComponent(`Music recommendation from ${name}`); const body = encodeURIComponent(`${name} recommended this song:\n\n${song}\n${selectedSongUrl}`); window.location.href = `mailto:enkhamgalan.entwan@outlook.com?subject=${subject}&body=${body}`; if (status) status.textContent = "Opening your email app..."; });
  document.addEventListener("keydown", (event) => { if (event.key === "Escape" && overlay?.classList.contains("is-open")) close(); });
  loadData();
</script>

<style>
  .music-button { display:flex; align-items:center; justify-content:center; width:32px; height:32px; flex-shrink:0; border:0; padding:0; background:transparent; color:inherit; font:inherit; cursor:pointer; transition:opacity .2s ease; }
  .music-button:hover { opacity:.55; }
  .music-button:focus-visible { outline:2px solid currentColor; outline-offset:4px; }
  .music-button span { font-family:Georgia,serif; font-size:1.75rem; line-height:1; }
  .music-overlay { position:fixed; inset:0; z-index:1000; display:flex; align-items:center; justify-content:center; padding:30px; background:rgba(64,54,64,.56); opacity:0; visibility:hidden; pointer-events:none; transition:opacity .35s ease,visibility .35s ease; }
  .music-overlay.is-open { opacity:1; visibility:visible; pointer-events:auto; }
  .music-card { position:relative; display:grid; grid-template-columns:20% 80%; width:min(1000px,94vw); height:min(760px,calc(100vh - 60px)); min-height:0; overflow:hidden; border-radius:22px; background:#f7f6f4; box-shadow:0 24px 80px rgba(28,20,29,.28); transform:translateY(-90px); transition:transform .65s cubic-bezier(.22,1,.36,1); }
  .music-overlay.is-open .music-card { transform:translateY(0); }
  .music-card-note { display:flex; align-items:center; justify-content:center; background:radial-gradient(circle at 30% 25%,#e5d5d2,transparent 40%),linear-gradient(145deg,#d6c3c7,#93788f); color:#403640; font-family:Georgia,serif; font-size:clamp(8rem,18vw,14rem); }
  .music-card-content { min-width:0; min-height:0; overflow-y:auto; overscroll-behavior:contain; scrollbar-color:#b4a4ac transparent; padding:48px 54px 54px; }
  .music-heading-row { display:flex; align-items:flex-start; justify-content:space-between; gap:20px; }
  .music-card-label,.music-section-title { color:#777; font:0.7rem "Courier Prime",monospace; letter-spacing:.08em; }
  .music-card-content h2 { margin:12px 0 22px; color:#111; font:400 clamp(2.8rem,5vw,4.8rem)/.92 "Instrument Serif",serif; letter-spacing:-.025em; }
  .spotify-connect { flex-shrink:0; padding:10px 13px; border:1px solid #4d7657; border-radius:999px; background:transparent; color:#4d7657; font:.68rem "Courier Prime",monospace; cursor:pointer; }
  .spotify-connect:hover { background:#4d7657; color:#fff; }
  .current-track { display:grid; grid-template-columns:76px minmax(0,1fr) auto; align-items:center; gap:16px; min-height:76px; margin:0 0 32px; padding:12px; border:1px solid rgba(17,17,17,.13); border-radius:12px; background:#fff; color:#111; text-decoration:none; box-shadow:4px 4px 0 rgba(64,54,64,.08); }
  .current-track img { width:76px; height:76px; object-fit:cover; border-radius:8px; }
  .current-track > span:not(.music-track-arrow) { display:flex; min-width:0; flex-direction:column; gap:4px; }
  .current-track strong { overflow:hidden; text-overflow:ellipsis; white-space:nowrap; font:400 1.9rem "Instrument Serif",serif; }
  .current-track small { overflow:hidden; text-overflow:ellipsis; white-space:nowrap; color:#777; font:.7rem "Courier Prime",monospace; }
  .now-playing-status { display:flex; align-items:center; gap:7px; margin-top:7px; color:#4d7657 !important; font-size:.6rem !important; letter-spacing:.04em; }
  .now-playing-status i { width:6px; height:6px; border-radius:50%; background:#aaa; }
  .now-playing-status i.is-playing { background:#4d7657; box-shadow:0 0 0 4px rgba(77,118,87,.12); }
  [data-now-playing-time] { margin-left:auto; }
  .current-track-placeholder,.music-muted { color:#777; font:.76rem "Courier Prime",monospace; }
  .music-track-arrow { color:#777; font:.9rem "Courier Prime",monospace; }
  .music-section-title { margin:0 0 10px; }
  .music-artists { display:grid; grid-template-columns:repeat(5,minmax(0,1fr)); gap:14px; margin-bottom:28px; }
  .artist-card { display:flex; min-width:0; flex-direction:column; gap:6px; color:#111; }
  .artist-card img { width:56px; height:56px; object-fit:cover; border-radius:50%; opacity:.88; }
  .artist-card a { overflow:hidden; color:#111; text-decoration:underline; text-decoration-color:rgba(17,17,17,.3); text-underline-offset:3px; }
  .artist-card a:hover { text-decoration-color:currentColor; }
  .artist-card span { overflow:hidden; text-overflow:ellipsis; white-space:nowrap; font:.7rem "Courier Prime",monospace; }
  .artist-card small { color:#777; font:.6rem "Courier Prime",monospace; }
  .music-taste,.recommendation-note { margin:0; color:#777; font:.75rem/1.5 "Courier Prime",monospace; }
  .top-tracks-heading { margin-top:26px; }
  .music-track-list { display:grid; gap:5px; margin:0 0 25px; padding:0; list-style:none; }
  .music-track { display:grid; grid-template-columns:24px 42px minmax(0,1fr) auto; align-items:center; gap:10px; padding:5px 7px 5px 0; border-bottom:1px solid rgba(17,17,17,.1); color:#111; text-decoration:none; }
  .music-track:hover { background:rgba(214,195,199,.25); }
  .music-track-number { color:#999; font:.65rem "Courier Prime",monospace; }
  .music-track img { width:42px; height:42px; object-fit:cover; border-radius:4px; }
  .music-track-copy { display:flex; min-width:0; flex-direction:column; gap:3px; }
  .music-track-copy strong,.music-track-copy small { overflow:hidden; text-overflow:ellipsis; white-space:nowrap; }
  .music-track-copy strong { font:700 .78rem "Courier Prime",monospace; }
  .music-track-copy small { color:#777; font:.65rem "Courier Prime",monospace; }
  .recommendation-heading { margin-top:8px; margin-bottom:8px; }
  .recommendation-note em { display:block; margin-top:3px; color:#403640; }
  .recommendation-form { display:grid; grid-template-columns:minmax(0,1fr) 130px; gap:8px; margin-top:14px; }
  .song-search-wrap { position:relative; grid-column:1 / -1; }
  .recommendation-form input,.recommendation-form button { min-width:0; min-height:38px; border:1px solid rgba(17,17,17,.18); border-radius:4px; font:.7rem "Courier Prime",monospace; }
  .recommendation-form input { width:100%; padding:0 10px; background:rgba(255,255,255,.55); color:#111; }
  .recommendation-form input:focus { outline:2px solid #4d7657; outline-offset:2px; }
  .recommendation-form button { padding:0 10px; background:#4d7657; color:#fff; cursor:pointer; }
  .recommendation-form button:hover { opacity:.78; }
  .recommendation-status { align-self:center; margin:0; color:#4d7657; font:.66rem "Courier Prime",monospace; }
  .song-search-results { position:absolute; top:calc(100% + 4px); right:0; left:0; z-index:4; overflow:hidden; border-radius:5px; background:#fff; box-shadow:0 12px 30px rgba(28,20,29,.16); }
  .search-result { display:grid; grid-template-columns:38px minmax(0,1fr); align-items:center; gap:10px; width:100%; padding:6px 8px; border:0; background:#fff; color:#111; text-align:left; cursor:pointer; }
  .search-result:hover { background:#edecea; }
  .search-result img { width:38px; height:38px; object-fit:cover; border-radius:3px; }
  .search-result span { display:flex; min-width:0; flex-direction:column; gap:2px; }
  .search-result strong,.search-result small { overflow:hidden; text-overflow:ellipsis; white-space:nowrap; }
  .search-result strong { font:700 .72rem "Courier Prime",monospace; }
  .search-result small { color:#777; font:.65rem "Courier Prime",monospace; }
  .sr-only { position:absolute; width:1px; height:1px; padding:0; margin:-1px; overflow:hidden; clip:rect(0,0,0,0); white-space:nowrap; border:0; }
  .music-card-close { position:absolute; top:16px; right:16px; z-index:2; display:flex; align-items:center; justify-content:center; width:44px; height:44px; border:0; border-radius:50%; background:rgba(247,246,244,.72); color:#111; font-size:1.8rem; cursor:pointer; }
  .music-card-close:hover { background:#edecea; transform:rotate(5deg); }
  @media (max-width:640px) {
    .music-button { width:28px; height:28px; }
    .music-button span { font-size:1.5rem; }
    .music-overlay { padding:18px; }
    .music-card { display:flex; flex-direction:column; width:100%; height:calc(100vh - 36px); max-height:none; overflow:hidden; }
    .music-card-note { min-height:150px; font-size:8rem; }
    .music-card-content { flex:1; padding:34px 28px 40px; }
    .music-heading-row { display:block; }
    .spotify-connect { margin-bottom:18px; }
    .music-artists { grid-template-columns:repeat(3,minmax(0,1fr)); }
  }
</style>
