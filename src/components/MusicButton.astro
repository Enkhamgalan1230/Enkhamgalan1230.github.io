<div class="music-control">
  <button class="music-button" type="button" aria-label="Show what Entwan is listening to" aria-expanded="false" aria-controls="now-playing-dropdown" title="What I am listening to">
    <span aria-hidden="true">&#9834;</span>
  </button>

  <div class="now-playing-dropdown" id="now-playing-dropdown" aria-hidden="true">
    <div class="now-playing-card" role="status" aria-live="polite">
      <div class="now-playing-card-topline">
        <span data-now-playing-label>RIGHT NOW I'M LISTENING TO ..</span>
        <span class="now-playing-wave" data-now-playing-wave aria-hidden="true">
          <i></i><i></i><i></i><i></i>
        </span>
      </div>

      <a class="now-playing-content" data-now-playing-link href="#" target="_blank" rel="noreferrer">
        <img data-now-playing-image alt="" hidden />
        <span class="now-playing-copy">
          <strong data-now-playing-title>Loading...</strong>
          <small data-now-playing-artist></small>
          <small data-now-playing-time></small>
        </span>
      </a>
    </div>
  </div>
</div>

<script>
  const SPOTIFY_API_URL = "https://enkhamgalan-spotify-api.zaecisama.workers.dev/api/spotify";
  const musicControl = document.querySelector<HTMLElement>(".music-control");
  const siteHeader = document.querySelector<HTMLElement>(".site-header");
  const musicButton = document.querySelector<HTMLButtonElement>(".music-button");
  const dropdown = document.querySelector<HTMLElement>(".now-playing-dropdown");
  const card = document.querySelector<HTMLElement>(".now-playing-card");
  const label = document.querySelector<HTMLElement>("[data-now-playing-label]");
  const wave = document.querySelector<HTMLElement>("[data-now-playing-wave]");
  const link = document.querySelector<HTMLAnchorElement>("[data-now-playing-link]");
  const image = document.querySelector<HTMLImageElement>("[data-now-playing-image]");
  const title = document.querySelector<HTMLElement>("[data-now-playing-title]");
  const artist = document.querySelector<HTMLElement>("[data-now-playing-artist]");
  const time = document.querySelector<HTMLElement>("[data-now-playing-time]");

  let refreshTimer: number | undefined;
  let closeTimer: number | undefined;
  let progressTimer: number | undefined;
  let displayedProgress = 0;
  let displayedDuration = 0;

  async function loadSpotifyData() {
    try {
      const response = await fetch(`${SPOTIFY_API_URL}?type=all&ts=${Date.now()}`, {
        cache: "no-store",
      });
      if (!response.ok) throw new Error("Spotify unavailable");

      const data = await response.json();
      const track = data.current?.isPlaying ? data.current : data.recent ?? data.current;
      const isPlaying = Boolean(data.current?.isPlaying && track === data.current);

      if (!track) {
        stopProgressTimer();
        if (label) label.textContent = "NOT PLAYING";
        if (wave) wave.classList.remove("is-playing");
        if (title) title.textContent = "Nothing played recently";
        if (artist) artist.textContent = "Start a song on Spotify";
        if (time) time.textContent = "";
        if (image) {
          image.hidden = true;
          image.removeAttribute("src");
        }
        if (link) link.href = "#";
        return;
      }

      if (label) label.textContent = isPlaying ? "RIGHT NOW I'M LISTENING TO .." : "LAST LISTENED";
      if (wave) wave.classList.toggle("is-playing", isPlaying);
      if (title) title.textContent = track.name;
      if (artist) artist.textContent = `${track.artists} · ${track.album}`;
      displayedProgress = track.progress ?? 0;
      displayedDuration = track.duration ?? 0;
      updateProgressText();
      startProgressTimer(isPlaying);
      if (image) {
        image.hidden = !track.image;
        image.src = track.image;
        image.alt = `${track.name} album art`;
      }
      if (link) link.href = track.url || "#";
    } catch (error) {
      if (label) label.textContent = "SPOTIFY UNAVAILABLE";
      stopProgressTimer();
      if (wave) wave.classList.remove("is-playing");
      if (title) title.textContent = "Unable to load listening activity";
      if (artist) artist.textContent = "Please try again later";
      if (time) time.textContent = "";
      if (image) image.hidden = true;
      if (link) link.href = "#";
      console.error("Could not load Spotify data", error);
    }
  }

  function formatTime(milliseconds: number) {
    const seconds = Math.max(0, Math.floor(milliseconds / 1000));
    return `${Math.floor(seconds / 60)}:${String(seconds % 60).padStart(2, "0")}`;
  }

  function updateProgressText() {
    if (!time) return;
    time.textContent = displayedDuration
      ? `${formatTime(displayedProgress)} / ${formatTime(displayedDuration)}`
      : "";
  }

  function stopProgressTimer() {
    if (progressTimer) window.clearInterval(progressTimer);
    progressTimer = undefined;
  }

  function startProgressTimer(isPlaying: boolean) {
    stopProgressTimer();
    if (!isPlaying || !displayedDuration) return;

    progressTimer = window.setInterval(() => {
      displayedProgress = Math.min(displayedProgress + 1000, displayedDuration);
      updateProgressText();
    }, 1000);
  }

  function openDropdown() {
    if (!dropdown || !musicButton) return;
    dropdown.classList.add("is-open");
    dropdown.setAttribute("aria-hidden", "false");
    musicButton.setAttribute("aria-expanded", "true");
    siteHeader?.classList.add("music-open");
    positionPointer();
    loadSpotifyData();
    if (refreshTimer) window.clearInterval(refreshTimer);
    if (closeTimer) window.clearTimeout(closeTimer);
    refreshTimer = window.setInterval(loadSpotifyData, 30000);
    closeTimer = window.setTimeout(closeDropdown, 5000);
  }

  function closeDropdown() {
    if (!dropdown || !musicButton) return;
    dropdown.classList.remove("is-open");
    dropdown.setAttribute("aria-hidden", "true");
    musicButton.setAttribute("aria-expanded", "false");
    siteHeader?.classList.remove("music-open");
    if (refreshTimer) window.clearInterval(refreshTimer);
    refreshTimer = undefined;
    stopProgressTimer();
    if (closeTimer) window.clearTimeout(closeTimer);
    closeTimer = undefined;
  }

  function positionPointer() {
    if (!dropdown || !musicButton || !card || window.innerWidth > 640) return;

    const buttonRect = musicButton.getBoundingClientRect();
    const dropdownRect = dropdown.getBoundingClientRect();
    const pointerLeft = buttonRect.left + buttonRect.width / 2 - dropdownRect.left - 5.5;
    card.style.setProperty("--pointer-left", `${pointerLeft}px`);
  }

  musicButton?.addEventListener("click", () => {
    if (dropdown?.classList.contains("is-open")) closeDropdown();
    else openDropdown();
  });

  document.addEventListener("click", (event) => {
    if (dropdown?.classList.contains("is-open") && musicControl && !musicControl.contains(event.target as Node)) {
      closeDropdown();
    }
  });

  document.addEventListener("keydown", (event) => {
    if (event.key === "Escape" && dropdown?.classList.contains("is-open")) {
      closeDropdown();
      musicButton?.focus();
    }
  });

  window.addEventListener("resize", positionPointer);
</script>

<style>
  .music-control { position: relative; flex-shrink: 0; }

  .music-button {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 32px;
    height: 32px;
    padding: 0;
    border: 0;
    background: transparent;
    color: inherit;
    font: inherit;
    cursor: pointer;
    transition: opacity 0.2s ease, transform 0.2s ease;
  }

  .music-button:hover { opacity: 0.65; transform: scale(1.08); }
  .music-button:focus-visible { outline: 2px solid currentColor; outline-offset: 4px; }
  .music-button span { font-family: Georgia, serif; font-size: 1.75rem; line-height: 1; }

  .now-playing-dropdown {
    position: absolute;
    top: calc(100% + 14px);
    right: 0;
    z-index: 1001;
    width: min(320px, calc(100vw - 32px));
    opacity: 0;
    visibility: hidden;
    pointer-events: none;
    transform: translateY(-8px) scale(0.98);
    transform-origin: top right;
    transition: opacity 0.2s ease, visibility 0.2s ease, transform 0.2s ease;
  }

  .now-playing-dropdown.is-open {
    opacity: 1;
    visibility: visible;
    pointer-events: auto;
    transform: translateY(0) scale(1);
  }

  .now-playing-card {
    position: relative;
    padding: 16px;
    border: 1px solid rgba(17, 17, 17, 0.14);
    border-radius: 16px;
    background: rgba(247, 246, 244, 0.96);
    box-shadow: 0 16px 38px rgba(17, 17, 17, 0.16);
    backdrop-filter: blur(14px);
  }

  .now-playing-card::before {
    position: absolute;
    top: -6px;
    left: var(--pointer-left, calc(100% - 23px));
    width: 11px;
    height: 11px;
    border-top: 1px solid rgba(17, 17, 17, 0.14);
    border-left: 1px solid rgba(17, 17, 17, 0.14);
    background: #f7f6f4;
    content: "";
    transform: rotate(45deg);
  }

  .now-playing-card-topline {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 11px;
    color: #777;
    font: 0.62rem "Courier Prime", monospace;
    letter-spacing: 0.08em;
  }

  .now-playing-wave {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 2px;
    width: 18px;
    height: 16px;
  }

  .now-playing-wave i {
    display: block;
    width: 3px;
    height: 5px;
    border-radius: 999px;
    background: #aaa;
  }

  .now-playing-wave i:nth-child(1) { height: 7px; }
  .now-playing-wave i:nth-child(2) { height: 12px; }
  .now-playing-wave i:nth-child(3) { height: 9px; }
  .now-playing-wave i:nth-child(4) { height: 6px; }

  .now-playing-wave.is-playing i {
    background: #4d7657;
    animation: now-playing-wave 0.9s ease-in-out infinite alternate;
  }

  .now-playing-wave.is-playing i:nth-child(2) { animation-delay: -0.45s; }
  .now-playing-wave.is-playing i:nth-child(3) { animation-delay: -0.25s; }
  .now-playing-wave.is-playing i:nth-child(4) { animation-delay: -0.6s; }

  @keyframes now-playing-wave {
    from { transform: scaleY(0.45); }
    to { transform: scaleY(1.15); }
  }

  .now-playing-content {
    display: grid;
    grid-template-columns: 58px minmax(0, 1fr);
    align-items: center;
    gap: 12px;
    color: #111;
  }

  .now-playing-content img { width: 58px; height: 58px; border-radius: 9px; object-fit: cover; }
  .now-playing-content img[hidden] { display: none; }
  .now-playing-copy { display: flex; min-width: 0; flex-direction: column; gap: 4px; }
  .now-playing-copy strong, .now-playing-copy small { overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
  .now-playing-copy strong { font: 400 1.25rem/1.05 "Instrument Serif", serif; }
  .now-playing-copy small { color: #777; font: 0.66rem/1.3 "Courier Prime", monospace; }
  [data-now-playing-time] { color: #4d7657; }

  @media (max-width: 640px) {
    .music-button { width: 28px; height: 28px; }
    .music-button span { font-size: 1.5rem; }
    .now-playing-dropdown {
      position: absolute;
      top: 58px;
      right: 16px;
      left: 16px;
      width: auto;
      transform-origin: top center;
    }

    :global(.site-header.music-open) {
      padding-bottom: 142px;
    }

    :global(.site-header) .music-control {
      position: static;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .music-button, .now-playing-dropdown { transition: none; }
    .now-playing-wave.is-playing i { animation: none; }
  }
</style>
