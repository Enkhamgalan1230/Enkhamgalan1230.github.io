<button
  class="face-button"
  type="button"
  aria-label="Open navigation"
>
  <img
    class="face-image"
    src="/images/faces/straight-main.png"
    alt=""
  />
</button>

<script>
  const button =
    document.querySelector<HTMLButtonElement>(".face-button");

  const image =
    button?.querySelector<HTMLImageElement>(".face-image");

  const STRAIGHT = "/images/faces/straight-main.png";
  const LEFT_TRANSITION = "/images/faces/left-transition.png";
  const LEFT_MAIN = "/images/faces/left-main.png";
  const RIGHT_TRANSITION = "/images/faces/right-transition.png";
  const RIGHT_MAIN = "/images/faces/right-main.png";

  const frames = [
    { src: STRAIGHT, duration: 80 },
    { src: LEFT_TRANSITION, duration: 90 },
    { src: LEFT_MAIN, duration: 240 },
    { src: LEFT_TRANSITION, duration: 90 },
    { src: STRAIGHT, duration: 120 },
    { src: RIGHT_TRANSITION, duration: 90 },
    { src: RIGHT_MAIN, duration: 240 },
    { src: RIGHT_TRANSITION, duration: 90 },
    { src: STRAIGHT, duration: 0 },
  ];

  let isPlaying = false;

  // Preload frames
  [
    STRAIGHT,
    LEFT_TRANSITION,
    LEFT_MAIN,
    RIGHT_TRANSITION,
    RIGHT_MAIN,
  ].forEach((src) => {
    const preload = new Image();
    preload.src = src;
  });

  function wait(ms: number) {
    return new Promise<void>((resolve) => {
      setTimeout(resolve, ms);
    });
  }

  async function playFaceSequence() {
    if (!image || isPlaying) return;

    isPlaying = true;

    try {
      for (const frame of frames) {
        image.src = frame.src;

        if (frame.duration > 0) {
          await wait(frame.duration);
        }
      }
    } finally {
      // ALWAYS return to straight
      image.src = STRAIGHT;

      // ALWAYS allow the next tap
      isPlaying = false;
    }
  }

  if (button) {
    // Every click/tap plays it
    button.addEventListener("click", () => {
      playFaceSequence();
    });

    // Hover animation only for devices with a real mouse/trackpad
    const canHover = window.matchMedia("(hover: hover)").matches;

    if (canHover) {
      button.addEventListener("mouseenter", () => {
        playFaceSequence();
      });
    }
  }
</script>

<style>
  .face-button {
    width: 84px;
    height: 84px;

    padding: 0;

    display: flex;
    align-items: center;
    justify-content: center;

    border: 0;
    background: transparent;

    cursor: pointer;
  }

  .face-image {
    width: 100%;
    height: 100%;

    object-fit: contain;

    pointer-events: none;
    user-select: none;
  }

  .face-button:focus-visible {
    outline: 2px solid #111111;
    outline-offset: 4px;
    border-radius: 4px;
  }

  @media (max-width: 640px) {
    .face-button {
      width: 68px;
      height: 68px;
    }
  }
</style>