<footer class="site-footer">
  <div class="footer-pet-lane">
    <button
      class="footer-pet"
      id="footer-pet-placeholder"
      data-pet-id="placeholder"
      type="button"
      aria-label="Meet Luśka, Weronika's pet"
    >
      <span class="footer-pet-message" aria-hidden="true"></span>
      <span class="footer-pet-name">Luśka</span>
      <span class="footer-pet-sprite"></span>
    </button>
  </div>

  <div class="footer-inner">
    <div class="footer-left">
      <span>Entwan ©</span>
    </div>

    <div class="footer-center">
      <div class="footer-analytics-wrap">
        <button
          class="footer-analytics"
          type="button"
          aria-label="Show visitor leaderboard"
          aria-expanded="false"
          aria-controls="footer-country-leaderboard"
        >
          <span class="footer-analytics-stat">
            <small>visitors</small>
            <strong data-analytics-total>—</strong>
          </span>
          <span class="footer-analytics-stat">
            <small>last seen</small>
            <strong data-analytics-last>—</strong>
          </span>
          <span class="footer-analytics-stat footer-analytics-live">
            <small><i aria-hidden="true"></i> live now</small>
            <strong data-analytics-live>—</strong>
          </span>
        </button>
        <div class="footer-country-leaderboard" id="footer-country-leaderboard" hidden>
          <table>
            <caption>visitor leaderboard</caption>
            <colgroup>
              <col class="footer-country-rank-column" />
              <col />
              <col class="footer-country-visits-column" />
            </colgroup>
            <thead>
              <tr>
                <th scope="col">rank</th>
                <th scope="col">country</th>
                <th scope="col">visits</th>
              </tr>
            </thead>
            <tbody data-analytics-countries></tbody>
          </table>
        </div>
      </div>
    </div>

    <div class="footer-right">
      <span>2026</span>
    </div>
  </div>
</footer>

<style>
  .site-footer {
    position: relative;
    width: 100%;
    overflow: visible;

    padding: 28px 36px;

    border-top: 1px solid rgba(17, 17, 17, 0.14);

    background: #edecea;
  }

  .footer-pet-lane {
    display: none;
    position: absolute;
    top: 0;
    right: 0;
    left: 0;
    z-index: 2;
    width: 100%;
    height: 0;
    pointer-events: none;
  }

  .footer-pet {
    appearance: none;
    position: absolute;
    top: -52px;
    bottom: auto;
    left: 0;
    width: 64px;
    height: 52px;
    margin: 0;
    padding: 0;
    border: 0;
    background: transparent;
    cursor: pointer;
    pointer-events: auto;
    transform-origin: center;
    will-change: left, transform;
  }

  .footer-pet:focus-visible {
    outline: 2px solid #4d7657;
    outline-offset: 3px;
  }

  .footer-pet-message {
    position: absolute;
    bottom: calc(100% + 31px);
    left: 50%;
    z-index: 2;
    width: max-content;
    max-width: min(230px, calc(100vw - 16px));
    padding: 4px 6px;
    background: rgba(128, 128, 128, 0.58);
    color: #111;
    font: 700 0.65rem/1.25 "Courier Prime", monospace;
    overflow-wrap: anywhere;
    opacity: 0;
    pointer-events: none;
    transform: translate(-50%, 4px);
    transition: opacity 0.18s ease, transform 0.18s ease;
  }

  .footer-pet.is-speaking .footer-pet-message {
    opacity: 1;
    transform: translate(-50%, 0);
  }

  .footer-pet-name {
    position: absolute;
    bottom: calc(100% + 1px);
    left: 50%;
    z-index: 1;
    padding: 4px 6px;
    border: 1px solid rgba(17, 17, 17, 0.2);
    background: rgba(128, 128, 128, 0.58);
    color: #111;
    font: 700 0.7rem/1 "Courier Prime", monospace;
    letter-spacing: 0.02em;
    white-space: nowrap;
    transform: translateX(-50%);
  }

  .footer-pet-sprite {
    display: block;
    width: 100%;
    height: 100%;
    background-image: var(--footer-pet-sprite, url("/images/pets/idle.png"));
    background-repeat: no-repeat;
    background-size: var(--footer-pet-sheet-size, 1200% 100%);
    image-rendering: pixelated;
    transform-origin: center;
  }

  .footer-inner {
    display: grid;
    grid-template-columns: 1fr auto 1fr;

    align-items: center;

    gap: 24px;
  }

  .footer-left,
  .footer-right {
    display: flex;
    align-items: center;

    gap: 18px;

    font-family: "Courier Prime", monospace;
    font-size: 0.72rem;

    color: #666666;
  }

  .footer-right {
    justify-self: end;
  }

  .footer-center {
    justify-self: center;
  }

  .footer-analytics {
    appearance: none;
    display: flex;
    align-items: stretch;
    gap: 18px;
    margin: 0;
    padding: 0;
    border: 0;
    background: transparent;
    color: inherit;
    cursor: pointer;
    font: inherit;
    text-align: left;
  }

  .footer-analytics-wrap {
    position: relative;
  }

  .footer-analytics:hover strong,
  .footer-analytics:focus-visible strong {
    color: #355d40;
  }

  .footer-analytics:focus-visible {
    outline: 2px solid #4d7657;
    outline-offset: 6px;
  }

  .footer-country-leaderboard {
    position: absolute;
    right: 0;
    bottom: calc(100% + 14px);
    z-index: 5;
    width: min(292px, calc(100vw - 36px));
    padding: 14px 15px;
    border: 1px solid rgba(17, 17, 17, 0.16);
    border-radius: 4px;
    background: rgba(248, 247, 244, 0.98);
    box-shadow: 5px 5px 0 rgba(17, 17, 17, 0.08);
    color: #555;
  }

  .footer-country-leaderboard table {
    width: 100%;
    border-collapse: collapse;
    table-layout: fixed;
    font: 0.68rem/1.15 "Courier Prime", monospace;
  }

  .footer-country-rank-column {
    width: 38px;
  }

  .footer-country-visits-column {
    width: 72px;
  }

  .footer-country-leaderboard caption {
    padding-bottom: 9px;
    border-bottom: 1px solid rgba(17, 17, 17, 0.13);
    color: #8b8b87;
    font: 0.56rem/1 "Courier Prime", monospace;
    letter-spacing: 0.08em;
    text-align: left;
    text-transform: uppercase;
  }

  .footer-country-leaderboard th {
    padding: 9px 4px 6px;
    color: #8b8b87;
    font-size: 0.52rem;
    font-weight: 400;
    letter-spacing: 0.06em;
    text-align: left;
    text-transform: uppercase;
  }

  .footer-country-leaderboard th,
  .footer-country-leaderboard td {
    box-sizing: border-box;
  }

  .footer-country-leaderboard th:first-child,
  .footer-country-leaderboard td:first-child {
    text-align: center;
  }

  .footer-country-leaderboard th:last-child,
  .footer-country-leaderboard td:last-child {
    text-align: right;
  }

  .footer-country-leaderboard td {
    padding: 7px 4px;
    border-top: 1px solid rgba(17, 17, 17, 0.08);
    color: #4d7657;
    white-space: nowrap;
  }

  .footer-country-leaderboard .footer-country-count {
    text-align: right;
  }

  .footer-country-leaderboard .footer-country-rank-cell {
    text-align: center;
  }

  .footer-country-leaderboard td:last-child {
    color: #77736b;
  }

  .footer-country-rank {
    color: #8b8b87;
  }

  .footer-country-medal {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 18px;
    height: 18px;
    border-radius: 50%;
    color: #514b3f;
    font-size: 0.58rem;
    line-height: 1;
  }

  .footer-country-medal.rank-1 {
    background: #e6c86e;
  }

  .footer-country-medal.rank-2 {
    background: #c9cdd0;
  }

  .footer-country-medal.rank-3 {
    background: #d7a176;
  }

  .footer-analytics-stat {
    display: flex;
    flex-direction: column;
    gap: 3px;
    min-width: 72px;
  }

  .footer-analytics-stat + .footer-analytics-stat {
    padding-left: 18px;
    border-left: 1px solid rgba(17, 17, 17, 0.14);
  }

  .footer-analytics-stat small {
    color: #8b8b87;
    font: 0.58rem/1 "Courier Prime", monospace;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .footer-analytics-stat strong {
    max-width: 190px;
    overflow: hidden;
    color: #4d7657;
    font: 400 0.78rem/1.1 "Courier Prime", monospace;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .footer-analytics-live small {
    display: inline-flex;
    align-items: center;
    gap: 5px;
  }

  .footer-analytics-live i {
    display: inline-block;
    width: 5px;
    height: 5px;
    border-radius: 50%;
    background: #6d9a72;
    box-shadow: 0 0 0 3px rgba(109, 154, 114, 0.14);
  }

  @media (max-width: 640px) {
    .site-footer {
      padding: 22px 18px;
    }

    .footer-pet {
      width: 56px;
      height: 46px;
      top: -46px;
    }

    .footer-inner {
      display: grid;
      grid-template-columns: 1fr;

      align-items: center;

      gap: 12px;
    }

    .footer-left,
    .footer-right {
      display: none !important;
    }

    .footer-left {
      display: flex;
      flex-direction: column;
      align-items: flex-start;

      gap: 4px;

      justify-self: start;

      font-size: 0.64rem;
    }

    .footer-right {
      display: flex;
      flex-direction: column;
      align-items: flex-end;

      gap: 4px;

      justify-self: end;

      font-size: 0.64rem;

      text-align: right;
    }

    .footer-center {
      grid-column: 1;
      justify-self: center;
    }

    .footer-analytics {
      gap: 9px;
    }

    .footer-country-leaderboard {
      right: -18px;
      width: min(250px, calc(100vw - 36px));
    }

    .footer-analytics-stat {
      min-width: 0;
    }

    .footer-analytics-stat + .footer-analytics-stat {
      padding-left: 9px;
    }

    .footer-analytics-stat small {
      font-size: 0.5rem;
    }

    .footer-analytics-stat strong {
      max-width: 110px;
      font-size: 0.62rem;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .footer-pet { left: 50%; transform: translateX(-50%); }
    .footer-pet-sprite {
      background-position: 0 0;
      background-size: 1200% 100%;
    }
    .footer-pet-message { transition: none; }
  }
</style>

<script>
  const siteAnalyticsApi =
    "https://enkhamgalan-spotify-api.zaecisama.workers.dev/api/site-analytics";
  const analyticsTotal = document.querySelector<HTMLElement>("[data-analytics-total]");
  const analyticsLast = document.querySelector<HTMLElement>("[data-analytics-last]");
  const analyticsLive = document.querySelector<HTMLElement>("[data-analytics-live]");
  const analyticsToggle = document.querySelector<HTMLButtonElement>(".footer-analytics");
  const analyticsLeaderboard = document.querySelector<HTMLElement>(".footer-country-leaderboard");
  const analyticsCountries = document.querySelector<HTMLTableSectionElement>("[data-analytics-countries]");
  let analyticsLeaderboardTimer: number | undefined;

  type SiteAnalytics = {
    totalVisits: number;
    lastVisit: { country: string; at: string } | null;
    live: Array<{ country: string; count: number }>;
    countries: Array<{ country: string; count: number }>;
  };

  function getAnalyticsVisitorId() {
    const storageKey = "entwan-site-visitor-id";
    const existing = window.localStorage.getItem(storageKey);
    if (existing && /^[a-z0-9-]{16,80}$/i.test(existing)) return existing;

    const visitorId = crypto.randomUUID();
    window.localStorage.setItem(storageKey, visitorId);
    return visitorId;
  }

  function countryLabel(country: string, compact = false) {
    if (compact) return country === "XX" ? "—" : country;
    if (country === "XX") return "Unknown country";
    try {
      return new Intl.DisplayNames(["en"], { type: "region" }).of(country) ?? country;
    } catch {
      return country;
    }
  }

  function updateAnalyticsDisplay(data: SiteAnalytics) {
    const compactCountryLabels = window.matchMedia("(max-width: 640px)").matches;

    if (analyticsTotal) {
      analyticsTotal.textContent = data.totalVisits.toLocaleString();
    }

    if (analyticsLast) {
      analyticsLast.textContent = data.lastVisit
        ? countryLabel(data.lastVisit.country, compactCountryLabels)
        : "—";
    }

    if (analyticsLive) {
      const liveCount = data.live.reduce((total, item) => total + item.count, 0);
      const liveCountries = data.live
        .map((item) => countryLabel(item.country, compactCountryLabels))
        .join(", ");
      analyticsLive.textContent = liveCount > 0
        ? `${liveCount} · ${liveCountries}`
        : "0";
    }

    if (analyticsCountries) {
      analyticsCountries.replaceChildren(
        ...data.countries.map((item, index) => {
          const row = document.createElement("tr");
          const rank = document.createElement("span");
          const country = document.createElement("td");
          const count = document.createElement("td");
          const rankCell = document.createElement("td");
          rankCell.className = "footer-country-rank-cell";
          country.className = "footer-country-name";
          count.className = "footer-country-count";
          rank.className = index < 3 ? `footer-country-medal rank-${index + 1}` : "footer-country-rank";
          rank.textContent = `${index + 1}`;
          rankCell.append(rank);
          country.textContent = countryLabel(item.country, compactCountryLabels);
          count.textContent = `${item.count}`;
          row.append(rankCell, country, count);
          return row;
        }),
      );
    }
  }

  analyticsToggle?.addEventListener("click", () => {
    if (!analyticsLeaderboard) return;
    const isOpen = !analyticsLeaderboard.hidden;
    analyticsLeaderboard.hidden = isOpen;
    analyticsToggle.setAttribute("aria-expanded", String(!isOpen));

    if (analyticsLeaderboardTimer) window.clearTimeout(analyticsLeaderboardTimer);
    if (!isOpen) {
      analyticsLeaderboardTimer = window.setTimeout(() => {
        analyticsLeaderboard.hidden = true;
        analyticsToggle.setAttribute("aria-expanded", "false");
      }, 6000);
    }
  });

  document.addEventListener("click", (event) => {
    if (
      analyticsLeaderboard &&
      analyticsToggle &&
      !analyticsLeaderboard.hidden &&
      !analyticsToggle.contains(event.target as Node) &&
      !analyticsLeaderboard.contains(event.target as Node)
    ) {
      analyticsLeaderboard.hidden = true;
      analyticsToggle.setAttribute("aria-expanded", "false");
      if (analyticsLeaderboardTimer) window.clearTimeout(analyticsLeaderboardTimer);
    }
  });

  async function updateSiteAnalytics() {
    try {
      const response = await fetch(siteAnalyticsApi, {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify({ visitorId: getAnalyticsVisitorId() }),
        keepalive: true,
      });
      if (!response.ok) return;
      updateAnalyticsDisplay(await response.json() as SiteAnalytics);
    } catch {
      // The footer keeps its static labels when analytics is unavailable.
    }
  }

  void updateSiteAnalytics();
  window.setInterval(() => void updateSiteAnalytics(), 30_000);

  const footerPetLane = document.querySelector<HTMLElement>(".footer-pet-lane");
  const footerPet = document.querySelector<HTMLButtonElement>(".footer-pet");
  const footerPetName = document.querySelector<HTMLElement>(".footer-pet-name");
  const footerPetMessage = document.querySelector<HTMLElement>(".footer-pet-message");
  const footerPetSprite = document.querySelector<HTMLElement>(".footer-pet-sprite");
  const footerPetReducedMotion = window.matchMedia("(prefers-reduced-motion: reduce)");

  type FooterPetConfig = {
    name: string;
    owner: string;
    idleSprite: string;
    idleFrames: number;
    walkingSprite: string;
    walkingFrames: number;
  };

  const footerPetConfigs: Record<string, FooterPetConfig> = {
    placeholder: {
      name: footerPetName?.textContent?.trim() || "PLACEHOLDER",
      owner: "Weronika",
      idleSprite: "/images/pets/idle.png",
      idleFrames: 12,
      walkingSprite: "/images/pets/walking.png",
      walkingFrames: 8,
    },
  };

  const footerPetConfig = footerPet
    ? footerPetConfigs[footerPet.dataset.petId ?? ""]
    : undefined;

  if (footerPet && footerPetConfig) {
    if (footerPetMessage) {
      footerPetMessage.textContent =
        `${footerPetConfig.owner}'s pet.`;
    }
    footerPet.style.setProperty(
      "--footer-pet-sprite",
      `url("${footerPetConfig.idleSprite}")`,
    );
    footerPet.style.setProperty(
      "--footer-pet-sheet-size",
      `${footerPetConfig.idleFrames * 100}% 100%`,
    );
  }

  let footerPetMessageTimer: number | undefined;

  function getFooterPetRange() {
    if (!footerPetLane || !footerPet) return { min: 0, max: 0 };

    const laneBounds = footerPetLane.getBoundingClientRect();
    const petWidth = footerPet.offsetWidth;
    const messageWidth = footerPetMessage?.offsetWidth ?? 0;
    const messageHalfWidth = messageWidth / 2;
    const edgeGap = 8;
    const minimum = Math.max(0, edgeGap + messageHalfWidth - petWidth / 2);
    const laneMaximum = footerPetLane.clientWidth - petWidth;
    const kumoLauncher = document.querySelector<HTMLElement>("#kumo-launcher");
    let maximum = laneMaximum;

    if (kumoLauncher) {
      const kumoBounds = kumoLauncher.getBoundingClientRect();
      const safeGap = 16;
      maximum = Math.min(
        maximum,
        kumoBounds.left - laneBounds.left - safeGap - messageHalfWidth - petWidth / 2,
      );
    }

    return {
      min: minimum,
      max: Math.max(minimum, maximum),
    };
  }

  footerPet?.addEventListener("click", () => {
    if (!footerPetMessage) return;
    footerPet.classList.add("is-speaking");
    if (footerPetMessageTimer) window.clearTimeout(footerPetMessageTimer);
    footerPetMessageTimer = window.setTimeout(() => {
      footerPet.classList.remove("is-speaking");
    }, 3200);
  });

  if (footerPetLane && footerPet && footerPetSprite && footerPetConfig && !footerPetReducedMotion.matches) {
    const { idleFrames, idleSprite, walkingFrames, walkingSprite } = footerPetConfig;
    const footerPetFrameOffset = window.matchMedia("(max-width: 640px)").matches ? 4 : 7;
    footerPetSprite.style.setProperty("--footer-pet-y", `${footerPetFrameOffset}px`);

    const wait = (duration: number) =>
      new Promise<void>((resolve) => window.setTimeout(resolve, duration));

    function setFooterPetSheet(sprite: string, frameCount: number, frame: number) {
      footerPetSprite.style.backgroundImage = `url("${sprite}")`;
      footerPetSprite.style.backgroundSize = `${frameCount * 100}% 100%`;
      const position = frameCount > 1 ? (frame / (frameCount - 1)) * 100 : 0;
      footerPetSprite.style.backgroundPosition = `${position}% 0`;
    }

    async function playFrames(sprite: string, frameCount: number, frameDuration: number) {
      for (let frame = 0; frame < frameCount; frame += 1) {
        setFooterPetSheet(sprite, frameCount, frame);
        await wait(frameDuration);
      }
    }

    function randomBetween(min: number, max: number) {
      return Math.round(min + Math.random() * (max - min));
    }

    async function walkTo(target: number, direction: 1 | -1) {
      const start = footerPet.offsetLeft;
      const distance = Math.abs(target - start);
      const duration = Math.max(4200, Math.min(11000, distance * 65));

      footerPetSprite.style.transform =
        `scaleX(${direction}) translateY(var(--footer-pet-y, 0px))`;
      const movement = footerPet.animate(
        [
          { left: `${start}px` },
          { left: `${target}px` },
        ],
        { duration, easing: "linear", fill: "forwards" },
      );
      let frame = 0;
      setFooterPetSheet(walkingSprite, walkingFrames, frame);
      const walkingTimer = window.setInterval(() => {
        frame = (frame + 1) % walkingFrames;
        setFooterPetSheet(walkingSprite, walkingFrames, frame);
      }, 155);

      await movement.finished.catch(() => undefined);
      window.clearInterval(walkingTimer);
      movement.cancel();
      footerPet.style.left = `${target}px`;
      setFooterPetSheet(idleSprite, idleFrames, 0);
    }

    async function idleRandomly() {
      const facing: 1 | -1 = Math.random() < 0.5 ? 1 : -1;
      footerPetSprite.style.transform =
        `scaleX(${facing}) translateY(var(--footer-pet-y, 0px))`;
      await playFrames(idleSprite, idleFrames, 155);
      await wait(randomBetween(1800, 5200));
    }

    async function runFooterPet() {
      let direction: 1 | -1 = Math.random() < 0.5 ? 1 : -1;

      while (true) {
        const range = getFooterPetRange();
        const current = Math.min(range.max, Math.max(range.min, footerPet.offsetLeft));
        footerPet.style.left = `${current}px`;
        const availableDistance = range.max - range.min;

        if (availableDistance <= 1) {
          await idleRandomly();
          continue;
        }

        const atLeftEdge = current <= range.min + 1;
        const atRightEdge = current >= range.max - 1;
        if (atLeftEdge) {
          direction = 1;
        } else if (atRightEdge) {
          direction = -1;
        } else {
          direction = Math.random() < 0.5 ? 1 : -1;
        }

        const minimumDistance = Math.min(42, availableDistance);
        const maximumDistance = Math.min(190, availableDistance);
        const distance = randomBetween(minimumDistance, maximumDistance);
        const target = direction === 1
          ? Math.min(range.max, current + distance)
          : Math.max(range.min, current - distance);

        if (target === current) {
          await idleRandomly();
          continue;
        }

        await walkTo(target, direction);
        await idleRandomly();

        direction = Math.random() < 0.5 ? 1 : -1;
      }
    }

    setFooterPetSheet(idleSprite, idleFrames, 0);
    void runFooterPet();
  }
</script>
