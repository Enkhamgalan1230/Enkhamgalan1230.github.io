<section
  class="kumo-game"
  data-scroll-snap-section="kumo-game"
  data-scroll-fade-section
  data-scroll-reveal-section="kumo-game"
  data-scroll-reveal-group
  aria-label="A quiet rest area with Kumo"
>
  <div class="kumo-game__header">
    <p class="kumo-game__eyebrow">REST AREA</p>
    <h2 class="kumo-game__title">Meet My Portfolio<span> AI assistant.</span></h2>
    <p class="kumo-game__description">You can ask about me from KUMO, Play some tunes ♪ too!</p>
  </div>

  <div class="kumo-game__stage" aria-label="Vintage CCTV monitor showing the Kumo game">
    <canvas class="kumo-game__monitor" aria-hidden="true"></canvas>

    <audio class="kumo-game__audio" loop preload="none" muted>
      <source src="/game/kumo/audio/lofi.mp3" type="audio/mpeg" />
    </audio>

    <div class="kumo-game__scene">
      <div class="kumo-game__sound-controls">
        <button
          class="kumo-game__sound-button"
          type="button"
          aria-label="Turn Kumo music on"
          aria-pressed="false"
        >
          <img
            class="kumo-game__sound-icon"
            src="/game/kumo/ui/sound-off.png"
            alt=""
            aria-hidden="true"
          />
        </button>
      </div>

      <video
        class="kumo-game__video"
        data-desktop-src="/game/kumo/desktop/scene.mp4"
        data-mobile-src="/game/kumo/desktop/scene.mp4"
        autoplay
        muted
        loop
        playsinline
        preload="none"
        aria-hidden="true"
      >
      </video>

      <div class="kumo-game__shade" aria-hidden="true"></div>

      <button
        class="kumo-game__kumo-button"
        type="button"
        aria-label="Talk to Kumo"
      >
        <img
          class="kumo-game__kumo"
          src="/game/kumo/ui/folder/siamese_cat_clean_1.png"
          alt=""
          aria-hidden="true"
        />
      </button>

      <button
        class="kumo-game__prompt kumo-game__prompt--desktop"
        type="button"
        aria-label="Talk to Kumo"
      >
        <img src="/game/kumo/ui/press-to-interact.png" alt="Press E to interact" />
      </button>

      <button
        class="kumo-game__prompt kumo-game__prompt--mobile"
        type="button"
        aria-label="Talk to Kumo"
      >
        <img src="/game/kumo/ui/press-to-interact.png" alt="Tap to interact" />
      </button>

      <div class="kumo-game__undertale" aria-hidden="true" aria-live="polite">
        <video
          class="kumo-game__undertale-image"
          muted
          playsinline
          preload="auto"
          aria-label="Kumo dialogue"
        ></video>
      </div>

      <div class="kumo-game__choices" aria-label="Dialogue choices" aria-hidden="true">
        <button class="kumo-game__choice" type="button" data-kumo-choice="ask">
          ASK KUMO
        </button>
        <button class="kumo-game__choice" type="button" data-kumo-choice="explore">
          KEEP EXPLORING
        </button>
      </div>
    </div>
  </div>
</section>

<script>
  import * as THREE from "three";
  import { GLTFLoader } from "three/addons/loaders/GLTFLoader.js";

  const kumoGame = document.querySelector<HTMLElement>(".kumo-game");
  const kumoStage = kumoGame?.querySelector<HTMLElement>(".kumo-game__stage");
  const kumoMonitorCanvas = kumoGame?.querySelector<HTMLCanvasElement>(".kumo-game__monitor");
  const kumoGameScene = kumoGame?.querySelector<HTMLElement>(".kumo-game__scene");
  const kumoGameVideo = kumoGame?.querySelector<HTMLVideoElement>(".kumo-game__video");
  const kumoMobileViewport = window.matchMedia("(max-width: 640px)");
  const kumoAudio = kumoGame?.querySelector<HTMLAudioElement>(".kumo-game__audio");
  const kumoSoundButton = kumoGame?.querySelector<HTMLButtonElement>(".kumo-game__sound-button");
  const kumoSoundIcon = kumoGame?.querySelector<HTMLImageElement>(".kumo-game__sound-icon");
  const kumoSprite = kumoGame?.querySelector<HTMLImageElement>(".kumo-game__kumo");
  const kumoSpriteButton = kumoGame?.querySelector<HTMLButtonElement>(".kumo-game__kumo-button");
  const kumoPrompts = kumoGame?.querySelectorAll<HTMLButtonElement>(".kumo-game__prompt");
  const kumoUndertale = kumoGame?.querySelector<HTMLElement>(".kumo-game__undertale");
  const kumoUndertaleVideo = kumoGame?.querySelector<HTMLVideoElement>(".kumo-game__undertale-image");
  const kumoChoices = kumoGame?.querySelector<HTMLElement>(".kumo-game__choices");
  const kumoChoiceButtons = kumoGame?.querySelectorAll<HTMLButtonElement>(".kumo-game__choice");

  const kumoIdleFrames = [
    "/game/kumo/ui/folder/siamese_cat_clean_1.png",
    "/game/kumo/ui/folder/siamese_cat_clean_2.png",
    "/game/kumo/ui/folder/siamese_cat_clean_3.png",
    "/game/kumo/ui/folder/siamese_cat_clean_4.png",
    "/game/kumo/ui/folder/siamese_cat_clean_5.png",
    "/game/kumo/ui/folder/siamese_cat_clean_6.png",
  ];
  const kumoIdleDurations = [700, 350, 180, 350, 220, 700];
  const kumoUndertaleVideos = [
    "/game/kumo/undertale/1.webm",
    "/game/kumo/undertale/2.webm",
    "/game/kumo/undertale/3.webm",
    "/game/kumo/undertale/4.webm",
  ];

  type KumoGameState = "idle" | "dialogue" | "choice";
  let kumoGameState: KumoGameState = "idle";
  let kumoGameActive = false;
  let kumoFrameIndex = 0;
  let kumoFrameTimer: number | undefined;
  let kumoDialogueStarting = false;
  let kumoUndertaleAdvanceTimer: number | undefined;
  let kumoAudioFadeFrame: number | undefined;
  let kumoUndertaleIndex = 0;
  let kumoSoundEnabled = false;
  const kumoVolumeLevel = 0.3;
  if (kumoAudio) kumoAudio.volume = kumoVolumeLevel;
  const kumoReducedMotion = window.matchMedia("(prefers-reduced-motion: reduce)");
  const kumoMonitorIdleViewAngle = -0.52;
  const kumoMonitorIdleElevation = 0.18;
  let kumoMonitorModel: THREE.Group | undefined;
  let kumoMonitorCameraDistance = 0;
  let kumoMonitorMobileCameraDistance = 0;
  let kumoAnimateMonitorView: (straightOn: boolean) => Promise<void> = () => Promise.resolve();

  if (kumoStage && kumoMonitorCanvas) {
    const renderer = new THREE.WebGLRenderer({ canvas: kumoMonitorCanvas, alpha: true, antialias: true });
    renderer.setPixelRatio(Math.min(window.devicePixelRatio, 2));
    renderer.setClearColor(0x000000, 0);
    renderer.outputColorSpace = THREE.SRGBColorSpace;
    const scene = new THREE.Scene();
    scene.add(new THREE.HemisphereLight(0xffffff, 0x40352b, 2.1));
    const keyLight = new THREE.DirectionalLight(0xffe4bc, 2.4);
    keyLight.position.set(45, 55, 65);
    scene.add(keyLight);
    const camera = new THREE.PerspectiveCamera(34, 1, 0.1, 1000);
    camera.up.set(0, 0, 1);
    camera.position.set(100, 0, 17);
    camera.lookAt(0, 0, 0);
    const monitorRaycaster = new THREE.Raycaster();
    const monitorPointer = new THREE.Vector2();

    kumoMonitorCanvas.addEventListener("click", (event) => {
      if (!kumoMonitorModel) return;
      const rect = kumoMonitorCanvas.getBoundingClientRect();
      monitorPointer.set(
        ((event.clientX - rect.left) / rect.width) * 2 - 1,
        -((event.clientY - rect.top) / rect.height) * 2 + 1,
      );
      monitorRaycaster.setFromCamera(monitorPointer, camera);
      if (monitorRaycaster.intersectObject(kumoMonitorModel, true).length === 0) return;
      if (kumoGameState === "idle") startKumoDialogue();
      else if (kumoGameState === "dialogue") advanceKumoUndertale();
    });

    let screenMesh: THREE.Mesh | undefined;
    const screenVideoTexture = kumoGameVideo
      ? new THREE.VideoTexture(kumoGameVideo)
      : undefined;
    if (screenVideoTexture) {
      screenVideoTexture.colorSpace = THREE.SRGBColorSpace;
      // The GLB screen's UVs span [1, 2], so repeat the video once across it.
      screenVideoTexture.wrapS = THREE.RepeatWrapping;
      screenVideoTexture.wrapT = THREE.RepeatWrapping;
      screenVideoTexture.minFilter = THREE.LinearFilter;
      screenVideoTexture.magFilter = THREE.LinearFilter;
    }
    const loader = new GLTFLoader();
    loader.load("/assets/tv-cctv-monitor.glb", ({ scene: monitor }) => {
      kumoMonitorModel = monitor;
      // This model was authored a quarter-turn from landscape; rotate the
      // monitor face into landscape before centering and projecting its screen.
      monitor.rotation.x = Math.PI / 2;
      monitor.rotation.z = 0;
      const unscaledBounds = new THREE.Box3().setFromObject(monitor);
      const unscaledSize = unscaledBounds.getSize(new THREE.Vector3());
      const scale = 5.8 / Math.max(unscaledSize.x, unscaledSize.y, unscaledSize.z);
      monitor.scale.setScalar(scale);
      // Center after scaling so the model's large source coordinates do not
      // become an equally large translation in the camera's world space.
      const bounds = new THREE.Box3().setFromObject(monitor);
      const center = bounds.getCenter(new THREE.Vector3());
      monitor.position.sub(center);
      monitor.updateMatrixWorld(true);
      const size = bounds.getSize(new THREE.Vector3());
      monitor.traverse((object) => {
        if (!(object instanceof THREE.Mesh)) return;
        object.castShadow = true;
        object.receiveShadow = true;
        if (object.name.includes("Screen")) {
          screenMesh = object;
          if (screenVideoTexture) {
            object.material = new THREE.MeshBasicMaterial({
              map: screenVideoTexture,
              side: THREE.DoubleSide,
              toneMapped: false,
            });
          }
        }
      });
      scene.add(monitor);
      // Keep the established desktop framing and scale the mobile camera
      // distance with the portrait stage aspect ratio.
      kumoMonitorCameraDistance = Math.max(size.x, size.y, size.z) * 2.05;
      const mobileStageAspect = kumoStage.clientWidth / kumoStage.clientHeight;
      kumoMonitorMobileCameraDistance =
        Math.max(size.x, size.y, size.z) * (2.6 * 0.72 / mobileStageAspect);
      const mobile = kumoMobileViewport.matches;
      const idleAngle = kumoMonitorIdleViewAngle;
      const idleElevation = kumoMonitorIdleElevation;
      const idleDistance = mobile ? kumoMonitorMobileCameraDistance : kumoMonitorCameraDistance;
      const startStraightOn = kumoGameState !== "idle" || kumoDialogueStarting;
      camera.position.set(
        startStraightOn ? (mobile ? kumoMonitorMobileCameraDistance : kumoMonitorCameraDistance) : idleDistance * Math.cos(idleAngle),
        startStraightOn ? 0 : idleDistance * Math.sin(idleAngle),
        startStraightOn ? 0 : idleDistance * idleElevation,
      );
      camera.lookAt(0, 0, 0);
      updateMonitor();
      alignGameToScreen();
    }, undefined, (error) => console.error("Unable to load Kumo monitor model", error));

    function fitGameToScreen() {
      if (!screenMesh || !kumoStage || !kumoGameScene) return;
      screenMesh.updateWorldMatrix(true, false);
      const positions = screenMesh.geometry.getAttribute("position");
      const projected: THREE.Vector3[] = [];
      const point = new THREE.Vector3();
      for (let index = 0; index < positions.count; index += 1) {
        point.fromBufferAttribute(positions, index).applyMatrix4(screenMesh.matrixWorld).project(camera);
        projected.push(point.clone());
      }
      // ScrollTrigger scales the stage visually. Use its untransformed layout
      // size here because these values become CSS offsets inside that stage.
      const stageWidth = kumoStage.clientWidth;
      const stageHeight = kumoStage.clientHeight;
      const points = projected.map((point) => ({
        x: (point.x * 0.5 + 0.5) * stageWidth,
        y: (-point.y * 0.5 + 0.5) * stageHeight,
      }));
      const xs = points.map((point) => point.x);
      const ys = points.map((point) => point.y);
      const left = Math.min(...xs), right = Math.max(...xs), top = Math.min(...ys), bottom = Math.max(...ys);
      kumoGameScene.style.left = `${left}px`;
      kumoGameScene.style.top = `${top}px`;
      kumoGameScene.style.width = `${right - left}px`;
      kumoGameScene.style.height = `${bottom - top}px`;

      // Project the flat HTML controls onto the same four screen corners as
      // the 3D display so the F prompt and dialogue tilt with the monitor.
      const corners = [
        points.reduce((best, point) => point.x + point.y < best.x + best.y ? point : best),
        points.reduce((best, point) => point.x - point.y > best.x - best.y ? point : best),
        points.reduce((best, point) => point.x + point.y > best.x + best.y ? point : best),
        points.reduce((best, point) => point.x - point.y < best.x - best.y ? point : best),
      ].map((point) => ({ x: point.x - left, y: point.y - top }));
      const sourceCorners = [
        { x: 0, y: 0 },
        { x: right - left, y: 0 },
        { x: right - left, y: bottom - top },
        { x: 0, y: bottom - top },
      ];
      const equations: number[][] = [];
      sourceCorners.forEach((source, index) => {
        const target = corners[index];
        equations.push([
          source.x, source.y, 1, 0, 0, 0,
          -target.x * source.x, -target.x * source.y, target.x,
        ]);
        equations.push([
          0, 0, 0, source.x, source.y, 1,
          -target.y * source.x, -target.y * source.y, target.y,
        ]);
      });
      for (let column = 0; column < 8; column += 1) {
        let pivot = column;
        for (let row = column + 1; row < 8; row += 1) {
          if (Math.abs(equations[row][column]) > Math.abs(equations[pivot][column])) pivot = row;
        }
        [equations[column], equations[pivot]] = [equations[pivot], equations[column]];
        const divisor = equations[column][column];
        if (Math.abs(divisor) < 1e-8) return;
        for (let entry = column; entry <= 8; entry += 1) equations[column][entry] /= divisor;
        for (let row = 0; row < 8; row += 1) {
          if (row === column) continue;
          const factor = equations[row][column];
          for (let entry = column; entry <= 8; entry += 1) {
            equations[row][entry] -= factor * equations[column][entry];
          }
        }
      }
      const [a, b, c, d, e, f, g, h] = equations.map((row) => row[8]);
      kumoGameScene.style.transformOrigin = "0 0";
      kumoGameScene.style.transform = `matrix3d(${a},${d},0,${g},${b},${e},0,${h},0,0,1,0,${c},${f},0,1)`;
    }

    function updateMonitor() {
      const width = kumoStage!.clientWidth;
      const height = kumoStage!.clientHeight;
      if (!width || !height) return;
      renderer.setSize(width, height, false);
      camera.aspect = width / height;
      camera.updateProjectionMatrix();
      renderer.render(scene, camera);
      fitGameToScreen();
    }

    function alignGameToScreen() { requestAnimationFrame(updateMonitor); }
    const getMonitorCameraPosition = (straightOn: boolean) => {
      const mobile = kumoMobileViewport.matches;
      const idleAngle = mobile ? -0.12 : kumoMonitorIdleViewAngle;
      const idleElevation = mobile ? 0.08 : kumoMonitorIdleElevation;
      const distance = mobile ? kumoMonitorMobileCameraDistance : kumoMonitorCameraDistance;
      return new THREE.Vector3(
        straightOn ? distance : distance * Math.cos(idleAngle),
        straightOn ? 0 : distance * Math.sin(idleAngle),
        straightOn ? 0 : distance * idleElevation,
      );
    };
    kumoAnimateMonitorView = (straightOn) => new Promise((resolve) => {
      if (!kumoMonitorModel || kumoReducedMotion.matches) {
        if (kumoMonitorCameraDistance && kumoMonitorMobileCameraDistance) {
          camera.position.copy(getMonitorCameraPosition(straightOn));
          camera.lookAt(0, 0, 0);
        }
        updateMonitor();
        resolve();
        return;
      }
      const from = camera.position.clone();
      const target = getMonitorCameraPosition(straightOn);
      const startedAt = performance.now();
      const duration = 620;
      const animate = (now: number) => {
        const progress = Math.min((now - startedAt) / duration, 1);
        const eased = 1 - (1 - progress) ** 3;
        camera.position.lerpVectors(from, target, eased);
        camera.lookAt(0, 0, 0);
        updateMonitor();
        if (progress < 1) requestAnimationFrame(animate);
        else resolve();
      };
      requestAnimationFrame(animate);
    });
    const resizeObserver = new ResizeObserver(alignGameToScreen);
    resizeObserver.observe(kumoStage);
    window.addEventListener("resize", alignGameToScreen);
    let monitorRenderFrame: number | undefined;
    const renderFrame = () => {
      monitorRenderFrame = undefined;
      renderer.render(scene, camera);
      if (kumoGameActive) monitorRenderFrame = requestAnimationFrame(renderFrame);
    };
    function startMonitorRenderLoop() {
      if (monitorRenderFrame === undefined) monitorRenderFrame = requestAnimationFrame(renderFrame);
    }
    function stopMonitorRenderLoop() {
      if (monitorRenderFrame !== undefined) cancelAnimationFrame(monitorRenderFrame);
      monitorRenderFrame = undefined;
      renderer.render(scene, camera);
    }
    kumoStage.dataset.monitorReady = "true";
    kumoStage.addEventListener("kumo:monitor-start", startMonitorRenderLoop);
    kumoStage.addEventListener("kumo:monitor-stop", stopMonitorRenderLoop);
  }

  function loadKumoScene() {
    if (!kumoGameVideo) return;
    const sceneSrc = kumoMobileViewport.matches
      ? kumoGameVideo.dataset.mobileSrc
      : kumoGameVideo.dataset.desktopSrc;
    if (!sceneSrc || kumoGameVideo.src.endsWith(sceneSrc)) return;
    kumoGameVideo.src = sceneSrc;
    kumoGameVideo.load();
  }

  let kumoSceneLoaded = false;
  const kumoSceneObserver =
    kumoGame && "IntersectionObserver" in window
      ? new IntersectionObserver(
          (entries) => {
            if (!entries.some((entry) => entry.isIntersecting)) return;
            loadKumoScene();
            kumoSceneLoaded = true;
            kumoSceneObserver?.disconnect();
          },
          { rootMargin: "400px 0px" },
        )
      : undefined;

  if (kumoSceneObserver && kumoGame) {
    kumoSceneObserver.observe(kumoGame);
  } else {
    loadKumoScene();
    kumoSceneLoaded = true;
  }

  kumoMobileViewport.addEventListener("change", () => {
    if (kumoSceneLoaded) loadKumoScene();
  });

  function sizeKumoGameWindow() {
    if (!kumoGameScene || !kumoGameVideo?.videoWidth || !kumoGameVideo.videoHeight) return;
    kumoGameScene.style.setProperty(
      "--kumo-video-ratio",
      `${kumoGameVideo.videoWidth} / ${kumoGameVideo.videoHeight}`,
    );
  }

  kumoGameVideo?.addEventListener("loadedmetadata", sizeKumoGameWindow);
  sizeKumoGameWindow();

  function isTypingTarget(target: EventTarget | null) {
    return target instanceof HTMLElement &&
      (target.matches("input, textarea, select, [contenteditable='true']") ||
        Boolean(target.closest("input, textarea, select, [contenteditable='true']")));
  }

  function playKumoVideo() {
    if (kumoReducedMotion.matches) return;
    if (!kumoGameVideo) return;
    if (!kumoSceneLoaded) {
      loadKumoScene();
      kumoSceneLoaded = true;
    }
    kumoGameVideo.play().catch(() => undefined);
  }

  function playKumoAudio() {
    if (!kumoSoundEnabled || !kumoGameActive || !kumoAudio) return;
    kumoAudio.play().catch(() => undefined);
  }

  function fadeKumoAudio(targetVolume: number, pauseWhenDone = false) {
    if (!kumoAudio) return;
    if (kumoAudioFadeFrame !== undefined) {
      window.cancelAnimationFrame(kumoAudioFadeFrame);
      kumoAudioFadeFrame = undefined;
    }

    const startVolume = kumoAudio.volume;
    const endVolume = Math.max(0, Math.min(1, targetVolume));
    if (kumoReducedMotion.matches || Math.abs(startVolume - endVolume) < 0.01) {
      kumoAudio.volume = endVolume;
      if (pauseWhenDone) kumoAudio.pause();
      return;
    }

    const startTime = performance.now();
    const fadeDuration = 420;
    const step = (now: number) => {
      const progress = Math.min((now - startTime) / fadeDuration, 1);
      const easedProgress = 1 - Math.pow(1 - progress, 3);
      kumoAudio.volume = startVolume + (endVolume - startVolume) * easedProgress;
      if (progress < 1) {
        kumoAudioFadeFrame = window.requestAnimationFrame(step);
      } else {
        kumoAudioFadeFrame = undefined;
        if (pauseWhenDone) kumoAudio.pause();
      }
    };

    kumoAudioFadeFrame = window.requestAnimationFrame(step);
  }

  function setKumoSoundEnabled(enabled: boolean) {
    kumoSoundEnabled = enabled;
    if (!kumoAudio || !kumoSoundButton) return;
    kumoAudio.muted = !enabled;
    if (kumoSoundIcon) {
      kumoSoundIcon.src = enabled
        ? "/game/kumo/ui/sound-on.png"
        : "/game/kumo/ui/sound-off.png";
    }
    kumoSoundButton.setAttribute("aria-pressed", String(enabled));
    kumoSoundButton.setAttribute("aria-label", enabled ? "Mute Kumo music" : "Turn Kumo music on");
    kumoSoundButton.classList.toggle("kumo-game__sound-button--on", enabled);
    if (enabled) {
      playKumoAudio();
      fadeKumoAudio(kumoVolumeLevel);
    } else {
      if (kumoAudioFadeFrame !== undefined) {
        window.cancelAnimationFrame(kumoAudioFadeFrame);
        kumoAudioFadeFrame = undefined;
      }
      kumoAudio.volume = kumoVolumeLevel;
      kumoAudio.pause();
    }
  }

  function stopKumoFrames() {
    if (kumoFrameTimer !== undefined) {
      window.clearTimeout(kumoFrameTimer);
      kumoFrameTimer = undefined;
    }
  }

  function scheduleKumoFrame() {
    if (
      !kumoGameActive ||
      kumoReducedMotion.matches ||
      !kumoSprite ||
      kumoFrameTimer !== undefined
    ) return;
    kumoFrameTimer = window.setTimeout(() => {
      kumoFrameTimer = undefined;
      kumoFrameIndex = (kumoFrameIndex + 1) % kumoIdleFrames.length;
      kumoSprite.src = kumoIdleFrames[kumoFrameIndex];
      scheduleKumoFrame();
    }, kumoIdleDurations[kumoFrameIndex]);
  }

  function setKumoGameState(nextState: KumoGameState) {
    if (kumoGameState === nextState) return;
    kumoGameState = nextState;
    kumoGame?.classList.toggle("kumo-game--dialogue", nextState === "dialogue");
    kumoGame?.classList.toggle("kumo-game--choice", nextState === "choice");
    kumoUndertale?.setAttribute("aria-hidden", String(nextState !== "dialogue"));
    kumoChoices?.classList.toggle("kumo-game__choices--visible", nextState === "choice");
    kumoChoices?.setAttribute("aria-hidden", String(nextState !== "choice"));
    kumoSpriteButton?.setAttribute("aria-hidden", "false");
    if (kumoSpriteButton) kumoSpriteButton.disabled = nextState !== "idle";
    kumoPrompts?.forEach((prompt) => {
      prompt.setAttribute("aria-hidden", String(nextState !== "idle"));
      prompt.disabled = nextState !== "idle";
    });
    kumoChoiceButtons?.forEach((button) => {
      button.disabled = nextState !== "choice";
    });
  }

  function clearUndertaleTimer() {
    if (kumoUndertaleAdvanceTimer !== undefined) {
      window.clearTimeout(kumoUndertaleAdvanceTimer);
      kumoUndertaleAdvanceTimer = undefined;
    }
  }

  function playKumoUndertale(index: number) {
    clearUndertaleTimer();
    kumoUndertaleIndex = index;
    if (!kumoUndertaleVideo) return;
    kumoUndertaleVideo.pause();
    kumoUndertaleVideo.src = kumoUndertaleVideos[index];
    kumoUndertaleVideo.load();
    void kumoUndertaleVideo.play().catch(() => undefined);
  }

  function advanceKumoUndertale() {
    clearUndertaleTimer();
    if (kumoUndertaleIndex < kumoUndertaleVideos.length - 1) {
      playKumoUndertale(kumoUndertaleIndex + 1);
      return;
    }
    setKumoGameState("choice");
  }

  function finishKumoUndertale() {
    kumoUndertaleAdvanceTimer = window.setTimeout(advanceKumoUndertale, 2000);
  }

  function startKumoDialogue() {
    if (!kumoGameActive || kumoGameState !== "idle" || kumoDialogueStarting) return;
    kumoDialogueStarting = true;
    stopKumoFrames();
    kumoGame?.classList.add("kumo-game--turning");
    void kumoAnimateMonitorView(true).then(() => {
      kumoDialogueStarting = false;
      if (!kumoGameActive || kumoGameState !== "idle") {
        kumoGame?.classList.remove("kumo-game--turning");
        void kumoAnimateMonitorView(false);
        scheduleKumoFrame();
        return;
      }
      playKumoUndertale(0);
      setKumoGameState("dialogue");
    });
  }

  function returnToKumoIdle() {
    kumoDialogueStarting = false;
    kumoGame?.classList.remove("kumo-game--turning");
    void kumoAnimateMonitorView(false);
    clearUndertaleTimer();
    kumoUndertaleIndex = 0;
    kumoFrameIndex = 0;
    if (kumoSprite) kumoSprite.src = kumoIdleFrames[0];
    setKumoGameState("idle");
    stopKumoFrames();
    scheduleKumoFrame();
  }

  kumoSoundButton?.addEventListener("click", () => setKumoSoundEnabled(!kumoSoundEnabled));
  kumoGameScene?.addEventListener("click", () => {
    if (kumoGameState === "idle") startKumoDialogue();
    else if (kumoGameState === "dialogue") advanceKumoUndertale();
  });

  kumoUndertaleVideo?.addEventListener("ended", finishKumoUndertale);

  kumoChoiceButtons?.forEach((button) => {
    button.addEventListener("click", (event) => {
      event.stopPropagation();
      if (button.dataset.kumoChoice === "ask") {
        returnToKumoIdle();
        window.dispatchEvent(new CustomEvent("kumo:open"));
      } else {
        returnToKumoIdle();
      }
    });
  });

  document.addEventListener("keydown", (event) => {
    if (!kumoGameActive || isTypingTarget(event.target)) return;
    if (event.key === "Escape" && kumoGameState !== "idle") {
      returnToKumoIdle();
      return;
    }
    if (["e", "f"].includes(event.key.toLowerCase()) && kumoGameState === "idle") {
      event.preventDefault();
      startKumoDialogue();
    }
  });

  kumoReducedMotion.addEventListener("change", () => {
    if (kumoReducedMotion.matches) {
      stopKumoFrames();
      kumoGameVideo?.pause();
      if (kumoSprite) kumoSprite.src = kumoIdleFrames[0];
    } else if (kumoGameActive) {
      playKumoVideo();
      scheduleKumoFrame();
    }
  });

  const kumoGameObserver = kumoGame && new IntersectionObserver(([entry]) => {
    kumoGameActive = Boolean(entry?.isIntersecting && entry.intersectionRatio >= 0.35);
    if (kumoGameActive) {
      kumoStage?.dispatchEvent(new Event("kumo:monitor-start"));
      playKumoVideo();
      playKumoAudio();
      fadeKumoAudio(kumoSoundEnabled ? kumoVolumeLevel : 0);
      scheduleKumoFrame();
    } else {
      kumoStage?.dispatchEvent(new Event("kumo:monitor-stop"));
      kumoGameVideo?.pause();
      if (kumoSoundEnabled) fadeKumoAudio(0, true);
      else kumoAudio?.pause();
      stopKumoFrames();
    }
  }, { threshold: [0, 0.35] });

  if (kumoGame) kumoGameObserver?.observe(kumoGame);
</script>

