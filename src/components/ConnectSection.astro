<section class="connect-section" data-scroll-reveal-section="connect" aria-labelledby="connect-title">
  <div class="connect-inner" data-scroll-reveal-group>
    <div class="connect-copy-column">
      <h2 id="connect-title">Let's connect</h2>
      <p class="connect-copy">
        Found something interesting?<br />
        Say hello.
      </p>
      <div class="connect-actions">
        <a class="connect-button connect-button-primary" href="https://www.linkedin.com/in/entwan" target="_blank" rel="noreferrer">LinkedIn <span aria-hidden="true">&#x2197;</span></a>
        <a class="connect-button connect-button-secondary" href="mailto:enkhamgalan.entwan@outlook.com">Email me <span aria-hidden="true">&#x2197;</span></a>
      </div>
    </div>

    <div class="connect-art">
      <div class="connect-envelope">
        <div class="connect-letter">
          <span>Send me<br />an e-mail</span>
          <a
            class="connect-email-link"
            href="mailto:enkhamgalan.entwan@outlook.com?subject=Here%20from%20your%20portfolio&body=HEyyyy...%0A%0A"
          >enkhamgalan.entwan@outlook.com</a>
        </div>
        <div class="connect-envelope-back"></div>
        <div class="connect-envelope-flap"></div>
        <div class="connect-envelope-front"></div>
      </div>
    </div>
  </div>
</section>

<style>
  .connect-section {
    position: relative;
    transform: translateY(24px);
    isolation: isolate;
    overflow: hidden;
    min-height: min(760px, 88vh);
    display: grid;
    align-items: center;
    padding: clamp(120px, 16vw, 210px) 5vw clamp(70px, 8vw, 110px);
    background:
      radial-gradient(circle, rgba(77, 104, 80, 0.12) 1px, transparent 1.5px),
      linear-gradient(
        to bottom,
        #edecea 0px,
        #edecea 20px,
        #e5ebe5 110px,
        #dfe9df 220px,
        #dfe9df 100%
      );
    background-size: 28px 28px, auto;
    color: #111;
    opacity: var(--scroll-fade, 1);
    transition: opacity 0.6s cubic-bezier(0.25, 0.1, 0.25, 1), transform 0.6s cubic-bezier(0.25, 0.1, 0.25, 1);
  }

  .connect-section.is-visible { transform: translateY(0); }

  .connect-section::after {
    position: absolute;
    right: 0;
    left: 0;
    z-index: 0;
    height: clamp(44px, 7vw, 92px);
    content: "";
    pointer-events: none;
  }

  .connect-section::after { bottom: 0; background: linear-gradient(to top, #f7f6f4, transparent); }

  .connect-inner {
    position: relative;
    z-index: 1;
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(320px, 0.8fr);
    align-items: center;
    gap: clamp(48px, 9vw, 150px);
    width: min(1180px, 100%);
    margin: 0 auto;
  }

  .connect-copy-column { text-align: left; }

  .connect-label {
    margin: 0 0 17px;
    color: #4d7657;
    font: 0.68rem "Courier Prime", monospace;
    letter-spacing: 0.12em;
  }

  .connect-section h2 {
    max-width: 8ch;
    margin: 0;
    font: 400 clamp(4rem, 8vw, 8.5rem)/0.86 "Instrument Serif", serif;
    letter-spacing: -0.05em;
  }

  .connect-copy {
    max-width: 520px;
    margin: 27px 0 0;
    color: #4d7657;
    font: 400 clamp(1.35rem, 2.4vw, 2rem)/1.2 "Instrument Serif", serif;
  }

  .connect-actions { display: flex; justify-content: flex-start; flex-wrap: wrap; gap: 11px; margin-top: 34px; }

  .connect-button {
    display: inline-flex;
    align-items: center;
    gap: 12px;
    border: 1px solid #4d7657;
    border-radius: 999px;
    padding: 12px 17px;
    font: 0.7rem "Courier Prime", monospace;
    text-decoration: none;
    transition: background 0.2s ease, color 0.2s ease, transform 0.2s ease;
  }

  .connect-button span { font-size: 1rem; }
  .connect-button-primary { background: #4d7657; color: #fff; }
  .connect-button-secondary { background: transparent; color: #4d7657; }
  .connect-button:hover { background: #111; border-color: #111; color: #fff; transform: translateY(-2px); }

  .connect-art { display: grid; place-items: center; min-height: 360px; }

  .connect-envelope {
    position: relative;
    width: min(110%, 440px);
    aspect-ratio: 1.42;
    transform: rotate(3deg);
  }

  .connect-envelope-back,
  .connect-envelope-front,
  .connect-envelope-flap,
  .connect-letter { position: absolute; left: 0; width: 100%; }

  .connect-envelope-back {
    inset: 14% 0 0;
    height: 86%;
    border: 2px solid #26382b;
    border-radius: 5px;
    background: #6f9477;
    box-shadow: 14px 16px 0 rgba(38, 56, 43, 0.14);
  }

  .connect-letter {
    bottom: 20%;
    z-index: 2;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    width: 78%;
    height: 78%;
    margin-left: 11%;
    padding: 24px 25px;
    border: 1px solid rgba(17, 17, 17, 0.22);
    background: #fffaf0;
    color: #26382b;
    box-shadow: 5px 7px 0 rgba(38, 56, 43, 0.12);
    transform: translateY(42%);
    transition: transform 1.25s cubic-bezier(0.22, 1, 0.36, 1);
  }

  .connect-section.is-visible .connect-letter { transform: translateY(-23%); }
  .connect-letter span { font: 400 clamp(1.8rem, 3vw, 2.8rem)/0.92 "Instrument Serif", serif; }
  .connect-letter small {
    position: absolute;
    right: 25px;
    bottom: 28%;
    left: 25px;
    font: 0.85rem/1.35 "Courier Prime", monospace;
    overflow-wrap: anywhere;
  }

  .connect-email-link {
    position: absolute;
    right: 25px;
    bottom: 28%;
    left: 25px;
    color: inherit;
    font: 0.85rem/1.35 "Courier Prime", monospace;
    overflow-wrap: anywhere;
    text-decoration: underline;
    text-decoration-thickness: 1px;
    text-underline-offset: 3px;
  }

  .connect-envelope-flap {
    top: 2%;
    z-index: 1;
    height: 70%;
    background: #86a88a;
    clip-path: polygon(0 100%, 50% 0, 100% 100%);
    filter: drop-shadow(0 2px 0 #26382b);
  }

  .connect-envelope-front {
    top: 42%;
    bottom: 0;
    z-index: 3;
    height: auto;
    overflow: hidden;
    border: 2px solid #26382b;
    border-top: 0;
    border-radius: 0 0 5px 5px;
    background: #73997a;
  }

  .connect-envelope-front::before,
  .connect-envelope-front::after {
    position: absolute;
    inset: 0;
    content: "";
    pointer-events: none;
  }

  .connect-envelope-front::before {
    background: #86a88a;
    clip-path: polygon(0 0, 53% 68%, 0 100%);
  }

  .connect-envelope-front::after {
    background: #6f9477;
    clip-path: polygon(100% 0, 100% 100%, 47% 68%);
  }

  @media (max-width: 700px) {
    .connect-section { min-height: 110dvh; padding: 136px 20px 36px; }
    .connect-inner { grid-template-columns: 1fr; gap: 42px; }
    .connect-copy-column { transform: translateY(24px); }
    .connect-section h2 { max-width: none; font-size: clamp(4rem, 18vw, 6rem); }
    .connect-copy { margin-top: 22px; }
    .connect-actions { margin-top: 28px; }
    .connect-art { min-height: 250px; margin-top: 48px; }
    .connect-envelope { width: min(78vw, 320px); }
    .connect-section.is-visible .connect-letter { transform: translateY(-8%); }
    .connect-envelope-back,
    .connect-envelope-flap,
    .connect-envelope-front { transform: translateY(24px); }
    .connect-email-link {
      bottom: 38%;
      font-size: 0.67rem;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .connect-section, .connect-button, .connect-letter { transition: none; }
  }
</style>

<script>
  const connectSection = document.querySelector<HTMLElement>(
    ".connect-section",
  );

  if (connectSection) {
    const connectObserver = new IntersectionObserver(
      ([entry]) => {
        connectSection.classList.toggle("is-visible", entry.isIntersecting);
      },
      {
        threshold: 0.18,
        rootMargin: "-8% 0px -8% 0px",
      },
    );

    connectObserver.observe(connectSection);
  }
</script>
