---
interface Props {
  id: string;
  ariaLabel: string;
}

const {
  id,
  ariaLabel,
} = Astro.props;
---

<div
  class="project-overlay"
  id={id}
  aria-hidden="true"
>
  <div
    class="project-sheet"
    role="dialog"
    aria-modal="true"
    aria-label={ariaLabel}
  >
    <button
      class="project-close"
      type="button"
      aria-label="Close project"
      data-project-close
    >
      ×
    </button>

    <div class="project-sheet-scroll">
      <slot />
    </div>
  </div>
</div>

<script>
  function openProject(projectId: string) {
    const overlay =
      document.getElementById(projectId);

    if (!overlay) return;

    overlay.classList.add("is-open");
    overlay.setAttribute("aria-hidden", "false");

    document.body.style.overflow = "hidden";
  }

  function closeProject(
    overlay: HTMLElement
  ) {
    overlay.classList.remove("is-open");
    overlay.setAttribute("aria-hidden", "true");

    document.body.style.overflow = "";
  }

  document
    .querySelectorAll<HTMLElement>(
      "[data-project-open]"
    )
    .forEach((trigger) => {
      trigger.addEventListener("click", () => {
        const projectId =
          trigger.dataset.projectOpen;

        if (!projectId) return;

        openProject(projectId);
      });
    });

  document
    .querySelectorAll<HTMLElement>(
      ".project-overlay"
    )
    .forEach((overlay) => {
      const closeButton =
        overlay.querySelector<HTMLButtonElement>(
          "[data-project-close]"
        );

      closeButton?.addEventListener(
        "click",
        () => {
          closeProject(overlay);
        }
      );

      overlay.addEventListener(
        "click",
        (event) => {
          if (event.target === overlay) {
            closeProject(overlay);
          }
        }
      );
    });

  document.addEventListener(
    "keydown",
    (event) => {
      if (event.key !== "Escape") return;

      const openOverlay =
        document.querySelector<HTMLElement>(
          ".project-overlay.is-open"
        );

      if (openOverlay) {
        closeProject(openOverlay);
      }
    }
  );
</script>

<style>
  .project-overlay {
    position: fixed;

    inset: 0;

    display: flex;
    align-items: flex-end;
    justify-content: center;

    padding: 20px 30px 0;

    background: rgba(237, 236, 234, 0.42);

    backdrop-filter: blur(14px);
    -webkit-backdrop-filter: blur(14px);

    opacity: 0;
    visibility: hidden;
    pointer-events: none;

    z-index: 9998;

    transition:
      opacity 0.35s ease,
      visibility 0.35s ease;
  }

  .project-overlay.is-open {
    opacity: 1;
    visibility: visible;
    pointer-events: auto;
  }

  .project-sheet {
    position: relative;

    width: min(
      1400px,
      calc(100vw - 60px)
    );

    height: calc(100vh - 40px);

    overflow: hidden;

    background: #f7f6f4;

    border:
      1px solid
      rgba(17, 17, 17, 0.12);

    border-radius:
      28px 28px 0 0;

    box-shadow:
      0 -20px 70px
      rgba(17, 17, 17, 0.12);

    transform:
      translateY(110%);

    transition:
      transform 0.72s
      cubic-bezier(0.22, 1, 0.36, 1);
  }

  .project-overlay.is-open
    .project-sheet {
    transform:
      translateY(0);
  }

  .project-sheet-scroll {
    width: 100%;
    height: 100%;

    overflow-y: auto;
    overscroll-behavior: contain;

    scrollbar-width: thin;
  }

  .project-close {
    position: absolute;

    top: 22px;
    right: 22px;

    display: flex;
    align-items: center;
    justify-content: center;

    width: 46px;
    height: 46px;

    padding: 0;

    border:
      1px solid
      rgba(17, 17, 17, 0.14);

    border-radius: 50%;

    background:
      rgba(247, 246, 244, 0.9);

    backdrop-filter:
      blur(8px);

    -webkit-backdrop-filter:
      blur(8px);

    font-family:
      "Courier Prime",
      monospace;

    font-size: 1.55rem;

    line-height: 1;

    color: #111111;

    cursor: pointer;

    z-index: 20;

    transition:
      transform 0.2s ease,
      background 0.2s ease;
  }

  .project-close:hover {
    transform: rotate(6deg);

    background: #edecea;
  }

  @media (max-width: 640px) {
    .project-overlay {
      padding: 0;
    }

    .project-sheet {
      width: 100%;

      height: 100dvh;

      border: 0;

      border-radius: 0;

      box-shadow: none;
    }

    .project-close {
      position: fixed;

      top: 16px;
      right: 16px;

      width: 42px;
      height: 42px;
    }
  }

  @media (
    prefers-reduced-motion: reduce
  ) {
    .project-overlay,
    .project-sheet,
    .project-close {
      transition: none;
    }
  }
</style>