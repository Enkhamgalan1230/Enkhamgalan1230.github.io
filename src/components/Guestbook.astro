<section
  class="guestbook"
  id="guestbook"
  data-scroll-fade-section
  data-scroll-reveal-section="guestbook"
  data-scroll-reveal-group
  aria-labelledby="guestbook-title"
>
  <div class="guestbook-inner">
    <div class="guestbook-heading">
      <p class="guestbook-label">SIGN THE GUESTBOOK</p>

      <h2 id="guestbook-title">
        Leave a little <span>note.</span>
      </h2>

    </div>

    <div class="guestbook-layout">
      <form class="guestbook-form" data-guestbook-form>
        <label>
          <span>I wanna know who wrote it thooo</span>

          <input
            type="text"
            name="name"
            maxlength="40"
            placeholder="e.g. Orgil"
            autocomplete="name"
            required
          />
        </label>

        <label>
          <span>Your note</span>

          <textarea
            name="message"
            maxlength="280"
            rows="5"
            placeholder="Hello from..."
            required
          ></textarea>
        </label>

        <div class="guestbook-form-footer">
          <small>
            Notes are filtered before they appear.
          </small>

          <button type="submit">
            Leave note <span aria-hidden="true">→</span>
          </button>
        </div>

        <p
          class="guestbook-status"
          data-guestbook-status
          role="status"
          aria-live="polite"
        ></p>
      </form>

      <div
        class="guestbook-entries"
        data-guestbook-entries
        aria-live="polite"
      >
        <p class="guestbook-empty" data-guestbook-empty>
          No notes yet. Be the first.
        </p>
      </div>

      <button
        class="guestbook-see-all"
        type="button"
        data-guestbook-see-all
        hidden
      >
        SHOW ALL NOTES <span aria-hidden="true">&#x2197;</span>
      </button>

    </div>

    <div class="guestbook-admin" data-guestbook-admin hidden>
      <span>Welcome back, boss.</span>

      <button type="button" data-guestbook-admin-exit>
        Exit
      </button>

      <p
        class="guestbook-admin-status"
        data-guestbook-admin-status
        role="status"
        aria-live="polite"
      ></p>
    </div>
  </div>

  <!-- All notes dialog -->
  <div
    class="guestbook-all-overlay"
    data-guestbook-all-overlay
    hidden
    data-lenis-prevent
  >
    <section
      class="guestbook-all-dialog"
      role="dialog"
      aria-modal="true"
      aria-labelledby="guestbook-all-title"
    >
      <button
        class="guestbook-note-dialog-close"
        type="button"
        data-guestbook-all-close
        aria-label="Close all notes"
      >
        &#x00D7;
      </button>

      <p class="guestbook-label">THE WALL</p>

      <h3 id="guestbook-all-title">
        All the notes.
      </h3>

      <div
        class="guestbook-all-entries"
        data-guestbook-all-entries
        data-lenis-prevent
      ></div>
    </section>
  </div>

  <!-- Individual full note dialog -->
  <div
    class="guestbook-note-overlay"
    data-guestbook-note-overlay
    hidden
    data-lenis-prevent
  >
    <article
      class="guestbook-note-dialog"
      data-guestbook-note-dialog
      data-lenis-prevent
      role="dialog"
      aria-modal="true"
      aria-labelledby="guestbook-note-author"
    >
      <button
        class="guestbook-note-dialog-close"
        type="button"
        data-guestbook-note-close
        aria-label="Close note"
      >
        &#x00D7;
      </button>

      <div class="guestbook-note-meta">
        <time data-guestbook-note-date></time>

        <h3
          id="guestbook-note-author"
          data-guestbook-note-author
        ></h3>
      </div>

      <p data-guestbook-note-message></p>
    </article>
  </div>
</section>

<script>
  type GuestbookEntry = {
    id: number;
    name: string;
    message: string;
    color: string;
    font: string;
    fontWeight: string;
    fontStyle: string;
    date: string;
  };

  const guestbookForm =
    document.querySelector<HTMLFormElement>(
      "[data-guestbook-form]",
    );

  const guestbookEntries =
    document.querySelector<HTMLElement>(
      "[data-guestbook-entries]",
    );

  const guestbookEmpty =
    document.querySelector<HTMLElement>(
      "[data-guestbook-empty]",
    );

  const guestbookSeeAll =
    document.querySelector<HTMLButtonElement>(
      "[data-guestbook-see-all]",
    );

  const guestbookAllOverlay =
    document.querySelector<HTMLElement>(
      "[data-guestbook-all-overlay]",
    );

  const guestbookAllClose =
    document.querySelector<HTMLButtonElement>(
      "[data-guestbook-all-close]",
    );

  const guestbookAllEntries =
    document.querySelector<HTMLElement>(
      "[data-guestbook-all-entries]",
    );

  const guestbookStatus =
    document.querySelector<HTMLElement>(
      "[data-guestbook-status]",
    );

  const guestbookAdmin =
    document.querySelector<HTMLElement>(
      "[data-guestbook-admin]",
    );

  const guestbookAdminExit =
    document.querySelector<HTMLButtonElement>(
      "[data-guestbook-admin-exit]",
    );

  const guestbookAdminStatus =
    document.querySelector<HTMLElement>(
      "[data-guestbook-admin-status]",
    );

  const guestbookNoteOverlay =
    document.querySelector<HTMLElement>(
      "[data-guestbook-note-overlay]",
    );

  const guestbookNoteDialog =
    document.querySelector<HTMLElement>(
      "[data-guestbook-note-dialog]",
    );

  const guestbookNoteClose =
    document.querySelector<HTMLButtonElement>(
      "[data-guestbook-note-close]",
    );

  const guestbookNoteDate =
    document.querySelector<HTMLElement>(
      "[data-guestbook-note-date]",
    );

  const guestbookNoteAuthor =
    document.querySelector<HTMLElement>(
      "[data-guestbook-note-author]",
    );

  const guestbookNoteMessage =
    document.querySelector<HTMLElement>(
      "[data-guestbook-note-message]",
    );

  const guestbookApiUrl =
    "https://enkhamgalan-spotify-api.zaecisama.workers.dev/api/guestbook";

  let guestbookAdminToken = "";

  let guestbookEntriesData: GuestbookEntry[] = [];

  const guestbookFontFamilies: Record<string, string> = {
    serif: '"Instrument Serif", serif',
    mono: '"Courier Prime", monospace',
    grotesk: "Arial, sans-serif",
    soft: '"Trebuchet MS", sans-serif',
    display:
      '"Palatino Linotype", "Book Antiqua", serif',
  };

  function getGuestbookVisitorId() {
    const storageKey =
      "entwan-guestbook-visitor-id";

    try {
      const saved =
        window.localStorage.getItem(storageKey);

      if (saved) {
        return saved;
      }

      const created =
        crypto.randomUUID();

      window.localStorage.setItem(
        storageKey,
        created,
      );

      return created;
    } catch {
      return `visitor-${Date.now()}-${Math.random()
        .toString(36)
        .slice(2)}`;
    }
  }

  const guestbookVisitorId =
    getGuestbookVisitorId();

  function formatGuestbookDate(
    dateValue: string,
  ) {
    return new Intl.DateTimeFormat(
      undefined,
      {
        month: "short",
        day: "numeric",
        year: "numeric",
      },
    ).format(
      new Date(
        dateValue.replace(" ", "T") + "Z",
      ),
    );
  }

  function createGuestbookEntryCard(
    entry: GuestbookEntry,
  ) {
    const article =
      document.createElement("article");

    article.className = [
      "guestbook-entry",
      `guestbook-entry--${
        entry.color || "sage"
      }`,
      `guestbook-entry--font-${
        entry.font || "serif"
      }`,
      `guestbook-entry--weight-${
        entry.fontWeight || "normal"
      }`,
      `guestbook-entry--style-${
        entry.fontStyle || "normal"
      }`,
    ].join(" ");

    article.dataset.guestbookEntryId =
      String(entry.id);

    article.tabIndex = 0;

    article.setAttribute(
      "role",
      "button",
    );

    article.setAttribute(
      "aria-label",
      `Read full guestbook note from ${entry.name}`,
    );

    const messageWrap =
      document.createElement("div");

    messageWrap.className =
      "guestbook-entry-message-wrap";

    const message =
      document.createElement("p");

    message.className =
      "guestbook-entry-message";

    message.textContent =
      entry.message;

    message.style.fontFamily =
      guestbookFontFamilies[
        entry.font
      ] ??
      guestbookFontFamilies.serif;

    message.style.fontWeight =
      entry.fontWeight === "bold"
        ? "700"
        : "400";

    message.style.fontStyle =
      entry.fontStyle === "italic"
        ? "italic"
        : "normal";

    if (entry.font === "serif") {
      message.style.fontSize =
        "1.8rem";

      message.style.lineHeight =
        "1.18";
    } else if (
      entry.font === "display"
    ) {
      message.style.fontSize =
        "1.7rem";

      message.style.lineHeight =
        "1.28";
    }

    messageWrap.append(message);

    const name =
      document.createElement("strong");

    name.textContent =
      `from: ${entry.name}`;

    const date =
      document.createElement("time");

    date.textContent =
      formatGuestbookDate(
        entry.date,
      );

    const meta =
      document.createElement("div");

    meta.className =
      "guestbook-entry-meta";

    meta.append(date, name);

    article.append(
      messageWrap,
      meta,
    );

    if (guestbookAdminToken) {
      const deleteButton =
        document.createElement(
          "button",
        );

      deleteButton.type =
        "button";

      deleteButton.className =
        "guestbook-entry-delete";

      deleteButton.dataset.guestbookDelete =
        String(entry.id);

      deleteButton.textContent =
        "Delete";

      article.append(
        deleteButton,
      );
    }

    return article;
  }

  function renderGuestbookEntries(
    entries: GuestbookEntry[],
  ) {
    if (
      !guestbookEntries ||
      !guestbookEmpty
    ) {
      return;
    }

    guestbookEntries
      .querySelectorAll(
        ".guestbook-entry-track",
      )
      .forEach((track) => track.remove());

    guestbookAllEntries?.replaceChildren();

    guestbookEmpty.hidden =
      entries.length > 0;

    guestbookSeeAll?.toggleAttribute(
      "hidden",
      entries.length === 0,
    );

    if (entries.length === 0) {
      return;
    }

    const track = document.createElement("div");
    track.className = "guestbook-entry-track";

    const renderCards = () =>
      entries.map((entry) =>
        createGuestbookEntryCard(entry),
      );

    track.append(
      ...renderCards(),
      ...(window.matchMedia(
        "(prefers-reduced-motion: reduce)",
      ).matches
        ? []
        : renderCards()),
    );

    guestbookEntries.append(track);

    if (guestbookAllEntries) {
      guestbookAllEntries.replaceChildren(
        ...entries.map((entry) =>
          createGuestbookEntryCard(entry),
        ),
      );
    }
  }

  async function loadGuestbookEntries() {
    try {
      const response =
        await fetch(
          guestbookApiUrl,
          {
            cache: "no-store",
          },
        );

      if (!response.ok) {
        throw new Error(
          "Guestbook unavailable",
        );
      }

      const data =
        (await response.json()) as {
          entries?: GuestbookEntry[];
        };

      guestbookEntriesData =
        data.entries ?? [];

      renderGuestbookEntries(
        guestbookEntriesData,
      );
    } catch {
      if (guestbookStatus) {
        guestbookStatus.textContent =
          "The guestbook is taking a little nap. Try again soon.";
      }
    }
  }

  loadGuestbookEntries();

  function findGuestbookEntry(
    entryId: string,
  ) {
    return guestbookEntriesData.find(
      (entry) =>
        String(entry.id) ===
        entryId,
    );
  }

  function openGuestbookNote(
    entry: GuestbookEntry,
  ) {
    if (
      !guestbookNoteOverlay ||
      !guestbookNoteDialog ||
      !guestbookNoteMessage ||
      !guestbookNoteAuthor ||
      !guestbookNoteDate
    ) {
      return;
    }

    guestbookNoteAuthor.textContent =
      `from: ${entry.name}`;

    guestbookNoteDate.textContent =
      formatGuestbookDate(
        entry.date,
      );

    guestbookNoteMessage.textContent =
      entry.message;

    guestbookNoteMessage.style.fontFamily =
      guestbookFontFamilies[
        entry.font
      ] ??
      guestbookFontFamilies.serif;

    guestbookNoteMessage.style.fontWeight =
      entry.fontWeight === "bold"
        ? "700"
        : "400";

    guestbookNoteMessage.style.fontStyle =
      entry.fontStyle === "italic"
        ? "italic"
        : "normal";

    guestbookNoteDialog.className = [
      "guestbook-note-dialog",
      `guestbook-note-dialog--${
        entry.color || "sage"
      }`,
    ].join(" ");

    guestbookNoteOverlay.hidden =
      false;

    document.body.style.overflow =
      "hidden";

    guestbookNoteClose?.focus();
  }

  function closeGuestbookNote() {
    if (!guestbookNoteOverlay) {
      return;
    }

    guestbookNoteOverlay.hidden =
      true;

    if (
      !guestbookAllOverlay ||
      guestbookAllOverlay.hidden
    ) {
      document.body.style.overflow = "";
    }
  }

  function openAllGuestbookNotes() {
    if (!guestbookAllOverlay) {
      return;
    }

    guestbookAllOverlay.hidden = false;
    document.body.style.overflow = "hidden";
    guestbookAllClose?.focus();
  }

  function closeAllGuestbookNotes() {
    if (!guestbookAllOverlay) {
      return;
    }

    guestbookAllOverlay.hidden = true;
    document.body.style.overflow = "";
  }

  guestbookSeeAll?.addEventListener(
    "click",
    openAllGuestbookNotes,
  );

  guestbookAllClose?.addEventListener(
    "click",
    closeAllGuestbookNotes,
  );

  guestbookAllOverlay?.addEventListener(
    "click",
    (event) => {
      if (event.target === guestbookAllOverlay) {
        closeAllGuestbookNotes();
      }
    },
  );

  guestbookNoteClose?.addEventListener(
    "click",
    closeGuestbookNote,
  );

  guestbookNoteOverlay?.addEventListener(
    "click",
    (event) => {
      if (
        event.target ===
        guestbookNoteOverlay
      ) {
        closeGuestbookNote();
      }
    },
  );

  guestbookAdminExit?.addEventListener(
    "click",
    () => {
      guestbookAdminToken = "";

      if (guestbookAdmin) {
        guestbookAdmin.hidden =
          true;
      }

      renderGuestbookEntries(
        guestbookEntriesData,
      );
    },
  );

  async function handleGuestbookEntryClick(
    event: Event,
  ) {
    const target =
      event.target as HTMLElement;

    const deleteButton =
      target.closest<HTMLButtonElement>(
        "[data-guestbook-delete]",
      );

    if (deleteButton) {
      const entryId =
        deleteButton.dataset
          .guestbookDelete;

      if (
        !entryId ||
        !guestbookAdminToken
      ) {
        return;
      }

      event.stopPropagation();

      deleteButton.disabled =
        true;

      try {
        const response =
          await fetch(
            `${guestbookApiUrl}/${entryId}`,
            {
              method: "DELETE",

              headers: {
                Authorization:
                  `Bearer ${guestbookAdminToken}`,
              },
            },
          );

        if (!response.ok) {
          throw new Error(
            "Admin token rejected.",
          );
        }

        await loadGuestbookEntries();

        if (
          guestbookAdminStatus
        ) {
          guestbookAdminStatus.textContent =
            "Note deleted.";
        }
      } catch (error) {
        deleteButton.disabled =
          false;

        if (
          guestbookAdminStatus
        ) {
          guestbookAdminStatus.textContent =
            error instanceof Error
              ? error.message
              : "Could not delete note.";
        }
      }

      return;
    }

    const card =
      target.closest<HTMLElement>(
        "[data-guestbook-entry-id]",
      );

    const entryId =
      card?.dataset
        .guestbookEntryId;

    if (!entryId) {
      return;
    }

    const entry =
      findGuestbookEntry(
        entryId,
      );

    if (!entry) {
      return;
    }

    openGuestbookNote(entry);
  }

  function handleGuestbookEntryKeyboard(
    event: KeyboardEvent,
  ) {
    if (
      event.key !== "Enter" &&
      event.key !== " "
    ) {
      return;
    }

    const target =
      event.target as HTMLElement;

    if (
      target.closest("button")
    ) {
      return;
    }

    const card =
      target.closest<HTMLElement>(
        "[data-guestbook-entry-id]",
      );

    const entryId =
      card?.dataset
        .guestbookEntryId;

    if (!entryId) {
      return;
    }

    const entry =
      findGuestbookEntry(
        entryId,
      );

    if (!entry) {
      return;
    }

    event.preventDefault();

    openGuestbookNote(entry);
  }

  guestbookEntries?.addEventListener(
    "click",
    handleGuestbookEntryClick,
  );

  guestbookAllEntries?.addEventListener(
    "click",
    handleGuestbookEntryClick,
  );

  guestbookEntries?.addEventListener(
    "keydown",
    handleGuestbookEntryKeyboard,
  );

  guestbookAllEntries?.addEventListener(
    "keydown",
    handleGuestbookEntryKeyboard,
  );

  document.addEventListener(
    "keydown",
    (event) => {
      if (
        event.key !== "Escape"
      ) {
        return;
      }

      if (
        guestbookNoteOverlay &&
        !guestbookNoteOverlay.hidden
      ) {
        closeGuestbookNote();

        return;
      }

      if (
        guestbookAllOverlay &&
        !guestbookAllOverlay.hidden
      ) {
        closeAllGuestbookNotes();
      }

    },
  );

  guestbookForm?.addEventListener(
    "submit",
    async (event) => {
      event.preventDefault();

      const formData =
        new FormData(
          guestbookForm,
        );

      const name =
        String(
          formData.get("name") ??
            "",
        ).trim();

      const message =
        String(
          formData.get(
            "message",
          ) ?? "",
        ).trim();

      if (!name || !message) {
        return;
      }

      const submitButton =
        guestbookForm.querySelector<HTMLButtonElement>(
          "button[type='submit']",
        );

      if (submitButton) {
        submitButton.disabled =
          true;
      }

      if (guestbookStatus) {
        guestbookStatus.textContent =
          "Checking your note...";
      }

      try {
        const response =
          await fetch(
            guestbookApiUrl,
            {
              method: "POST",

              headers: {
                "Content-Type":
                  "application/json",
              },

              body: JSON.stringify({
                name,
                message,
                visitorId:
                  guestbookVisitorId,
              }),
            },
          );

        const data =
          (await response.json()) as {
            error?: string;
            adminSession?: string;
          };

        if (!response.ok) {
          throw new Error(
            data.error ??
              "Could not save note",
          );
        }

        if (
          data.adminSession
        ) {
          guestbookAdminToken =
            data.adminSession;

          if (guestbookAdmin) {
            guestbookAdmin.hidden =
              false;
          }

          if (
            guestbookAdminStatus
          ) {
            guestbookAdminStatus.textContent =
              "Delete mode enabled.";
          }

          renderGuestbookEntries(
            guestbookEntriesData,
          );
        }

        guestbookForm.reset();

        if (guestbookStatus) {
          guestbookStatus.textContent =
            "Your note is on the wall.";
        }

        await loadGuestbookEntries();
      } catch (error) {
        if (guestbookStatus) {
          guestbookStatus.textContent =
            error instanceof Error
              ? error.message
              : "Could not save note. Try again soon.";
        }
      } finally {
        if (submitButton) {
          submitButton.disabled =
            false;
        }
      }
    },
  );
</script>

<style>
  .guestbook {
    position: relative;

    min-height: min(820px, 100vh);

    padding:
      clamp(86px, 12vw, 160px)
      5vw
      clamp(110px, 14vw, 190px);

    background-color: #edecea;
    background-image:
      radial-gradient(
        circle,
        rgba(17, 17, 17, 0.17) 1.25px,
        transparent 1.5px
      );
    background-size: 30px 30px;

    opacity: var(--scroll-fade, 1);

    transition:
      opacity 0.6s cubic-bezier(0.25, 0.1, 0.25, 1),
      transform 0.6s cubic-bezier(0.25, 0.1, 0.25, 1);
  }

  .guestbook.is-visible {
    opacity: 1;
  }

  .guestbook-inner {
    position: relative;
    z-index: 2;

    width: min(100%, 1080px);

    margin: 0 auto;
  }

  .guestbook-heading {
    max-width: 650px;
  }

  .guestbook-label {
    margin: 0 0 14px;

    color: #777;

    font:
      0.68rem "Courier Prime",
      monospace;

    letter-spacing: 0.1em;
  }

  .guestbook h2 {
    margin: 0;

    font:
      400
      clamp(
        3.2rem,
        7vw,
        6.8rem
      ) /
      0.95
      "Instrument Serif",
      serif;

    letter-spacing: -0.035em;
  }

  .guestbook h2 span {
    color: #4d7657;
  }

  .guestbook-layout {
    display: grid;

    grid-template-columns:
      minmax(260px, 0.8fr)
      minmax(300px, 1.2fr);

    gap:
      clamp(
        34px,
        7vw,
        100px
      );

    margin-top:
      clamp(
        52px,
        8vw,
        92px
      );

    align-items: start;
  }

  .guestbook-form {
    padding: 22px;

    border:
      1px solid
      rgba(
        17,
        17,
        17,
        0.14
      );

    border-radius: 18px;

    background: #efefeb;
  }

  .guestbook-form > label {
    display: grid;

    gap: 8px;

    margin-bottom: 18px;

    color: #555;

    font:
      0.65rem
      "Courier Prime",
      monospace;

    letter-spacing: 0.05em;

    text-transform: uppercase;
  }

  .guestbook-form
    > label
    input,
  .guestbook-form
    > label
    textarea {
    width: 100%;

    border:
      1px solid
      rgba(
        17,
        17,
        17,
        0.2
      );

    border-radius: 10px;

    padding: 14px 15px;

    background: #f7f6f4;

    color: #111;

    font:
      0.8rem / 1.4
      "Courier Prime",
      monospace;

    outline: none;

    resize: vertical;

    transition:
      border-color 0.2s ease,
      box-shadow 0.2s ease,
      background 0.2s ease;
  }

  .guestbook-form
    > label
    input:focus,
  .guestbook-form
    > label
    textarea:focus {
    border-color: #4d7657;

    box-shadow:
      0 0 0 3px
      rgba(
        77,
        118,
        87,
        0.12
      );

    background: #fff;
  }

  .guestbook-form-footer {
    display: grid;

    gap: 12px;
  }

  .guestbook-form-footer
    small {
    display: block;

    color: #888;

    font:
      0.65rem
      "Courier Prime",
      monospace;

