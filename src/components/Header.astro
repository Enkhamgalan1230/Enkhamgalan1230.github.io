---
import FaceButton from "./FaceButton.astro";
---

<header class="site-header">
  <div class="header-inner">
    <div class="header-left">
      <FaceButton />

      <div class="identity">
        <div class="identity-name">
          Enkh-Amgalan Enkhbayar
        </div>

        <div class="identity-role">
          Data Scientist / AI Engineer
        </div>

        <div class="identity-mongolian">
          ᠡᠩᢈᠡ᠆ᠠᠮᠤᠭᠤᠯᠠᠩ
        </div>
      </div>
    </div>

    <div class="london-clock">
      <span class="clock-dot"></span>
      <span>LONDON</span>
      <span id="london-time">00:00:00</span>
    </div>

    <div class="header-right">
      <div class="social-links">
        <a
          href="https://www.linkedin.com/in/entwan"
          target="_blank"
          rel="noreferrer"
          aria-label="LinkedIn"
        >
          <svg viewBox="0 0 24 24" aria-hidden="true">
            <path
              d="M6.5 8.5H3.5V20H6.5V8.5ZM5 3A1.75 1.75 0 1 0 5 6.5A1.75 1.75 0 0 0 5 3ZM20.5 13.4C20.5 9.9 18.6 8.2 16.1 8.2C14.1 8.2 13.2 9.3 12.7 10.1V8.5H9.7V20H12.7V13.6C12.7 11.9 13 10.3 15.1 10.3C17.1 10.3 17.2 12.2 17.2 13.7V20H20.2L20.5 13.4Z"
            />
          </svg>
        </a>

        <a
          href="https://github.com/Enkhamgalan1230"
          target="_blank"
          rel="noreferrer"
          aria-label="GitHub"
        >
          <svg viewBox="0 0 24 24" aria-hidden="true">
            <path
              d="M12 2C6.5 2 2 6.6 2 12.2C2 16.7 4.9 20.5 8.8 21.8C9.3 21.9 9.5 21.6 9.5 21.3V19.4C6.7 20 6.1 18.2 6.1 18.2C5.6 17 5 16.7 5 16.7C4.1 16.1 5.1 16.1 5.1 16.1C6.1 16.2 6.6 17.2 6.6 17.2C7.5 18.8 8.9 18.3 9.5 18C9.6 17.3 9.9 16.8 10.2 16.5C8 16.2 5.7 15.3 5.7 11.5C5.7 10.4 6.1 9.5 6.7 8.8C6.6 8.5 6.3 7.5 6.8 6.1C6.8 6.1 7.6 5.8 9.5 7.1C10.3 6.9 11.1 6.8 12 6.8C12.9 6.8 13.7 6.9 14.5 7.1C16.4 5.8 17.2 6.1 17.2 6.1C17.7 7.5 17.4 8.5 17.3 8.8C17.9 9.5 18.3 10.4 18.3 11.5C18.3 15.3 16 16.2 13.8 16.5C14.2 16.8 14.5 17.5 14.5 18.5V21.3C14.5 21.6 14.7 21.9 15.2 21.8C19.1 20.5 22 16.7 22 12.2C22 6.6 17.5 2 12 2Z"
            />
          </svg>
        </a>
      </div>

      <a
        class="email-button"
        href="mailto:enkhamgalan.entwan@outlook.com"
        aria-label="Email Entwan"
        title="enkhamgalan.entwan@outlook.com"
      >
        <svg viewBox="0 0 24 24" aria-hidden="true">
          <path
            d="M3 5.5C3 4.67 3.67 4 4.5 4H19.5C20.33 4 21 4.67 21 5.5V18.5C21 19.33 20.33 20 19.5 20H4.5C3.67 20 3 19.33 3 18.5V5.5ZM5.03 6L12 11.23L18.97 6H5.03ZM19 7.25L12.6 12.05C12.24 12.32 11.76 12.32 11.4 12.05L5 7.25V18H19V7.25Z"
          />
        </svg>
      </a>
    </div>
  </div>
</header>

<script>
  const timeElement = document.querySelector<HTMLElement>("#london-time");

  function updateLondonTime() {
    if (!timeElement) return;

    const time = new Intl.DateTimeFormat("en-GB", {
      timeZone: "Europe/London",
      hour: "2-digit",
      minute: "2-digit",
      second: "2-digit",
      hour12: false,
    }).format(new Date());

    timeElement.textContent = time;
  }

  updateLondonTime();
  setInterval(updateLondonTime, 1000);
</script>

<style>
  .site-header {
    position: relative;
    padding: 28px 36px;
  }

  .header-inner {
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: center;

    width: 100%;
  }

  .header-left {
    display: flex;
    align-items: center;
    justify-self: start;

    gap: 18px;
    min-width: 0;
  }

  .identity {
    display: flex;
    flex-direction: column;
    justify-content: center;

    gap: 4px;
    min-width: 0;

    font-family: "Courier Prime", monospace;
  }

  .identity-name {
    font-size: 0.9rem;
    font-weight: 500;
    line-height: 1.15;

    color: #111111;

    white-space: nowrap;
  }

  .identity-role {
    font-size: 0.9rem;
    font-weight: 500;
    line-height: 1.2;

    color: #111111;

    white-space: nowrap;
  }

  .identity-mongolian {
    margin-top: 2px;

    font-family: "Noto Sans Mongolian", sans-serif;
    font-size: 1.5rem;
    font-weight: 100;
    line-height: 0.7;

    color: #111111;
  }

  .london-clock {
    position: static;
    transform: none;

    display: flex;
    align-items: center;
    justify-content: center;

    gap: 7px;

    font-family: "Courier Prime", monospace;
    font-size: 0.9rem;

    white-space: nowrap;
  }

  .clock-dot {
    width: 6px;
    height: 6px;

    border-radius: 50%;
    background: #4d7657;
  }

  .header-right {
    margin-left: 0;

    display: flex;
    align-items: center;
    justify-self: end;

    gap: 20px;

    flex-shrink: 0;
  }

  .social-links {
    display: flex;
    align-items: center;

    gap: 16px;

    flex-shrink: 0;
  }

  .social-links a,
  .email-button {
    display: flex;
    align-items: center;
    justify-content: center;

    width: 32px;
    height: 32px;

    flex-shrink: 0;

    transition: opacity 0.2s ease;
  }

  .social-links svg,
  .email-button svg {
    width: 30px;
    height: 30px;

    fill: currentColor;
  }

  .social-links a:hover,
  .email-button:hover {
    opacity: 0.55;
  }

  @media (max-width: 900px) {
    .identity-name {
      font-size: 0.82rem;
    }

    .identity-role {
      font-size: 0.76rem;
    }

    .identity-mongolian {
      font-size: 1rem;
    }

    .london-clock {
      font-size: 0.72rem;
    }

    .header-right {
      gap: 14px;
    }

    .social-links {
      gap: 12px;
    }

    .social-links a,
    .email-button {
      width: 28px;
      height: 28px;
    }

    .social-links svg,
    .email-button svg {
      width: 26px;
      height: 26px;
    }
  }

  @media (max-width: 640px) {
    .site-header {
      padding: 16px;
    }

    .header-inner {
      display: flex;
      align-items: center;
      gap: 10px;
    }

    .header-left {
      display: flex;
      align-items: center;

      gap: 10px;

      min-width: 0;
      flex: 1;
    }

    .identity {
      display: flex;
      flex: 1;

      min-width: 0;
    }

    .identity-name {
      font-size: 0.62rem;
      line-height: 1.1;

      white-space: normal;
    }

    .identity-role {
      font-size: 0.58rem;
      line-height: 1.15;

      white-space: normal;
    }

    .identity-mongolian {
      margin-top: 2px;

      font-size: 0.78rem;
      line-height: 0.8;
    }

    .header-right {
      margin-left: auto;

      display: flex;
      align-items: center;

      gap: 8px;

      flex-shrink: 0;
    }

    .social-links {
      gap: 8px;
    }

    .social-links a,
    .email-button {
      width: 32px;
      height: 32px;
    }

    .social-links svg,
    .email-button svg {
      width: 28px;
      height: 28px;
    }

    .london-clock {
      display: none;
    }

  }
</style>