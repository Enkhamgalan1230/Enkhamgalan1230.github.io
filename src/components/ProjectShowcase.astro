        <div class="kumo-track" aria-hidden="true">
          <div class="kumo-sequence">
            <div class="phone phone-c"><img src="/images/projects/mockups/kumo_mockup/kumo3.png" alt="" /></div>
            <div class="phone phone-d"><img src="/images/projects/mockups/kumo_mockup/kumo4.png" alt="" /></div>
            <div class="phone phone-a"><img src="/images/projects/mockups/kumo_mockup/kumo1.png" alt="" /></div>
            <div class="phone phone-b"><img src="/images/projects/mockups/kumo_mockup/kumo2.png" alt="" /></div>
            <div class="phone phone-c"><img src="/images/projects/mockups/kumo_mockup/kumo3.png" alt="" /></div>
            <div class="phone phone-d"><img src="/images/projects/mockups/kumo_mockup/kumo4.png" alt="" /></div>
