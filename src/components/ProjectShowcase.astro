---
const projects = [
  { number: "01", name: "Accountancy", meta: ["CLIENT PRESENTATION", "LLM API Gateway", "LLM CLASSIFICATION", "NUMPY", "OLLAMA", "PYTHON"], description: "A calmer way to review financial data, surface anomalies and reconcile accounts.", action: "READ MORE", target: "account-project" },
  { number: "02", name: "Merchant", meta: ["CLIENT-FACING", "RECOMMENDATION SYSTEMS", "GRU", "TENSORFLOW", "PROPHET", "PYTHON"], description: "A recommendation system that turns purchase behaviour into more useful product discovery.", action: "READ MORE", target: "merchant-recommendation-project" },
  { number: "03", name: "Receipt", meta: ["API", "WEB CRAWILING", "SQL DATABASE", "DATA PIPELINE", "PREDICTION", "ANALYSIS"], description: "A grocery intelligence tool for seeing price changes, planning purchases and spending with intent.", action: "READ MORE", target: "receipt-project" },
  { number: "04", name: "KUMO AI.exe", meta: ["RAG", "CLOUDFLARE WORKERS AI", "KNOWLEDGEBASE", "ASTRO", "GEMMA", "EMBEDDINGS"], description: "A small, grounded portfolio assistant with a slightly suspicious amount of personality.", action: "READ MORE", target: "kumo-project" },
];
---

