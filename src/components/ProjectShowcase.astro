            <div class="phone phone-d"><img src="/images/projects/mockups/kumo_mockup/kumo4.png" alt="" /></div>
            <div class="phone phone-a"><img src="/images/projects/mockups/kumo_mockup/kumo1.png" alt="" /></div>
