  <div class="showcase-grid">
    <article class="showcase-project showcase-account" data-motion-project>
      <div class="project-media account-stage" aria-label="Accountancy product screens">
        <div class="account-track" aria-hidden="true">
          <div class="account-sequence">
            <div class="account-screen"><img src="/images/projects/mockups/accountancy_mockup/acc1.png" alt="" /></div>
            <div class="account-screen"><img src="/images/projects/mockups/accountancy_mockup/acc2.png" alt="" /></div>
            <div class="account-screen"><img src="/images/projects/mockups/accountancy_mockup/acc3.png" alt="" /></div>
            <div class="account-screen"><img src="/images/projects/mockups/accountancy_mockup/acc4.png" alt="" /></div>
            <div class="account-screen"><img src="/images/projects/mockups/accountancy_mockup/acc5.png" alt="" /></div>
            <div class="account-screen"><img src="/images/projects/mockups/accountancy_mockup/acc6.png" alt="" /></div>
            <div class="account-screen"><img src="/images/projects/mockups/accountancy_mockup/acc1.png" alt="" /></div>
            <div class="account-screen"><img src="/images/projects/mockups/accountancy_mockup/acc2.png" alt="" /></div>
            <div class="account-screen"><img src="/images/projects/mockups/accountancy_mockup/acc3.png" alt="" /></div>
            <div class="account-screen"><img src="/images/projects/mockups/accountancy_mockup/acc4.png" alt="" /></div>
            <div class="account-screen"><img src="/images/projects/mockups/accountancy_mockup/acc5.png" alt="" /></div>
            <div class="account-screen"><img src="/images/projects/mockups/accountancy_mockup/acc6.png" alt="" /></div>
          </div>
        </div>
      </div>
      <div class="showcase-copy">
        <div class="showcase-kicker">{projects[0].meta.map((tag) => <span>{tag}</span>)}</div>
