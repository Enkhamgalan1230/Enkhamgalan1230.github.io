          <video autoplay muted loop playsinline preload="metadata" aria-label="Merchant recommendation system video"><source src="/images/projects/mockups/merchant.mp4" type="video/mp4" /></video>
        </div>
      </div>
      <div class="showcase-copy">
        <div class="showcase-kicker">{projects[1].meta.map((tag) => <span>{tag}</span>)}</div>
        <h3>{projects[1].name}</h3><p>{projects[1].description}</p>
        <button class="showcase-action" type="button" data-project-open={projects[1].target}>{projects[1].action}<span aria-hidden="true">↗</span></button>
      </div>
    </article>

    <article class="showcase-project showcase-receipt" data-motion-project>
      <div class="project-media receipt-stage" aria-label="Receipt data visualisation screens">
        <div class="receipt-screen"><img src="/images/projects/mockups/reciept_mockup/reciept1.png" alt="Receipt home screen" loading="lazy" /></div>
      </div>
      <div class="showcase-copy">
        <div class="showcase-kicker">{projects[2].meta.map((tag) => <span>{tag}</span>)}</div>
        <h3>{projects[2].name}</h3><p>{projects[2].description}</p>
        <button class="showcase-action" type="button" data-project-open={projects[2].target}>{projects[2].action}<span aria-hidden="true">↗</span></button>
