  @keyframes kumo-phone-size { 0%, 15%, 90%, 100% { transform: scale(.92); } 20%, 35% { transform: scale(.92); } 40%, 55% { transform: scale(.92); } 60%, 75% { transform: scale(.92); } 80%, 85% { transform: scale(.82); } }
  .phone-a { animation-name: kumo-phone-a; }
  .phone-b { animation-name: kumo-phone-b; }
  .phone-c { animation-name: kumo-phone-c; }
  .phone-d { animation-name: kumo-phone-d; }
  @keyframes kumo-phone-a { 0%, 15% { transform: scale(.98); } 20%, 35% { transform: scale(1.14); } 40%, 100% { transform: scale(.98); } }
  @keyframes kumo-phone-b { 0%, 15% { transform: scale(1.14); } 20%, 35% { transform: scale(.98); } 40%, 55% { transform: scale(.88); } 60%, 75% { transform: scale(.98); } 80%, 100% { transform: scale(1.14); } }
  @keyframes kumo-phone-c { 0%, 15% { transform: scale(.98); } 20%, 35% { transform: scale(.88); } 40%, 55% { transform: scale(.98); } 60%, 75% { transform: scale(1.14); } 80%, 100% { transform: scale(.98); } }
  @keyframes kumo-phone-d { 0%, 15% { transform: scale(.88); } 20%, 35% { transform: scale(.98); } 40%, 55% { transform: scale(1.14); } 60%, 75% { transform: scale(.98); } 80%, 100% { transform: scale(.88); } }
  @media (max-width: 800px) { .showcase-heading { display: block; } .showcase-intro { margin: 24px 0 0; } .showcase-grid { grid-template-columns: 1fr; row-gap: 48px; } .project-media { height: clamp(320px, 70vw, 450px); } .showcase-copy h3 { font-size: clamp(3rem, 13vw, 5rem); } }
  @media (max-width: 520px) { .project-showcase { padding-inline: 20px; } .showcase-heading h2 { font-size: clamp(3.8rem, 18vw, 6rem); } .showcase-grid { row-gap: 38px; } .project-media { height: 300px; } .account-stage { height: clamp(240px, 65vw, 340px); } .merchant-stage, .receipt-stage { height: clamp(190px, 50vw, 250px); } .account-back, .account-mid, .account-front { width: 108%; } .account-back { right: -39%; } .account-mid { left: -32%; } .account-front { left: -4%; } .merchant-browser { inset: 3% 3% 3%; } }
  @media (prefers-reduced-motion: reduce) { .project-media { opacity: 1; transition: none; } .kumo-track, .phone { animation-play-state: paused; } .account-sequence, .account-screen { animation: none; transform: none; } .showcase-action { transition: none; } }
</style>
