---
import ProjectModal from "../components/ProjectModal.astro";
---

<ProjectModal
  id="receipt-project"
  ariaLabel="Receipt project"
>
  <article class="receipt-project">

    <!-- =========================
         HERO
         ========================= -->

    <section class="project-hero">
      <div class="project-hero-top">
        <span>01 / SELECTED WORK</span>
        <span>2024 → 2025</span>
      </div>

      <h1>Receipt</h1>

      <p class="project-tagline">
        Turning supermarket data into
        smarter, budget-aware shopping.
      </p>

      <p class="project-supporting">
        An end-to-end platform built around
        hundreds of thousands of historical
        product records collected across five
        major UK supermarkets.
      </p>

      <div class="project-meta">
        <span>PYTHON</span>
        <span>SELENIUM</span>
        <span>POSTGRESQL</span>
        <span>SENTENCE TRANSFORMERS</span>
        <span>ARIMA</span>
        <span>STREAMLIT</span>
      </div>

      <div class="project-actions">
        <a
          href="https://receipt-entwan.streamlit.app/"
          target="_blank"
          rel="noreferrer"
        >
          EXPLORE LIVE APP ↗
        </a>

        <a
          href="https://github.com/Enkhamgalan1230/Reciept-Project"
          target="_blank"
          rel="noreferrer"
        >
          VIEW SOURCE CODE ↗
        </a>
      </div>
    </section>

    <!-- =========================
         VIDEO
         ========================= -->

    <section class="demo-section">
      <div class="demo-placeholder">
        <div>
          <span class="demo-label">
            PROJECT DEMO
          </span>

          <p>
            VIDEO COMING SOON
          </p>

          <span class="demo-play">
            ▶
          </span>
        </div>
      </div>
    </section>

    <!-- =========================
         PROBLEM / SOLUTION
         ========================= -->

    <section class="intro-grid">
      <div class="intro-block">
        <span class="section-number">
          01
        </span>

        <h2>
          The problem.
        </h2>

        <p>
          Grocery prices are constantly changing,
          but the tools students use to
          <strong>compare prices</strong>,
          <strong>manage a budget</strong> and
          <strong>plan their shopping</strong>
          are usually disconnected. Receipt brings
          those decisions together using regularly
          collected supermarket data.
        </p>
      </div>

      <div class="intro-block">
        <span class="section-number">
          02
        </span>

        <h2>
          What I built.
        </h2>

        <p>
          I designed and deployed an
          <strong>end-to-end application</strong>
          that collects and standardises supermarket
          data, compares products, tracks price movement
          and builds
          <strong>personalised shopping lists</strong>
          around a user's budget. The database has grown
          into a large historical catalogue collected
          across five UK supermarkets.
        </p>
      </div>
    </section>

    <!-- =========================
         ARCHITECTURE
         ========================= -->

    <section class="architecture-section">
      <div class="section-heading">
        <span>
          UNDER THE HOOD
        </span>

        <h2>
          From supermarket shelf
          to useful decision.
        </h2>
      </div>

      <div class="architecture-flow">

        <div class="architecture-node">
          <span>01</span>

          <strong>
            Retailer websites
          </strong>

          <small>
            Tesco, Sainsbury's,
            Asda, Aldi and Waitrose
          </small>
        </div>

        <div class="architecture-arrow">
          →
        </div>

        <div class="architecture-node">
          <span>02</span>

          <strong>
            Automated collection
          </strong>

          <small>
            Retailer-specific
            Selenium workflows
          </small>
        </div>

        <div class="architecture-arrow">
          →
        </div>

        <div class="architecture-node">
          <span>03</span>

          <strong>
            Standardisation
          </strong>

          <small>
            Names, prices, units,
            discounts and categories
          </small>
        </div>

        <div class="architecture-arrow">
          →
        </div>

        <div class="architecture-node">
          <span>04</span>

          <strong>
            Data storage
          </strong>

          <small>
            Historical product data
            stored in PostgreSQL
          </small>
        </div>

        <div class="architecture-arrow">
          →
        </div>

        <div class="architecture-node">
          <span>05</span>

          <strong>
            Intelligence
          </strong>

          <small>
            Semantic matching,
            budgeting and forecasting
          </small>
        </div>

        <div class="architecture-arrow">
          →
        </div>

        <div class="architecture-node">
          <span>06</span>

          <strong>
            Application
          </strong>

          <small>
            Interactive Streamlit
            user experience
          </small>
        </div>

      </div>

      <!-- =========================
           SCRAPING DETAIL
           ========================= -->

      <div class="scraping-detail">
        <div class="scraping-detail-text">
          <span>
            DATA COLLECTION
          </span>

          <h3>
            Getting the data was a project
            of its own.
          </h3>

          <p>
            No suitable <strong>API</strong> provided
            consistent pricing across all five retailers,
            so I built a separate collection workflow for
            each website. The
            <strong>Selenium scrapers</strong> handle
            different page structures,
            JavaScript-rendered products,
            pagination and missing values before cleaning
            and standardising the results. Over time,
            this pipeline has built a substantial
            historical supermarket dataset.
          </p>
        </div>

        <div class="scraping-detail-image visual-hover">
          <img
            src="/images/projects/receipt-pics/receipt-scraping-pipeline.jpg"
            alt="Receipt Selenium scraping workflow"
          />
        </div>
      </div>
    </section>

    <!-- =========================
         FEATURES
         ========================= -->

    <section class="features-section">
      <div class="section-heading">
        <span>
          SOME COOL TINGS
        </span>

        <h2>
          What Receipt actually does.
        </h2>
      </div>

      <div class="feature-grid">

        <article class="feature-card">
          <span>01</span>

          <h3>
            Budget-aware shopping lists
          </h3>

          <p>
            Users can type, speak or describe a meal
            to create a shopping list. Receipt extracts
            the requested items, matches them against
            the latest supermarket catalogue and
            prioritises products that fit the
            selected <strong>budget</strong>.
          </p>
        </article>

        <article class="feature-card">
          <span>02</span>

          <h3>
            Price intelligence
          </h3>

          <p>
            Cleaned product, discount and
            <strong>unit-price data</strong> from five
            major UK supermarkets allow users to compare
            similar products and explore how prices
            change over time.
          </p>
        </article>

        <article class="feature-card">
          <span>03</span>

          <h3>
            Category forecasting
          </h3>

          <p>
            Historical inflation data is transformed
            into <strong>time-series datasets</strong>
            and modelled with <strong>ARIMA</strong>
            to provide an exploratory view of potential
            short-term category-level price movement.
          </p>
        </article>

        <article class="feature-card">
          <span>04</span>

          <h3>
            Nearby store finder
          </h3>

          <p>
            Users can enter a postcode or share their
            location to find nearby supermarkets.
            <strong>Geodesic distance</strong>
            calculations rank the results before they
            are displayed on an interactive
            <strong>Folium map</strong>.
          </p>
        </article>

        <article class="feature-card">
          <span>05</span>

          <h3>
            Semantic product matching
          </h3>

          <p>
            <strong>Sentence Transformer embeddings</strong>
            and cosine similarity connect informal
            shopping requests to real product names.
            Cached embeddings and batched comparisons
            support matching across large product
            catalogues.
          </p>
        </article>

        <article class="feature-card">
          <span>06</span>

          <h3>
            Natural language assistance
          </h3>

          <p>
            An <strong>LLM</strong> accessed through the
            <strong>Groq API</strong> allows users to
            describe a meal or request grocery
            suggestions naturally before converting
            the response into a structured shopping list.
          </p>
        </article>

      </div>
    </section>

    <!-- =========================
         END
         ========================= -->

    <section class="project-ending">
      <p class="ending-label">
        Built as my final year
        Artificial Intelligence project.
      </p>

      <h2>
        Messy data in.<br />
        Smarter baskets out.
      </h2>

      <p class="ending-supporting">
        Designed, engineered and deployed
        from data collection to user experience.
      </p>

      <p class="case-study-note">
        Full case study, including technical decisions
        and testing, available upon request.
      </p>

      <div class="project-ending-links">
        <a
          href="https://receipt-entwan.streamlit.app/"
          target="_blank"
          rel="noreferrer"
        >
          OPEN LIVE PROJECT ↗
        </a>

        <a
          href="https://github.com/Enkhamgalan1230/Reciept-Project"
          target="_blank"
          rel="noreferrer"
        >
          GITHUB ↗
        </a>
      </div>
    </section>

  </article>
</ProjectModal>

<style>
  .receipt-project {
    width: 100%;

    background:
      radial-gradient(
        circle at 8% 8%,
        #E5D5D2 0%,
        transparent 34%
      ),
      radial-gradient(
        circle at 94% 18%,
        #93788F 0%,
        transparent 32%
      ),
      radial-gradient(
        circle at 72% 74%,
        #B398A8 0%,
        transparent 38%
      ),
      radial-gradient(
        circle at 18% 88%,
        #745973 0%,
        transparent 30%
      ),
      linear-gradient(
        135deg,
        #D6C3C7 0%,
        #C7B1BA 48%,
        #D6C3C7 100%
      );

    color: #111111;
  }

  .receipt-project strong {
    font-weight: 700;
    color: #111111;
  }

  /* =========================
     HERO
     ========================= */

  .project-hero {
    position: relative;

    min-height: 88vh;

    display: flex;
    flex-direction: column;
    justify-content: flex-end;

    padding: 70px 70px 64px;
  }

  .project-hero-top {
    position: absolute;

    top: 28px;
    left: 70px;
    right: 90px;

    display: flex;
    justify-content: space-between;

    font-family:
      "Courier Prime",
      monospace;

    font-size: 0.74rem;

    letter-spacing: 0.06em;

    color: #777777;
  }

  .project-hero h1 {
    margin: 0;

    font-family:
      "Instrument Serif",
      serif;

    font-size:
      clamp(
        6rem,
        15vw,
        13rem
      );

    font-weight: 400;

    line-height: 0.78;

    letter-spacing: -0.05em;
  }

  .project-tagline {
    max-width: 800px;

    margin:
      42px 0 20px;

    font-family:
      "Instrument Serif",
      serif;

    font-size:
      clamp(
        2rem,
        3.4vw,
        3.6rem
      );

    line-height: 0.98;
  }

  .project-supporting {
    max-width: 720px;

    margin: 0;

    font-family:
      "Courier Prime",
      monospace;

    font-size: 1rem;

    line-height: 1.6;

    color: #686868;
  }

  /* =========================
     TECH STACK
     ========================= */

  .project-meta {
    display: flex;
    flex-wrap: wrap;

    gap: 9px;

    max-width: 950px;

    margin-top: 28px;
  }

  .project-meta span {
    padding:
      10px 14px;

    border:
      1px solid
      rgba(
        17,
        17,
        17,
        0.18
      );

    border-radius: 999px;

    background:
      rgba(
        255,
        255,
        255,
        0.28
      );

    font-family:
      "Courier Prime",
      monospace;

    font-size: 0.72rem;

    font-weight: 400;

    letter-spacing: 0.025em;

    color: #333333;

    transition:
      border-color 0.2s ease,
      background 0.2s ease,
      transform 0.2s ease;
  }

  .project-meta span:hover {
    border-color:
      rgba(
        77,
        118,
        87,
        0.5
      );

    background:
      rgba(
        77,
        118,
        87,
        0.08
      );

    transform:
      translateY(-2px);
  }

  /* =========================
     ACTIONS
     ========================= */

  .project-actions {
    display: flex;
    flex-wrap: wrap;

    gap: 12px;

    margin-top: 34px;
  }

  .project-actions a,
  .project-ending-links a {
    padding:
      13px 17px;

    border:
      1px solid
      rgba(
        17,
        17,
        17,
        0.22
      );

    border-radius: 999px;

    font-family:
      "Courier Prime",
      monospace;

    font-size: 0.82rem;

    transition:
      background 0.2s ease,
      color 0.2s ease,
      border-color 0.2s ease;
  }

  .project-actions a:hover,
  .project-ending-links a:hover {
    background: #4d7657;

    border-color: #4d7657;

    color: #ffffff;
  }

  /* =========================
     DEMO
     ========================= */

  .demo-section {
    padding:
      0 70px 110px;
  }

  .demo-placeholder {
    aspect-ratio: 16 / 9;

    display: flex;

    align-items: center;
    justify-content: center;

    overflow: hidden;

    border-radius: 22px;

    background:
      linear-gradient(
        145deg,
        #E5D5D2,
        #D6C3C7
      );
  }

  .demo-placeholder > div {
    text-align: center;
  }

  .demo-label {
    font-family:
      "Courier Prime",
      monospace;

    font-size: 0.74rem;

    letter-spacing: 0.08em;
  }

  .demo-placeholder p {
    margin:
      14px 0;

    font-family:
      "Instrument Serif",
      serif;

    font-size:
      clamp(
        2.5rem,
        6vw,
        6rem
      );

    line-height: 0.9;
  }

  .demo-play {
    font-size: 1.5rem;
  }

  /* =========================
     INTRO
     ========================= */

  .intro-grid {
    display: grid;

    grid-template-columns:
      1fr 1fr;

    gap: 70px;

    padding:
      20px 70px 130px;
  }

  .intro-block {
    padding-top: 20px;

    border-top:
      1px solid
      rgba(
        17,
        17,
        17,
        0.18
      );
  }

  .section-number {
    font-family:
      "Courier Prime",
      monospace;

    font-size: 0.74rem;

    color: #777777;
  }

  .intro-block h2,
  .section-heading h2,
  .decision-section h2,
  .project-ending h2 {
    font-family:
      "Instrument Serif",
      serif;

    font-weight: 400;

    letter-spacing: -0.025em;
  }

  .intro-block h2 {
    margin:
      20px 0;

    font-size:
      clamp(
        2.7rem,
        4vw,
        4.6rem
      );

    line-height: 0.95;
  }

  .intro-block p {
    max-width: 640px;

    margin: 0;

    font-family:
      "Courier Prime",
      monospace;

    font-size: 1rem;

    line-height: 1.65;

    color: #5f5f5f;
  }

  /* =========================
     SECTION HEADINGS
     ========================= */

  .section-heading {
    margin-bottom: 54px;
  }

  .section-heading > span,
  .decision-label {
    font-family:
      "Courier Prime",
      monospace;

    font-size: 0.74rem;

    letter-spacing: 0.08em;

    color: #777777;
  }

  .section-heading h2 {
    max-width: 900px;

    margin:
      14px 0 0;

    font-size:
      clamp(
        3.4rem,
        6vw,
        7rem
      );

    line-height: 0.9;
  }

  /* =========================
     ARCHITECTURE
     ========================= */

  .architecture-section {
    padding:
      110px 70px;

    background:
      linear-gradient(
        135deg,
        #403640 0%,
        #594957 52%,
        #745973 100%
      );

    color: #F7F0F0;
  }

  .architecture-section
    .section-heading > span {
    color: #D6C3C7;
  }

  .architecture-flow {
    display: grid;

    grid-template-columns:
      repeat(
        11,
        auto
      );

    align-items: center;

    gap: 14px;
  }

  .architecture-node {
    min-height: 180px;

    display: flex;

    flex-direction: column;

    justify-content:
      space-between;

    gap: 18px;

    padding: 20px;

    border:
      1px solid
      rgba(
        255,
        255,
        255,
        0.18
      );

    border-radius: 14px;
  }

  .architecture-node span,
  .architecture-node small {
    font-family:
      "Courier Prime",
      monospace;
  }

  .architecture-node span {
    font-size: 0.7rem;

    color: #999999;
  }

  .architecture-node strong {
    font-family:
      "Instrument Serif",
      serif;

    font-size: 1.65rem;

    font-weight: 400;

    line-height: 1;

    color: #f5f4f1;
  }

  .architecture-node small {
    max-width: 155px;

    font-size: 0.78rem;

    line-height: 1.45;

    color: #aaaaaa;
  }

  .architecture-arrow {
    font-family:
      "Courier Prime",
      monospace;

    font-size: 1rem;

    color: #D6C3C7;
  }

  /* =========================
     RESPONSIVE ARCHITECTURE
     ========================= */

  @media (
    min-width: 641px
  ) and (
    max-width: 1150px
  ) {
    .architecture-flow {
      grid-template-columns:
        repeat(3, 1fr);

      gap: 18px;
    }

    .architecture-arrow {
      display: none;
    }

    .architecture-node {
      min-height: 170px;
    }

    .architecture-node small {
      max-width: none;
    }
  }

  /* =========================
     SCRAPING DETAIL
     ========================= */

  .scraping-detail {
    display: grid;

    grid-template-columns:
      0.8fr 1.4fr;

    gap: 60px;

    align-items: center;

    margin-top: 100px;

    padding-top: 80px;

    border-top:
      1px solid
      rgba(
        255,
        255,
        255,
        0.16
      );
  }

  .scraping-detail-text span {
    font-family:
      "Courier Prime",
      monospace;

    font-size: 0.74rem;

    letter-spacing: 0.08em;

    color: #8d8d8d;
  }

  .scraping-detail-text h3 {
    margin:
      16px 0 24px;

    font-family:
      "Instrument Serif",
      serif;

    font-size:
      clamp(
        2.5rem,
        4vw,
        4.5rem
      );

    font-weight: 400;

    line-height: 0.93;
  }

  .scraping-detail-text p {
    margin: 0;

    font-family:
      "Courier Prime",
      monospace;

    font-size: 0.95rem;

    line-height: 1.65;

    color: #b3b3b3;
  }

  .scraping-detail-text strong {
    color: #ffffff;
  }

  .scraping-detail-image {
    overflow: hidden;

    padding: 20px;

    border:
      1px solid
      rgba(
        255,
        255,
        255,
        0.16
      );

    border-radius: 16px;

    background: #E5D5D2;
  }

  /* =========================
     IMAGE HOVER
     ========================= */

  .visual-hover {
    overflow: hidden;
  }

  .visual-hover img {
    display: block;

    width: 100%;
    height: auto;

    transition:
      transform
      0.5s
      cubic-bezier(
        0.22,
        1,
        0.36,
        1
      );
  }

  .visual-hover:hover img {
    transform:
      scale(1.045);
  }

  /* =========================
     FEATURES
     ========================= */

  .features-section {
    padding:
      130px 70px;

    background: rgba(247, 246, 244, 0.42);
  }

  .feature-grid {
    display: grid;

    grid-template-columns:
      repeat(
        2,
        1fr
      );

    gap: 18px;
  }

  .feature-card {
    min-height: 330px;

    display: flex;
    flex-direction: column;

    padding: 27px;

    border:
      1px solid
      rgba(
        17,
        17,
        17,
        0.16
      );

    border-radius: 18px;

    background: rgba(247, 246, 244, 0.72);

    transition:
      transform 0.25s ease,
      border-color 0.25s ease;
  }

  .feature-card:hover {
    transform:
      translateY(-4px);

    border-color:
      rgba(
        77,
        118,
        87,
        0.45
      );
  }

  .feature-card > span {
    font-family:
      "Courier Prime",
      monospace;

    font-size: 0.72rem;

    color: #777777;
  }

  .feature-card h3 {
    margin:
      auto 0 20px;

    font-family:
      "Instrument Serif",
      serif;

    font-size:
      clamp(
        2rem,
        3vw,
        3.7rem
      );

    font-weight: 400;

    line-height: 0.95;
  }

  .feature-card p {
    max-width: 560px;

    margin: 0;

    font-family:
      "Courier Prime",
      monospace;

    font-size: 0.95rem;

    line-height: 1.6;

    color: #626262;
  }

  /* =========================
     DATA EXPLORATION
     ========================= */

  .data-exploration {
    padding:
      130px 70px;
  }

  .exploration-grid {
    display: grid;

    grid-template-columns:
      1.35fr 1fr;

    gap: 22px;

    align-items: start;
  }

  .exploration-item {
    margin: 0;
  }

  .exploration-image {
    border:
      1px solid
      rgba(
        17,
        17,
        17,
        0.12
      );

    border-radius: 16px;
  }

  .exploration-image img {
    border-radius: inherit;
  }

  .exploration-item figcaption {
    margin-top: 13px;

    font-family:
      "Courier Prime",
      monospace;

    font-size: 0.78rem;

    line-height: 1.5;

    color: #777777;
  }

  /* =========================
     DECISION
     ========================= */

  .decision-section {
    display: grid;

    grid-template-columns:
      120px 1fr;

    gap: 40px;

    padding:
      130px 70px;

    background: #d9e2da;
  }

  .decision-section h2 {
    max-width: 900px;

    margin:
      18px 0 28px;

    font-size:
      clamp(
        3.5rem,
        7vw,
        7.5rem
      );

    line-height: 0.88;
  }

  .decision-section > div > p:not(
    .decision-label,
    .testing-note
  ) {
    max-width: 720px;

    margin: 0;

    font-family:
      "Courier Prime",
      monospace;

    font-size: 1rem;

    line-height: 1.65;

    color: #555f57;
  }

  .testing-note {
    max-width: 720px;

    margin:
      28px 0 0;

    padding-top: 20px;

    border-top:
