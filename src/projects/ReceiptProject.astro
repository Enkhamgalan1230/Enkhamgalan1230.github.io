---
import ProjectModal from "../components/ProjectModal.astro";
---

<ProjectModal
  id="receipt-project"
  ariaLabel="Receipt project"
>
  <article class="receipt-project">

    <!-- =========================
         HERO
         ========================= -->

    <section class="project-hero">
      <div class="project-hero-top">
        <span>01 / SELECTED WORK</span>
        <span>2024 → 2025</span>
      </div>

      <div class="receipt-logo-wrap">
        <img
          src="/images/projects/receipt-pics/receipt-logo.jpg"
          alt="Receipt project logo"
        />
      </div>

      <h1>Receipt</h1>

      <p class="project-tagline">
        AI-driven grocery budgeting,
        price comparison and smart shopping.
      </p>

      <div class="project-meta">
        <span>PYTHON</span>
        <span>STREAMLIT</span>
        <span>SUPABASE</span>
        <span>SELENIUM</span>
        <span>NLP</span>
        <span>ARIMA</span>
        <span>LLM</span>
      </div>

      <div class="project-actions">
        <a
          href="https://receipt-entwan.streamlit.app/"
          target="_blank"
          rel="noreferrer"
        >
          TRY RECEIPT ↗
        </a>

        <a
          href="https://github.com/Enkhamgalan1230/Reciept-Project"
          target="_blank"
          rel="noreferrer"
        >
          VIEW CODE ↗
        </a>
      </div>
    </section>

    <!-- =========================
         VIDEO
         ========================= -->

    <section class="demo-section">
      <div class="demo-placeholder">
        <div>
          <span class="demo-label">
            PROJECT DEMO
          </span>

          <p>
            VIDEO COMING SOON
          </p>

          <span class="demo-play">
            ▶
          </span>
        </div>
      </div>
    </section>

    <!-- =========================
         PROBLEM / SOLUTION
         ========================= -->

    <section class="intro-grid">
      <div class="intro-block">
        <span class="section-number">
          01
        </span>

        <h2>
          The problem.
        </h2>

        <p>
          Grocery prices change constantly,
          while budgeting tools, price
          comparison platforms and forecasting
          systems often exist separately.
          Receipt brings those jobs together
          into one student-focused platform.
        </p>
      </div>

      <div class="intro-block">
        <span class="section-number">
          02
        </span>

        <h2>
          What I built.
        </h2>

        <p>
          A data-driven application that
          collects supermarket pricing,
          standardises the data, compares
          products, tracks price changes,
          forecasts trends and generates
          personalised shopping lists.
        </p>
      </div>
    </section>

    <!-- =========================
         DATA PIPELINE VISUAL
         ========================= -->

    <section class="pipeline-visual">
      <div class="pipeline-heading">
        <span>
          DATA FLOW
        </span>

        <p>
          Scrape → clean → store → fetch →
          cache → use.
        </p>
      </div>

      <div class="pipeline-image">
        <img
          src="/images/projects/receipt-pics/receipt-data-pipeline.jpg"
          alt="Receipt data processing pipeline"
        />
      </div>
    </section>

    <!-- =========================
         ARCHITECTURE
         ========================= -->

    <section class="architecture-section">
      <div class="section-heading">
        <span>
          UNDER THE HOOD
        </span>

        <h2>
          From supermarket shelf
          to useful decision.
        </h2>
      </div>

      <div class="architecture-flow">
        <div class="architecture-node">
          <span>01</span>

          <strong>
            Supermarkets
          </strong>

          <small>
            Tesco, Sainsbury's,
            Asda, Aldi, Waitrose
          </small>
        </div>

        <div class="architecture-arrow">
          ↓
        </div>

        <div class="architecture-node">
          <span>02</span>

          <strong>
            Selenium
          </strong>

          <small>
            Product collection
          </small>
        </div>

        <div class="architecture-arrow">
          ↓
        </div>

        <div class="architecture-node">
          <span>03</span>

          <strong>
            Cleaning
          </strong>

          <small>
            Names, prices,
            units and categories
          </small>
        </div>

        <div class="architecture-arrow">
          ↓
        </div>

        <div class="architecture-node">
          <span>04</span>

          <strong>
            Supabase
          </strong>

          <small>
            PostgreSQL storage
          </small>
        </div>

        <div class="architecture-arrow">
          ↓
        </div>

        <div class="architecture-node">
          <span>05</span>

          <strong>
            Intelligence
          </strong>

          <small>
            NLP, matching,
            forecasting and AI
          </small>
        </div>

        <div class="architecture-arrow">
          ↓
        </div>

        <div class="architecture-node">
          <span>06</span>

          <strong>
            Streamlit
          </strong>

          <small>
            User experience
          </small>
        </div>
      </div>

      <!-- =========================
           SCRAPING DETAIL
           ========================= -->

      <div class="scraping-detail">
        <div class="scraping-detail-text">
          <span>
            DATA COLLECTION
          </span>

          <h3>
            Getting the data was a project
            of its own.
          </h3>

          <p>
            Each supermarket had different
            page structures, pagination and
            dynamically loaded products.
            Selenium was used to navigate
            categories, extract product
            details and continue until the
            available data had been collected.
          </p>
        </div>

        <div class="scraping-detail-image">
          <img
            src="/images/projects/receipt-pics/receipt-scraping-pipeline.jpg"
            alt="Receipt Selenium scraping workflow"
          />
        </div>
      </div>
    </section>

    <!-- =========================
         FEATURES
         ========================= -->

    <section class="features-section">
      <div class="section-heading">
        <span>
          SOME COOL TINGS
        </span>

        <h2>
          What Receipt actually does.
        </h2>
      </div>

      <div class="feature-grid">
        <article class="feature-card">
          <span>
            01
          </span>

          <h3>
            Smart shopping lists
          </h3>

          <p>
            Build a list by typing,
            speaking or asking an AI
            assistant. NLP extracts
            grocery items and semantic
            matching connects them to
            real supermarket products.
          </p>
        </article>

        <article class="feature-card">
          <span>
            02
          </span>

          <h3>
            Price intelligence
          </h3>

          <p>
            Compare products across five
            UK supermarkets using cleaned
            and standardised pricing,
            discount and unit-cost data.
          </p>
        </article>

        <article class="feature-card">
          <span>
            03
          </span>

          <h3>
            Forecasting
          </h3>

          <p>
            Historical price and inflation
            data are processed into
            category-level time series
            and forecast using ARIMA.
          </p>
        </article>

        <article class="feature-card">
          <span>
            04
          </span>

          <h3>
            Store finder
          </h3>

          <p>
            Use a postcode or current
            location to find nearby
            supermarkets, calculate
            distance and display the
            results on an interactive map.
          </p>
        </article>
      </div>
    </section>

    <!-- =========================
         DATA EXPLORATION
         ========================= -->

    <section class="data-exploration">
      <div class="section-heading">
        <span>
          DATA EXPLORATION
        </span>

        <h2>
          Before making predictions,
          I had to understand the data.
        </h2>
      </div>

      <div class="exploration-grid">
        <figure class="exploration-item">
          <img
            src="/images/projects/receipt-pics/receipt-product-wordcloud.jpg"
            alt="Word cloud generated from supermarket product names"
          />

          <figcaption>
            Product-name exploration across
            the collected supermarket data.
          </figcaption>
        </figure>

        <figure class="exploration-item">
          <img
            src="/images/projects/receipt-pics/receipt-average-price-by-store.jpg"
            alt="Average supermarket price comparison chart"
          />

          <figcaption>
            Comparing average prices across
            the five supermarket datasets.
          </figcaption>
        </figure>
      </div>
    </section>

    <!-- =========================
         DECISION
         ========================= -->

    <section class="decision-section">
      <span class="section-number">
        03
      </span>

      <div>
        <p class="decision-label">
          A DECISION I MADE
        </p>

        <h2>
          More complicated
          doesn't always mean better.
        </h2>

        <p>
          I explored more complex
          forecasting approaches including
          LSTM and XGBoost, but the available
          historical data did not justify
          higher-capacity models. ARIMA was
          a better fit for the data available
          at the time.
        </p>
      </div>
    </section>

    <!-- =========================
         END
         ========================= -->

    <section class="project-ending">
      <p>
        Built as my final year
        Artificial Intelligence project.
      </p>

      <h2>
        Data collected.<br />
        Prices compared.<br />
        Budget saved.<br />
        Hopefully.
      </h2>

      <div class="project-ending-links">
        <a
          href="https://receipt-entwan.streamlit.app/"
          target="_blank"
          rel="noreferrer"
        >
          OPEN LIVE PROJECT ↗
        </a>

        <a
          href="https://github.com/Enkhamgalan1230/Reciept-Project"
          target="_blank"
          rel="noreferrer"
        >
          GITHUB ↗
        </a>
      </div>
    </section>

  </article>
</ProjectModal>

<style>
  .receipt-project {
    width: 100%;
    color: #111111;
  }

  /* =========================
     HERO
     ========================= */

  .project-hero {
    position: relative;

    min-height: 88vh;

    display: flex;
    flex-direction: column;
    justify-content: flex-end;

    padding: 70px 70px 64px;
  }

  .project-hero-top {
    position: absolute;

    top: 28px;
    left: 70px;
    right: 90px;

    display: flex;
    justify-content: space-between;

    font-family: "Courier Prime", monospace;
    font-size: 0.68rem;

    letter-spacing: 0.06em;

    color: #777777;
  }

  .receipt-logo-wrap {
    width: 110px;
    height: 110px;

    margin-bottom: 30px;

    overflow: hidden;

    border-radius: 50%;
  }

  .receipt-logo-wrap img {
    display: block;

    width: 100%;
    height: 100%;

    object-fit: cover;
  }

  .project-hero h1 {
    margin: 0;

    font-family: "Instrument Serif", serif;
    font-size: clamp(6rem, 15vw, 13rem);

    font-weight: 400;

    line-height: 0.78;
    letter-spacing: -0.05em;
  }

  .project-tagline {
    max-width: 760px;

    margin: 44px 0 28px;

    font-family: "Instrument Serif", serif;
    font-size: clamp(2rem, 4vw, 4.5rem);

    line-height: 0.98;
  }

  .project-meta {
    display: flex;
    flex-wrap: wrap;

    gap: 8px;

    margin-top: 8px;
  }

  .project-meta span {
    padding: 7px 10px;

    border: 1px solid rgba(17, 17, 17, 0.18);
    border-radius: 999px;

    font-family: "Courier Prime", monospace;
    font-size: 0.62rem;
  }

  .project-actions {
    display: flex;
    flex-wrap: wrap;

    gap: 12px;

    margin-top: 34px;
  }

  .project-actions a,
  .project-ending-links a {
    padding: 12px 16px;

    border: 1px solid rgba(17, 17, 17, 0.22);
    border-radius: 999px;

    font-family: "Courier Prime", monospace;
    font-size: 0.7rem;

    transition:
      background 0.2s ease,
      color 0.2s ease,
      border-color 0.2s ease;
  }

  .project-actions a:hover,
  .project-ending-links a:hover {
    background: #4d7657;
    border-color: #4d7657;

    color: #ffffff;
  }

  /* =========================
     DEMO
     ========================= */

  .demo-section {
    padding: 0 70px 110px;
  }

  .demo-placeholder {
    aspect-ratio: 16 / 9;

    display: flex;
    align-items: center;
    justify-content: center;

    overflow: hidden;

    border-radius: 22px;

    background:
      linear-gradient(
        145deg,
        #d6ded7,
        #a9bbaa
      );
  }

  .demo-placeholder > div {
    text-align: center;
  }

  .demo-label {
    font-family: "Courier Prime", monospace;
    font-size: 0.66rem;

    letter-spacing: 0.08em;
  }

  .demo-placeholder p {
    margin: 14px 0;

    font-family: "Instrument Serif", serif;
    font-size: clamp(2.5rem, 6vw, 6rem);

    line-height: 0.9;
  }

  .demo-play {
    font-size: 1.5rem;
  }

  /* =========================
     INTRO
     ========================= */

  .intro-grid {
    display: grid;

    grid-template-columns: 1fr 1fr;

    gap: 60px;

    padding: 20px 70px 130px;
  }

  .intro-block {
    padding-top: 20px;

    border-top: 1px solid rgba(17, 17, 17, 0.18);
  }

  .section-number {
    font-family: "Courier Prime", monospace;
    font-size: 0.66rem;

    color: #777777;
  }

  .intro-block h2,
  .section-heading h2,
  .decision-section h2,
  .project-ending h2 {
    font-family: "Instrument Serif", serif;

    font-weight: 400;

    letter-spacing: -0.025em;
  }

  .intro-block h2 {
    margin: 20px 0;

    font-size: clamp(2.7rem, 4vw, 4.6rem);

    line-height: 0.95;
  }

  .intro-block p,
  .decision-section p {
    max-width: 600px;

    font-family: "Courier Prime", monospace;
    font-size: 0.86rem;

    line-height: 1.6;

    color: #646464;
  }

  /* =========================
     PIPELINE VISUAL
     ========================= */

  .pipeline-visual {
    padding: 0 70px 130px;
  }

  .pipeline-heading {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;

    gap: 30px;

    margin-bottom: 24px;
  }

  .pipeline-heading span {
    font-family: "Courier Prime", monospace;
    font-size: 0.68rem;

    letter-spacing: 0.08em;

    color: #777777;
  }

  .pipeline-heading p {
    max-width: 500px;

    margin: 0;

    font-family: "Instrument Serif", serif;
    font-size: 1.8rem;

    line-height: 1;

    text-align: right;
  }

  .pipeline-image {
    overflow: hidden;

    padding: 30px;

    border: 1px solid rgba(17, 17, 17, 0.14);
    border-radius: 18px;

    background: #ffffff;
  }

  .pipeline-image img {
    display: block;

    width: 100%;
    height: auto;
  }

  /* =========================
     SECTION HEADINGS
     ========================= */

  .section-heading {
    margin-bottom: 54px;
  }

  .section-heading > span,
  .decision-label {
    font-family: "Courier Prime", monospace;
    font-size: 0.68rem;

    letter-spacing: 0.08em;

    color: #777777;
  }

  .section-heading h2 {
    max-width: 900px;

    margin: 14px 0 0;

    font-size: clamp(3.4rem, 6vw, 7rem);

    line-height: 0.9;
  }

  /* =========================
     ARCHITECTURE
     ========================= */

  .architecture-section {
    padding: 110px 70px;

    background: #111111;

    color: #f5f4f1;
  }

  .architecture-section
    .section-heading > span {
    color: #8a8a8a;
  }

  .architecture-flow {
    display: grid;

    grid-template-columns: repeat(11, auto);

    align-items: center;

    gap: 14px;
  }

  .architecture-node {
    min-height: 155px;

    display: flex;
    flex-direction: column;
    justify-content: space-between;

    gap: 18px;

    padding: 18px;

    border: 1px solid rgba(255, 255, 255, 0.18);
    border-radius: 14px;
  }

  .architecture-node span,
  .architecture-node small {
    font-family: "Courier Prime", monospace;
  }

  .architecture-node span {
    font-size: 0.62rem;

    color: #999999;
  }

  .architecture-node strong {
    font-family: "Instrument Serif", serif;
    font-size: 1.6rem;

    font-weight: 400;
  }

  .architecture-node small {
    max-width: 135px;

    font-size: 0.64rem;
    line-height: 1.35;

    color: #a8a8a8;
  }

  .architecture-arrow {
    font-family: "Courier Prime", monospace;

    color: #4d7657;
  }

  /* =========================
     SCRAPING DETAIL
     ========================= */

  .scraping-detail {
    display: grid;

    grid-template-columns: 0.8fr 1.4fr;

    gap: 60px;

    align-items: center;

    margin-top: 100px;
    padding-top: 80px;

    border-top: 1px solid rgba(255, 255, 255, 0.16);
  }

  .scraping-detail-text span {
    font-family: "Courier Prime", monospace;
    font-size: 0.64rem;

    letter-spacing: 0.08em;

    color: #8d8d8d;
  }

  .scraping-detail-text h3 {
    margin: 16px 0 24px;

    font-family: "Instrument Serif", serif;
    font-size: clamp(2.5rem, 4vw, 4.5rem);

    font-weight: 400;

    line-height: 0.93;
  }

  .scraping-detail-text p {
    margin: 0;

    font-family: "Courier Prime", monospace;
    font-size: 0.76rem;

    line-height: 1.6;

    color: #aaaaaa;
  }

  .scraping-detail-image {
    overflow: hidden;

    padding: 20px;

    border: 1px solid rgba(255, 255, 255, 0.16);
    border-radius: 16px;

    background: #ffffff;
  }

  .scraping-detail-image img {
    display: block;

    width: 100%;
    height: auto;
  }

  /* =========================
     FEATURES
     ========================= */

  .features-section {
    padding: 130px 70px;
  }

  .feature-grid {
    display: grid;

    grid-template-columns: repeat(2, 1fr);

    gap: 18px;
  }

  .feature-card {
    min-height: 300px;

    display: flex;
    flex-direction: column;

    padding: 24px;

    border: 1px solid rgba(17, 17, 17, 0.16);
    border-radius: 18px;
  }

  .feature-card > span {
    font-family: "Courier Prime", monospace;
    font-size: 0.64rem;

    color: #777777;
  }

  .feature-card h3 {
    margin: auto 0 18px;

    font-family: "Instrument Serif", serif;
    font-size: clamp(2rem, 3vw, 3.7rem);

    font-weight: 400;

    line-height: 0.95;
  }

  .feature-card p {
    max-width: 500px;

    margin: 0;

    font-family: "Courier Prime", monospace;
    font-size: 0.78rem;

    line-height: 1.55;

    color: #666666;
  }

  /* =========================
     DATA EXPLORATION
     ========================= */

  .data-exploration {
    padding: 130px 70px;
  }

  .exploration-grid {
    display: grid;

    grid-template-columns: 1.35fr 1fr;

    gap: 22px;

    align-items: start;
  }

  .exploration-item {
    margin: 0;
  }

  .exploration-item img {
    display: block;

    width: 100%;
    height: auto;

    border: 1px solid rgba(17, 17, 17, 0.12);
    border-radius: 16px;
  }

  .exploration-item figcaption {
    margin-top: 12px;

    font-family: "Courier Prime", monospace;
    font-size: 0.66rem;

    line-height: 1.4;

    color: #777777;
  }

  /* =========================
     DECISION
     ========================= */

  .decision-section {
    display: grid;

    grid-template-columns: 120px 1fr;

    gap: 40px;

    padding: 130px 70px;

    background: #d9e2da;
  }

  .decision-section h2 {
    max-width: 900px;

    margin: 18px 0 28px;

    font-size: clamp(3.5rem, 7vw, 7.5rem);

    line-height: 0.88;
  }

  /* =========================
     END
     ========================= */

  .project-ending {
    min-height: 80vh;

    display: flex;
    flex-direction: column;
    justify-content: center;

    padding: 120px 70px;
  }

  .project-ending > p {
    font-family: "Courier Prime", monospace;
    font-size: 0.7rem;

    color: #777777;
  }

  .project-ending h2 {
    max-width: 1000px;

    margin: 24px 0 46px;

    font-size: clamp(4rem, 8vw, 8rem);

    line-height: 0.84;
  }

  .project-ending-links {
    display: flex;
    flex-wrap: wrap;

    gap: 12px;
  }

  /* =========================
     MOBILE
     ========================= */

  @media (max-width: 640px) {
    .project-hero {
      min-height: 88dvh;

      padding: 90px 20px 36px;
    }

    .receipt-logo-wrap {
      width: 82px;
      height: 82px;

      margin-bottom: 24px;
    }

    .project-hero-top {
      top: 20px;
      left: 20px;
      right: 70px;

      font-size: 0.55rem;
    }

    .project-hero h1 {
      font-size: clamp(5rem, 26vw, 8rem);
    }

    .project-tagline {
      margin: 30px 0 22px;

      font-size: 2.3rem;
    }

    .project-meta {
      gap: 6px;
    }

    .project-meta span {
      padding: 6px 8px;

      font-size: 0.55rem;
    }

    .demo-section {
      padding: 0 16px 80px;
    }

    .demo-placeholder {
      aspect-ratio: 4 / 5;

      border-radius: 16px;
    }

    .intro-grid {
      grid-template-columns: 1fr;

      gap: 60px;

      padding: 20px 20px 90px;
    }

    .pipeline-visual {
      padding: 0 20px 90px;
    }

    .pipeline-heading {
      display: block;
    }

    .pipeline-heading p {
      margin-top: 10px;

      font-size: 1.5rem;

      text-align: left;
    }

    .pipeline-image {
      overflow-x: auto;

      padding: 12px;
    }

    .pipeline-image img {
      width: 850px;
      max-width: none;
    }

    .architecture-section,
    .features-section,
    .data-exploration,
    .decision-section,
    .project-ending {
      padding: 90px 20px;
    }

    .architecture-flow {
      grid-template-columns: 1fr;
    }

    .architecture-arrow {
      text-align: center;
    }

    .architecture-node {
      min-height: 130px;
    }

    .scraping-detail {
      grid-template-columns: 1fr;

      gap: 32px;

      margin-top: 70px;
      padding-top: 60px;
    }

    .scraping-detail-image {
      overflow-x: auto;

      padding: 10px;
    }

    .scraping-detail-image img {
      width: 900px;
      max-width: none;
    }

    .feature-grid {
      grid-template-columns: 1fr;
    }

    .feature-card {
      min-height: 260px;
    }

    .exploration-grid {
      grid-template-columns: 1fr;

      gap: 34px;
    }

    .decision-section {
      grid-template-columns: 1fr;

      gap: 30px;
    }

    .project-ending {
      min-height: 70dvh;
    }

    .project-ending h2 {
