  /* =========================
     PROJECT SECTION
     ========================= */

  .projects-section {
    display: none !important;
    position: relative;
    z-index: 2;
    isolation: isolate;
    min-height: 100vh;
    min-height: 100dvh;

    display: flex;
    align-items: center;
