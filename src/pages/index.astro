---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout title="Entwan's Portfolio">
  <section class="hero">
    <div class="hero-content">
      <p class="hero-intro">
        Data and problem <span class="hero-green">given.</span><br />
        I turn them into:
      </p>

      <div class="typewriter-wrapper">
        <span id="typewriter"></span>
        <span class="cursor" aria-hidden="true">|</span>
      </div>

      <div class="project-cards">
        <a class="project-card" href="/projects">
          <div class="project-card-image placeholder-one"></div>

          <div class="project-card-footer">
            <span>Project Alpha</span>
            <span>01</span>
          </div>
        </a>

        <a class="project-card" href="/projects">
          <div class="project-card-image placeholder-two"></div>

          <div class="project-card-footer">
            <span>Project Beta</span>
            <span>02</span>
          </div>
        </a>

        <a class="project-card" href="/projects">
          <div class="project-card-image placeholder-three"></div>

          <div class="project-card-footer">
            <span>Project Gamma</span>
            <span>03</span>
          </div>
        </a>

        <a class="project-card" href="/projects">
          <div class="project-card-image placeholder-four"></div>

          <div class="project-card-footer">
            <span>Project Delta</span>
            <span>04</span>
          </div>
        </a>

        <a class="project-card" href="/projects">
          <div class="project-card-image placeholder-five"></div>

          <div class="project-card-footer">
            <span>Project Echo</span>
            <span>05</span>
          </div>
        </a>
      </div>
    </div>

    <a class="scroll-cue" href="/projects">
      <span>EXPLORE ALL PROJECTS</span>
      <span class="scroll-arrow">↗</span>
    </a>
  </section>
</BaseLayout>

<script>
  const words = [
    "Automation",
    "Predictions",
    "Efficiency",
    "“Yeahh, that makes sense” moments",
    "CooooOol AI tings",
  ];

  const element =
    document.querySelector<HTMLElement>("#typewriter");

  const typingSpeed = 85;
  const deletingSpeed = 25;
  const finishedPause = 1000;
  const emptyPause = 500;

  const wait = (time: number) =>
    new Promise<void>((resolve) =>
      setTimeout(resolve, time)
    );

  async function typeWord(word: string) {
    if (!element) return;

    for (let i = 1; i <= word.length; i++) {
      element.textContent = word.slice(0, i);
      await wait(typingSpeed);
    }
  }

  async function deleteWord(word: string) {
    if (!element) return;

    for (let i = word.length; i >= 0; i--) {
      element.textContent = word.slice(0, i);
      await wait(deletingSpeed);
    }
  }

  async function startTypewriter() {
    if (!element) return;

    while (true) {
      for (const word of words) {
        await typeWord(word);
        await wait(finishedPause);
        await deleteWord(word);
        await wait(emptyPause);
      }
    }
  }

  startTypewriter();
</script>

<style>
  .hero {
    flex: 1;

    position: relative;

    display: flex;
    align-items: center;
    justify-content: center;

    width: 100%;

    padding: 40px 24px 110px;

    overflow: hidden;
  }

  .hero-content {
    position: relative;
    z-index: 1;

    width: min(1180px, 100%);

    text-align: left;
  }

  .hero-green {
    color: #4d7657;
  }

  .hero-intro {
    width: min(680px, 100%);

    margin: 0 auto;

    font-family: "Instrument Serif", serif;
    font-size: clamp(2.1rem, 4vw, 4.2rem);

    font-weight: 400;

    line-height: 0.98;
    letter-spacing: -0.025em;

    color: #111111;
  }

  .typewriter-wrapper {
    width: min(680px, 100%);

    min-height: 2em;

    margin: 8px auto 0;

    font-family: "Instrument Serif", serif;
    font-size: clamp(2.3rem, 4.2vw, 4.4rem);

    font-style: italic;
    font-weight: 400;

    line-height: 0.95;

    color: #4d7657;
  }

  .cursor {
    display: inline-block;

    margin-left: 2px;

    font-style: normal;

    animation: blink 0.8s steps(1) infinite;
  }

  /* =========================
     PROJECT CARDS
     ========================= */

  .project-cards {
    width: 100%;

    margin-top: 52px;

    display: grid;
    grid-template-columns: repeat(5, minmax(0, 1fr));

    gap: 22px;

    align-items: center;
  }

  .project-card {
    position: relative;

    display: flex;
    flex-direction: column;

    aspect-ratio: 0.72;

    overflow: hidden;

    background: #f6f5f2;

    border: 1px solid rgba(17, 17, 17, 0.18);
    border-radius: 14px;

    box-shadow:
      0 14px 28px rgba(17, 17, 17, 0.06);

    transition:
      transform 0.28s ease,
      box-shadow 0.28s ease,
      border-color 0.28s ease;
  }

  .project-card:nth-child(1) {
    transform: translateY(8px) rotate(-1.5deg);
  }

  .project-card:nth-child(2) {
    transform: translateY(-4px) rotate(0.8deg);
  }

  .project-card:nth-child(3) {
    transform: translateY(6px) rotate(-0.4deg);
  }

  .project-card:nth-child(4) {
    transform: translateY(-6px) rotate(1deg);
  }

  .project-card:nth-child(5) {
    transform: translateY(7px) rotate(-0.8deg);
  }

  .project-card:hover {
    transform: translateY(-12px) rotate(0deg) scale(1.025);

    border-color: rgba(77, 118, 87, 0.45);

    box-shadow:
      0 22px 42px rgba(17, 17, 17, 0.1);
  }

  .project-card-image {
    flex: 1;

    min-height: 0;
  }

  /*
    Temporary placeholder backgrounds.
    Later we can replace each one with images or videos.
  */

  .placeholder-one {
    background:
      linear-gradient(
        145deg,
        #d8e1d8,
        #aebdaf
      );
  }

  .placeholder-two {
    background:
      linear-gradient(
        145deg,
        #dedbd1,
        #c8bea6
      );
  }

  .placeholder-three {
    background:
      linear-gradient(
        145deg,
        #d9d5df,
        #b9adca
      );
  }

  .placeholder-four {
    background:
      linear-gradient(
        145deg,
        #d7dfdf,
        #aabbbb
      );
  }

  .placeholder-five {
    background:
      linear-gradient(
        145deg,
        #dfd6cf,
        #c5afa0
      );
  }

  .project-card-footer {
    display: flex;
    align-items: center;
    justify-content: space-between;

    gap: 12px;

    padding: 14px 16px;

    background: #f6f5f2;

    font-family: "Courier Prime", monospace;
    font-size: 0.72rem;

    color: #111111;
  }

  /* =========================
     EXPLORE BUTTON
     ========================= */

  .scroll-cue {
    position: absolute;

    left: 50%;
    bottom: 28px;

    transform: translateX(-50%);

    display: inline-flex;
    align-items: center;

    gap: 8px;

    padding: 8px 13px;

    border: 1px solid rgba(17, 17, 17, 0.22);
    border-radius: 999px;

    background: rgba(237, 236, 234, 0.7);

    backdrop-filter: blur(8px);
    -webkit-backdrop-filter: blur(8px);

    font-family: "Courier Prime", monospace;
    font-size: 0.62rem;

    letter-spacing: 0.06em;

    white-space: nowrap;

    z-index: 2;

    animation:
      float-scroll-cue 2.8s ease-in-out infinite;

    transition:
      border-color 0.2s ease,
      background 0.2s ease;
  }

  .scroll-cue:hover {
    border-color: rgba(77, 118, 87, 0.7);

    background: rgba(237, 236, 234, 0.95);
  }

  .scroll-arrow {
    color: #4d7657;

    font-size: 0.9rem;
    line-height: 1;
  }

  @keyframes float-scroll-cue {
    0%,
    100% {
      transform: translate(-50%, 0);
    }

    50% {
      transform: translate(-50%, -6px);
    }
  }

  @keyframes blink {
    0%,
    50% {
      opacity: 1;
    }

    51%,
    100% {
      opacity: 0;
    }
  }

  /* =========================
     MOBILE
     ========================= */

  @media (max-width: 640px) {
    .hero {
      padding: 24px 18px 140px;
    }

    .hero-content {
      width: 100%;
    }

    .hero-intro {
      width: 100%;

      font-size: clamp(2rem, 10vw, 3.5rem);

      line-height: 1;
    }

    .typewriter-wrapper {
      width: 100%;

      min-height: 2.1em;

      margin-top: 12px;

      font-size: clamp(2.2rem, 11vw, 4rem);
    }

    .project-cards {
      width: calc(100vw - 36px);

      margin-top: 40px;

      display: flex;

      gap: 14px;

      overflow-x: auto;
      overflow-y: visible;

      padding: 12px 4px 22px;

      scroll-snap-type: x mandatory;

      scrollbar-width: none;
    }

    .project-cards::-webkit-scrollbar {
      display: none;
    }

    .project-card {
      flex: 0 0 68%;

      aspect-ratio: 0.72;

      scroll-snap-align: center;
    }

    .project-card:nth-child(1),
    .project-card:nth-child(2),
    .project-card:nth-child(3),
    .project-card:nth-child(4),
    .project-card:nth-child(5) {
      transform: none;
    }

    .project-card-footer {
      padding: 12px 13px;

      font-size: 0.66rem;
    }

    .scroll-cue {
      bottom: 82px;

      padding: 7px 11px;

      font-size: 0.56rem;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .scroll-cue {
      animation: none;
    }

    .project-card {
      transition: none;
    }

    .cursor {
      animation: none;
    }
  }
</style>