            start: "top top",
            end: "+=700",
            pin: true,
            pinSpacing: true,
            scrub: 0.8,
            anticipatePin: 1,
            invalidateOnRefresh: true,
            snap: {
              snapTo: "labelsDirectional",
              inertia: false,
              duration: { min: 0.16, max: 0.3 },
              delay: 0.3,
              ease: "power1.inOut",
            },
          },
