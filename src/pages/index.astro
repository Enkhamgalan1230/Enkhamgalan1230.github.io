    transform: translateY(-3px);
  }

  .fill-answer {
    display: inline-flex;
    justify-self: start;
    align-items: center;
    min-width: min(100%, 500px);
    min-height: 1.18em;
    border: 2px dashed #4d7657;
    border-radius: 4px;
    padding: 12px 18px 11px;
    background: rgba(255, 255, 255, 0.4);
    font: italic 400 clamp(2.7rem, 5vw, 5.4rem)/0.95 "Instrument Serif", serif;
    transition: background 0.25s ease, color 0.25s ease, border-color 0.25s ease;
  }

  .fill-answer:has(#typewriter.is-filling) {
