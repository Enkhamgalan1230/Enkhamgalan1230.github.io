    font-size: clamp(2.7rem, 6vw, 5rem);
    font-weight: 400;
    line-height: 0.92;
  }

  .kumo-info-copy h2 span {
    color: #4d7657;
  }

  .kumo-info-copy > p:not(.head-prompt-label) {
    max-width: 28rem;
    margin: 0;
    font-family: var(--font-reading);
    font-size: 0.9rem;
