          .addLabel("center")
          .to(kumoGameSnapContent, {
            opacity: 1,
            scale: 1,
            y: 0,
            duration: 0.44,
            ease: "none",
          })
          .addLabel("exit")
          .to(kumoGameSnapContent, {
            opacity: 0.72,
            scale: 0.97,
            y: -18,
            duration: 0.28,
            ease: "power2.inOut",
          })
      : null;

    let refreshTimer: number | undefined;

    const refreshProjectScroll = () => {
      window.clearTimeout(refreshTimer);
      refreshTimer = window.setTimeout(() => {
    ScrollTrigger.refresh();

    const sectionRevealTimelines: gsap.core.Timeline[] = [];
    const sectionRevealTargets = Array.from(
      document.querySelectorAll<HTMLElement>("[data-scroll-reveal-section]"),
