          .addLabel("center")
          .to(projectsSnapContent, {
            opacity: 1,
            scale: 1,
            y: 0,
            duration: 0.44,
          })
          .addLabel("exit")
          .to(projectsSnapContent, {
            opacity: 0.72,
            scale: 0.97,
            y: -18,
            duration: 0.28,
          })
      : null;

    const kumoGameSnapTimeline = kumoGameSnapSection && kumoGameSnapContent
      ? gsap.timeline({
          scrollTrigger: {
            id: "kumo-game-scroll-snap",
