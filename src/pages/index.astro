    const deferredVideoObserver = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          const video = entry.target as HTMLVideoElement;
          if (entry.isIntersecting) {
            loadDeferredVideo(video);
            void video.play().catch(() => undefined);
          } else if (video.dataset.loaded === "true") {
            video.pause();
          }
        });
      },
      { rootMargin: "300px 0px" },
    );

    deferredVideos.forEach((video) => deferredVideoObserver.observe(video));
  } else {
    deferredVideos.forEach(loadDeferredVideo);
  }

  const kumoWhoButton =
    document.querySelector<HTMLButtonElement>(
      "[data-kumo-who]"
    );

  const kumoInfoOverlay =
    document.querySelector<HTMLElement>(
      "[data-kumo-info-overlay]"
    );

  const kumoInfoClose =
    document.querySelector<HTMLButtonElement>(
      "[data-kumo-info-close]"
    );

