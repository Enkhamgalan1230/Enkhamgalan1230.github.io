      const sectionId = section.dataset.scrollRevealSection;
      if (!sectionId) return;

      ScrollTrigger.getAll().forEach((trigger) => {
        if (trigger.vars.id === `section-reveal-${sectionId}`) {
          trigger.kill();
        }
      });

