---
import BaseLayout from "../layouts/BaseLayout.astro";
import ReceiptProject from "../projects/ReceiptProject.astro";
---

<BaseLayout title="Entwan's Portfolio">

  <!-- =========================
       HERO
       ========================= -->

  <section class="hero">
    <div class="hero-content">
      <p class="hero-intro">
        Data and problem <span class="hero-green">given.</span><br />
        I turn them into:
      </p>

      <div class="typewriter-wrapper">
        <span id="typewriter"></span>
        <span class="cursor" aria-hidden="true">|</span>
      </div>
    </div>

    <a class="scroll-cue" href="#projects">
      <span>SCROLL TO EXPLORE</span>
      <span class="scroll-arrow">↓</span>
    </a>
  </section>

  <!-- =========================
       PROJECTS
       ========================= -->

  <section class="projects-section" id="projects">
    <div class="projects-inner reveal-section">

      <div class="projects-heading">
        <p class="projects-label">
          SELECTED WORK
        </p>

        <h2>
          Some things I've built.
        </h2>

      </div>

      <!-- =========================
           CAROUSEL
           ========================= -->

      <div class="projects-carousel">

        <button
          class="carousel-button carousel-button-left"
          type="button"
          aria-label="Previous projects"
          data-carousel-prev
        >
          ←
        </button>

        <div class="projects-viewport">

          <div
            class="project-cards"
            data-project-track
          >

            <!-- =========================
                 01 RECEIPT
                 ========================= -->

            <div class="carousel-item">
              <button
                class="project-card project-card-video"
                type="button"
                data-project-open="receipt-project"
                aria-label="Open Receipt project"
              >
                <div class="project-video-background">
                  <video
                    autoplay
                    muted
                    loop
                    playsinline
                    preload="metadata"
                    aria-hidden="true"
                  >
                    <source
                      src="/videos/patterns/vids/pattern1.mp4"
                      type="video/mp4"
                    />
                  </video>
                </div>

                <div class="project-card-image">
                  <div class="video-card-content">

                    <span class="video-card-type">
                      AI / DATA / FULL STACK
                    </span>

                    <div class="video-card-main">
                      <strong>
                        Receipt
                      </strong>

                      <small>
                        Smart grocery budgeting
                      </small>
                    </div>

                  </div>
                </div>

                <div class="project-card-footer video-card-footer">
                  <span>Receipt</span>
                  <span>01</span>
                </div>

              </button>
            </div>

            <!-- =========================
                 02 PLACEHOLDER
                 ========================= -->

            <div class="carousel-item">
              <a
                class="project-card project-card-video"
                href="/projects"
                aria-label="Open Project Two"
              >
                <div class="project-video-background">
                  <video
                    autoplay
                    muted
                    loop
                    playsinline
                    preload="metadata"
                    aria-hidden="true"
                  >
                    <source
                      src="/videos/patterns/vids/pattern2.mp4"
                      type="video/mp4"
                    />
                  </video>
                </div>

                <div class="project-card-image">
                  <div class="video-card-content">

                    <span class="video-card-type">
                      DATA / AUTOMATION
                    </span>

                    <div class="video-card-main">
                      <strong>
                        Project Two
                      </strong>

                      <small>
                        Another useful thing I built
                      </small>
                    </div>

                  </div>
                </div>

                <div class="project-card-footer video-card-footer">
                  <span>Project Two</span>
                  <span>02</span>
                </div>

              </a>
            </div>

            <!-- =========================
                 03 PLACEHOLDER
                 ========================= -->

            <div class="carousel-item">
              <a
                class="project-card project-card-video"
                href="/projects"
                aria-label="Open Project Three"
              >
                <div class="project-video-background">
                  <video
                    autoplay
                    muted
                    loop
                    playsinline
                    preload="metadata"
                    aria-hidden="true"
                  >
                    <source
                      src="/videos/patterns/vids/pattern3.mp4"
                      type="video/mp4"
                    />
                  </video>
                </div>

                <div class="project-card-image">
                  <div class="video-card-content">

                    <span class="video-card-type">
                      AI / NLP / EXPERIMENT
                    </span>

                    <div class="video-card-main">
                      <strong>
                        Project Three
                      </strong>

                      <small>
                        Machines doing clever things
                      </small>
                    </div>

                  </div>
                </div>

                <div class="project-card-footer video-card-footer">
                  <span>Project Three</span>
                  <span>03</span>
                </div>

              </a>
            </div>

            <!-- =========================
                 04 PLACEHOLDER
                 ========================= -->

            <div class="carousel-item">
              <a
                class="project-card project-card-video"
