<script>
  function initHeroOrbit() {
    const stageEl = document.querySelector<HTMLElement>("[data-hero-orbit]");
    if (!stageEl || stageEl.dataset.orbitReady === "true") return;
    stageEl.dataset.orbitReady = "true";
    const stage: HTMLElement = stageEl;

    const heroSection = stage.closest<HTMLElement>("[data-scroll-reveal-section]");
    const mainTrigger = stage.querySelector<HTMLButtonElement>(".hero-main-trigger");
    const reduceMotionQuery = window.matchMedia("(prefers-reduced-motion: reduce)");
    const mobileQuery = window.matchMedia("(max-width: 640px)");
    let reduceMotion = reduceMotionQuery.matches;

    const ENTRY_SPRING = { k: 140, c: 18 };
    const RELEASE_SPRING = { k: 380, c: 30 };
    const LIFT_SPRING = { k: 420, c: 34 };
    const ENTRY_START_SCALE = 0.6;
    const ENTRY_DELAY_MS = 280;
    const ENTRY_STAGGER_MS = [0, 55, 105, 150, 190, 225, 255, 280];
    const PROMOTE_AT = 0.12;
    const DRAG_LIFT_SCALE = 1.05;
    const RUBBER_C = 0.55;
    const RUBBER_MAX_DESKTOP = 60;
    const RUBBER_MAX_MOBILE = 44;
    const THRESHOLD_MOUSE = 6;
    const THRESHOLD_TOUCH = 10;
    const VELOCITY_WINDOW_MS = 80;
    const VELOCITY_STALE_MS = 50;
    const MAX_RELEASE_VELOCITY = 2500;
    const STEP = 1 / 240;
    const DIALOG_CLOSE_MS = 160;

    const heroOrbitDefinitions = [
      { selector: ".orbit-leaf", angle: 185.625, size: 104, rotation: -12, mobileX: 0.12, mobileY: 0.88 },
      { selector: ".orbit-uk", angle: 196.875, size: 80, rotation: -4, mobileX: 0.11, mobileY: 0.48 },
      { selector: ".orbit-plate", angle: 208.125, size: 75, rotation: 10, mobileX: 0.23, mobileY: 0.68 },
      { selector: ".orbit-boots", angle: 219.375, size: 100, rotation: -8, xOffset: -18, mobileX: 0.19, mobileY: 0.22 },
      { selector: ".orbit-laptop", angle: 230.625, size: 160, rotation: 4, mobileX: 0.43, mobileY: 0.37 },
      { selector: ".orbit-cap", angle: 241.875, size: 84, rotation: -7, mobileX: 0.42, mobileY: 0.14 },
      { selector: ".orbit-gloves", angle: 253.125, size: 110, rotation: 12, xOffset: 20, mobileX: 0.66, mobileY: 0.21 },
      { selector: ".orbit-soysauce", angle: 264.375, size: 86, rotation: -10, mobileX: 0.86, mobileY: 0.14 },
    ] as Array<{
      selector: string; angle: number; size: number; rotation: number;
      xOffset?: number; yOffset?: number; mobileX?: number; mobileY?: number;
    }>;

    type OrbitItem = {
      el: HTMLButtonElement;
      img: HTMLImageElement | null;
      definitionIndex: number;
      slotX: number; slotY: number;
      x: number; y: number; vx: number; vy: number;
      s: number; vs: number; ts: number;
      k: number; c: number;
      active: boolean; entering: boolean; dragging: boolean;
      entryDistance: number;
    };

    const items: OrbitItem[] = [];
    heroOrbitDefinitions.forEach((definition, definitionIndex) => {
      const el = stage.querySelector<HTMLButtonElement>(definition.selector);
      if (!el) return;
      items.push({
        el, img: el.querySelector("img"), definitionIndex,
        slotX: 0, slotY: 0, x: 0, y: 0, vx: 0, vy: 0, s: 1, vs: 0, ts: 1,
        k: ENTRY_SPRING.k, c: ENTRY_SPRING.c,
        active: false, entering: false, dragging: false, entryDistance: 0,
      });
    });
    const itemByEl = new Map(items.map((item) => [item.el, item] as const));

    /* ---------- layout (slots only; never touches transform) ---------- */
    function layoutHeroOrbit() {
      const stageRect = stage.getBoundingClientRect();
      const mainRect = mainTrigger?.getBoundingClientRect();
      if (!mainRect) return;
      const isMobile = mobileQuery.matches;

      const arcCenterX = mainRect.right - stageRect.left - 18;
      const arcCenterY = mainRect.bottom - stageRect.top - 18;
      const arcRadiusX = mainRect.width * 1.12;
      const arcRadiusY = mainRect.height * 0.92;

      items.forEach((item) => {
        const index = item.definitionIndex;
        const definition = heroOrbitDefinitions[index];
        const isBoots = definition.selector === ".orbit-boots";
        const angle = (definition.angle * Math.PI) / 180;
        const size = Math.min(
          definition.size * (isMobile ? 0.78 : 1),
          stageRect.width * (isMobile ? 0.2 : 0.24),
        );
        const gap = 68 + size / 2;
        const rawX = isMobile && definition.mobileX !== undefined
          ? definition.mobileX * stageRect.width
          : arcCenterX + (arcRadiusX + gap) * Math.cos(angle) + (definition.xOffset ?? 0);
        const rawY = isMobile && definition.mobileY !== undefined
          ? definition.mobileY * stageRect.height
          : arcCenterY + (arcRadiusY + gap) * Math.sin(angle) + (definition.yOffset ?? 0);
        const x = Math.max(
          isMobile ? size / 2 + 8 : size / 2 + 12,
          Math.min(stageRect.width - size / 2 - 12, rawX),
        );
        const y = Math.max(size / 2 + 12, Math.min(stageRect.height - size / 2 - 12, rawY));

        item.slotX = x;
        item.slotY = y;
        const el = item.el;
        el.style.left = `${x}px`;
        el.style.top = `${y}px`;
        el.style.width = `${size}px`;
        el.style.setProperty("--orbit-rotation", `${definition.rotation}deg`);
        el.style.setProperty(
          "--orbit-duration",
          `${isBoots ? (isMobile ? 8.4 : 7.2) + ((index * 0.47) % (isMobile ? 1.4 : 1.2)) : isMobile ? 7.2 + ((index * 0.47) % 2.2) : 4.8 + ((index * 0.47) % 1.7)}s`,
        );
        el.style.setProperty("--orbit-delay", `${-(index * 0.63)}s`);
        el.style.setProperty("--orbit-lift", `${isBoots ? 2 : isMobile ? 3 + ((index * 2) % 3) : 6 + ((index * 3) % 6)}px`);
        el.style.setProperty(
          "--orbit-sway",
          `${(index % 2 === 0 ? -1 : 1) * (isBoots ? 1 : isMobile ? 1 + (index % 2) : 2 + (index % 3))}px`,
        );
      });
    }

    /* ---------- spring engine ---------- */
    function writeTransform(item: OrbitItem) {
      item.el.style.transform =
        `translate(-50%, -50%) translate3d(${item.x.toFixed(2)}px, ${item.y.toFixed(2)}px, 0) scale(${item.s.toFixed(4)})`;
    }

    function stepItem(item: OrbitItem, dt: number, moveXY: boolean) {
      let remaining = dt;
      while (remaining > 1e-6) {
        const h = Math.min(STEP, remaining);
        if (moveXY) {
          item.vx += (-item.k * item.x - item.c * item.vx) * h;
          item.vy += (-item.k * item.y - item.c * item.vy) * h;
          item.x += item.vx * h;
          item.y += item.vy * h;
        }
        item.vs += (-item.k * (item.s - item.ts) - item.c * item.vs) * h;
        item.s += item.vs * h;
        remaining -= h;
      }
    }

    function isAtRest(item: OrbitItem) {
      return Math.abs(item.x) < 0.05 && Math.abs(item.y) < 0.05
        && Math.abs(item.vx) < 1 && Math.abs(item.vy) < 1
        && Math.abs(item.s - item.ts) < 0.0005 && Math.abs(item.vs) < 0.01;
    }

    function promote(item: OrbitItem) {
      item.entering = false;
      item.el.classList.remove("is-behind");
    }

    let rafId = 0;
    let lastFrame = 0;

    function ensureLoop() {
      if (rafId) return;
      lastFrame = performance.now();
      rafId = requestAnimationFrame(tick);
    }

    function stopLoop() {
      if (rafId) cancelAnimationFrame(rafId);
      rafId = 0;
    }

    function tick(now: number) {
      const dt = Math.min(Math.max((now - lastFrame) / 1000, 0), 1 / 30);
      lastFrame = now;
      let keepRunning = false;

      for (const item of items) {
        if (!item.active) continue;
        stepItem(item, dt, !item.dragging);

        if (item.entering && Math.hypot(item.x, item.y) <= item.entryDistance * PROMOTE_AT) {
          promote(item);
        }

        if (!item.dragging && isAtRest(item)) {
          item.x = 0; item.y = 0; item.vx = 0; item.vy = 0;
          item.s = item.ts; item.vs = 0;
          item.active = false;
          if (item.entering) promote(item);
        } else {
          keepRunning = true;
        }
        writeTransform(item);
      }

      rafId = keepRunning ? requestAnimationFrame(tick) : 0;
    }

    /* ---------- entrance ---------- */
    let entranceStarted = false;
    const entranceTimers: number[] = [];
    let revealObserver: MutationObserver | null = null;

    function placeAllAtRest() {
      entranceTimers.forEach((timer) => window.clearTimeout(timer));
      entranceTimers.length = 0;
      for (const item of items) {
        item.x = 0; item.y = 0; item.vx = 0; item.vy = 0;
        item.s = 1; item.ts = 1; item.vs = 0;
        item.active = false; item.entering = false; item.dragging = false;
        item.el.classList.remove("is-behind", "is-dragging");
        item.el.classList.add("is-ready");
        writeTransform(item);
      }
    }

    function runEntrance() {
      layoutHeroOrbit();
      if (reduceMotion || !mainTrigger) {
        placeAllAtRest();
        return;
      }

      const stageRect = stage.getBoundingClientRect();
      const mainRect = mainTrigger.getBoundingClientRect();
      // Roughly the middle of the person + dogs silhouette.
      const originX = mainRect.left - stageRect.left + mainRect.width * 0.55;
      const originY = mainRect.top - stageRect.top + mainRect.height * 0.55;

      items.forEach((item, order) => {
        item.x = originX - item.slotX;
        item.y = originY - item.slotY;
        item.vx = 0; item.vy = 0; item.vs = 0;
        item.s = ENTRY_START_SCALE; item.ts = 1;
        item.k = ENTRY_SPRING.k; item.c = ENTRY_SPRING.c;
        item.entryDistance = Math.hypot(item.x, item.y);
        item.entering = true;
        item.el.classList.add("is-behind");
        writeTransform(item);

        entranceTimers.push(window.setTimeout(() => {
          item.el.classList.add("is-ready");
          item.active = true;
          ensureLoop();
        }, ENTRY_STAGGER_MS[order] ?? order * 40));
      });
    }

    function startEntrance() {
      if (entranceStarted) return;
      entranceStarted = true;
      revealObserver?.disconnect();
      revealObserver = null;
      entranceTimers.push(window.setTimeout(runEntrance, reduceMotion ? 0 : ENTRY_DELAY_MS));
    }

    const heroIsRevealed = () => !heroSection || heroSection.classList.contains("is-visible");

    /* ---------- drag ---------- */
    type DragState = {
      item: OrbitItem;
      pointerId: number;
      startX: number; startY: number;
      baseRawX: number; baseRawY: number;
      max: number; threshold: number;
      engaged: boolean;
      samples: Array<{ t: number; x: number; y: number }>;
    };
    let drag: DragState | null = null;
    let suppressClickUntil = 0;

    function rubber(distance: number, max: number) {
      return max * (1 - 1 / ((distance * RUBBER_C) / max + 1));
    }

    function inverseRubber(distance: number, max: number) {
      const clamped = Math.min(distance, max * 0.98);
      return (max / RUBBER_C) * (1 / (1 - clamped / max) - 1);
    }

    function onPointerDown(event: PointerEvent) {
      if (reduceMotion || drag) return; // ignore extra fingers
      if (event.pointerType === "mouse" && event.button !== 0) return;
      const el = (event.target as Element | null)?.closest<HTMLButtonElement>(".hero-orbit-item");
      const item = el ? itemByEl.get(el) : undefined;
      if (!item || !item.el.classList.contains("is-ready") || item.el.classList.contains("is-behind")) return;

      drag = {
        item,
        pointerId: event.pointerId,
        startX: event.clientX,
        startY: event.clientY,
        baseRawX: 0,
        baseRawY: 0,
        max: mobileQuery.matches ? RUBBER_MAX_MOBILE : RUBBER_MAX_DESKTOP,
        threshold: event.pointerType === "mouse" ? THRESHOLD_MOUSE : THRESHOLD_TOUCH,
        engaged: false,
        samples: [],
      };
    }

    function engageDrag(state: DragState, event: PointerEvent) {
      const { item } = state;
      // Continue from wherever the spring currently is: no jump, and the
      // threshold distance is absorbed instead of snapping to the pointer.
      const d = Math.hypot(item.x, item.y);
      const ratio = d > 0 ? inverseRubber(d, state.max) / d : 0;
      state.baseRawX = item.x * ratio;
      state.baseRawY = item.y * ratio;
      state.startX = event.clientX;
      state.startY = event.clientY;
      state.engaged = true;

      item.dragging = true;
      item.entering = false;
      item.active = true;
      item.vx = 0; item.vy = 0;
      item.ts = DRAG_LIFT_SCALE;
      item.k = LIFT_SPRING.k; item.c = LIFT_SPRING.c;
      item.el.classList.add("is-dragging");
      try { item.el.setPointerCapture(state.pointerId); } catch { /* pointer already gone */ }
      ensureLoop();
    }

    function onPointerMove(event: PointerEvent) {
      const state = drag;
      if (!state || event.pointerId !== state.pointerId) return;

      if (!state.engaged) {
        const moved = Math.hypot(event.clientX - state.startX, event.clientY - state.startY);
        if (moved < state.threshold) return;
        engageDrag(state, event);
      }

      const rawX = state.baseRawX + (event.clientX - state.startX);
      const rawY = state.baseRawY + (event.clientY - state.startY);
      const rawDistance = Math.hypot(rawX, rawY);
      const factor = rawDistance > 0 ? rubber(rawDistance, state.max) / rawDistance : 0;
      const { item } = state;
      item.x = rawX * factor;
      item.y = rawY * factor;

      const t = event.timeStamp;
      state.samples.push({ t, x: item.x, y: item.y });
      while (state.samples.length > 2 && t - state.samples[0].t > VELOCITY_WINDOW_MS) {
        state.samples.shift();
      }
      writeTransform(item);
    }

    function endDrag(event?: Event) {
      const state = drag;
      if (!state) return;
      const pointerEvent = event as PointerEvent | undefined;
      if (pointerEvent && "pointerId" in pointerEvent && pointerEvent.pointerId !== state.pointerId) return;
      drag = null;
      if (!state.engaged) return;

      const { item } = state;
      let vx = 0;
      let vy = 0;
      const first = state.samples[0];
      const last = state.samples[state.samples.length - 1];
      const releaseTime = event ? event.timeStamp : performance.now();
      if (first && last && last.t > first.t && releaseTime - last.t < VELOCITY_STALE_MS) {
        const dt = (last.t - first.t) / 1000;
        vx = (last.x - first.x) / dt;
        vy = (last.y - first.y) / dt;
        const speed = Math.hypot(vx, vy);
        if (speed > MAX_RELEASE_VELOCITY) {
          vx *= MAX_RELEASE_VELOCITY / speed;
          vy *= MAX_RELEASE_VELOCITY / speed;
        }
      }

      item.vx = vx;
      item.vy = vy;
      item.dragging = false;
      item.ts = 1;
      item.k = RELEASE_SPRING.k;
      item.c = RELEASE_SPRING.c;
      item.active = true;
      item.el.classList.remove("is-dragging");
      try {
        if (item.el.hasPointerCapture(state.pointerId)) item.el.releasePointerCapture(state.pointerId);
      } catch { /* ignore */ }

      if (event?.type === "pointerup") suppressClickUntil = performance.now() + 400;
      ensureLoop();
    }

    /* ---------- centred dialog with stacked card deck ---------- */
    type Slide = { el: HTMLElement; src: string; text: string; alt: string; photo: boolean; position: string; video: string; poster: string; gate: string };

    const dialog = document.querySelector<HTMLDialogElement>("[data-hero-orbit-dialog]");
    const dialogDeck = dialog?.querySelector<HTMLElement>(".hero-orbit-deck") ?? null;
    const frontCard = dialog?.querySelector<HTMLElement>(".hero-orbit-card.is-front") ?? null;
    const peekCard = dialog?.querySelector<HTMLElement>(".hero-orbit-card.is-peek") ?? null;

    const CARD_COLORS: Array<[string, string]> = [
      ["#4d7657", "#a9c7a0"],
      ["#d9b98a", "#f3e6cf"],
      ["#7d6aa8", "#d5cbe8"],
      ["#c4573f", "#f0c9b8"],
      ["#2f5d73", "#b8d4de"],
      ["#8a7a3a", "#e6dfb5"],
      ["#3d3d3d", "#cfcfcf"],
      ["#b0648a", "#efcfe0"],
      ["#4d7657", "#edecea"],
    ];
    const DEAL_PROMOTE_MS = 260;
    const DECK_COMMIT_RATIO = 0.3;
    const DECK_COMMIT_VELOCITY = 0.11; // px per ms
    const DECK_MAX_TILT_DEG = 8;
    const DECK_TILT_PER_PX = 0.04;
    const DECK_FLING_GAP = 48;
    const DECK_REDUCED_THRESHOLD = 50;

    type DeckDrag = {
      pointerId: number;
      startX: number; startY: number;
      dx: number;
      threshold: number;
      engaged: boolean;
      abandoned: boolean;
      samples: Array<{ t: number; x: number }>;
    };
    let deckDrag: DeckDrag | null = null;
    let suppressDeckClickUntil = 0;

    const deckTilt = (dx: number) =>
      Math.max(-DECK_MAX_TILT_DEG, Math.min(DECK_MAX_TILT_DEG, dx * DECK_TILT_PER_PX));
    const deckPose = (dx: number) => `translate3d(${dx}px, 0, 0) rotate(${deckTilt(dx)}deg)`;

    function clearInlinePose(card: HTMLElement | null) {
      if (!card) return;
      card.style.transform = "";
      card.style.transition = "";
      card.style.opacity = "";
    }

    // Visual order: leaf, uk, plate, boots, laptop, cap, gloves, soysauce. The portrait has no card.
    const slideOrder = [".orbit-leaf", ".orbit-uk", ".orbit-plate", ".orbit-boots", ".orbit-laptop", ".orbit-cap", ".orbit-gloves", ".orbit-soysauce"];
    const slides: Slide[] = [];
    const slideTriggers: Array<HTMLElement | null> = slideOrder.map((selector) => stage.querySelector<HTMLElement>(selector));
    for (const el of slideTriggers) {
      if (!el) continue;
      const img = el === mainTrigger
        ? el.querySelector<HTMLImageElement>(".hero-main-image")
        : el.querySelector<HTMLImageElement>("img");
      const alt = el === mainTrigger ? "Me" : (el.dataset.placeholder ?? "").trim(); // titles show exactly as written
      slides.push({
        el,
        // A full photo for the card (data-card-image) wins over the small cut-out.
        src: el.dataset.cardImage ?? img?.getAttribute("src") ?? "",
        text: el.dataset.message ?? el.dataset.placeholder ?? "",
        alt,
        photo: Boolean(el.dataset.cardImage),
        position: el.dataset.cardPosition ?? "50% 50%",
        video: el.dataset.cardVideo ?? "",
        poster: el.dataset.cardPoster ?? "",
        gate: el.dataset.cardGate ?? "",
      });
      el.setAttribute("aria-label", `Open details: ${alt}`);
      el.setAttribute("aria-haspopup", "dialog");
    }

    let slideIndex = 0;
    let dialogOpener: HTMLElement | null = null;
    let dialogClosing = false;
    let swapTimer = 0;
    let pendingFinish: (() => void) | null = null;
    let closeTimer = 0;
    let openFrame = 0;

    const wrapIndex = (i: number) => (i + slides.length) % slides.length;

    function preloadAhead(i: number) {
      for (const offset of [1, 2]) {
        const src = slides[wrapIndex(i + offset)]?.src;
        if (src) new Image().src = src;
      }
    }

    function fillCard(card: HTMLElement | null, i: number) {
      const slide = slides[i];
      if (!card || !slide) return;
      const [c1, c2] = CARD_COLORS[i % CARD_COLORS.length];
      const media = card.querySelector<HTMLElement>(".hero-orbit-card__media");
      media?.style.setProperty("--c1", c1);
      media?.style.setProperty("--c2", c2);
      media?.classList.toggle("is-photo", slide.photo || Boolean(slide.video));
      media?.classList.toggle("is-gated", Boolean(slide.gate) && !gateAccepted);
      const img = card.querySelector<HTMLImageElement>("img");
      if (img) {
        // A video slide shows its poster here; only the front card ever plays the video.
        img.src = slide.video ? slide.poster : slide.src;
        img.style.objectPosition = slide.position;
        img.alt = card === frontCard ? slide.alt : "";
      }
      const title = card.querySelector<HTMLElement>(".hero-orbit-card__title");
      const text = card.querySelector<HTMLElement>(".hero-orbit-card__text");
      if (title) title.textContent = slide.alt;
      if (text) text.textContent = slide.text;
    }

    /* ---------- front-card video + content gate ---------- */
    const frontMedia = frontCard?.querySelector<HTMLElement>(".hero-orbit-card__media") ?? null;
    const cardVideo = frontCard?.querySelector<HTMLVideoElement>(".hero-orbit-card__video") ?? null;
    const gateEl = frontCard?.querySelector<HTMLElement>(".hero-orbit-card__gate") ?? null;
    const gateText = frontCard?.querySelector<HTMLElement>(".hero-orbit-card__gate-text") ?? null;
    const gateBtn = frontCard?.querySelector<HTMLElement>(".hero-orbit-card__gate-btn") ?? null;
    const playBtn = frontCard?.querySelector<HTMLElement>(".hero-orbit-card__play") ?? null;
    const GATE_FADE_MS = 200;
    let gateAccepted = false; // in-memory: asks again after a page reload
    let gateTimer = 0;

    function stopVideo() {
      window.clearTimeout(gateTimer);
      if (cardVideo) {
        cardVideo.pause();
        cardVideo.removeAttribute("src");
        cardVideo.removeAttribute("poster");
        cardVideo.load();
      }
      frontMedia?.classList.remove("has-video", "is-ungating");
      if (gateEl) {
        gateEl.hidden = true;
        gateEl.classList.remove("is-leaving");
      }
      if (playBtn) playBtn.hidden = true;
    }

    // Every clip plays silently: no audio anywhere on the page.
    function playVideo(slide: Slide) {
      if (!cardVideo || !frontMedia) return;
      if (playBtn) playBtn.hidden = true;
      frontMedia.classList.add("has-video");
      cardVideo.poster = slide.poster;
      cardVideo.src = slide.video;
      cardVideo.muted = true;
      cardVideo.play()?.catch(() => {
        if (playBtn && cardVideo.getAttribute("src")) playBtn.hidden = false; // autoplay refused: offer play
      });
    }

    function startVideo(slide: Slide) {
      if (reduceMotion) {
        if (playBtn) playBtn.hidden = false; // no autoplay: poster plus a play button
        return;
      }
      playVideo(slide);
    }

    function acceptGate() {
      const slide = slides[slideIndex];
      if (!gateEl || !slide || gateEl.hidden || gateAccepted) return;
      gateAccepted = true;
      // Start the (still blurred) video first so the unblur animates on it, not just the poster.
      startVideo(slide);
      if (frontMedia) void frontMedia.offsetWidth;
      frontMedia?.classList.add("is-ungating");
      frontMedia?.classList.remove("is-gated");
      if (reduceMotion) {
        gateEl.hidden = true;
      } else {
        gateEl.classList.add("is-leaving");
        gateTimer = window.setTimeout(() => {
          gateEl.hidden = true;
          gateEl.classList.remove("is-leaving");
        }, GATE_FADE_MS);
      }
      frontCard?.focus({ preventScroll: true });
    }

    function onActivate(el: HTMLElement | null, handler: () => void) {
      el?.addEventListener("click", (event) => {
        event.stopPropagation(); // must not deal the next card
        handler();
      });
      el?.addEventListener("keydown", (event) => {
        if (event.key !== "Enter" && event.key !== " ") return;
        event.preventDefault();
        event.stopPropagation();
        handler();
      });
      el?.addEventListener("keyup", (event) => event.stopPropagation());
    }
    onActivate(gateBtn, acceptGate);
    onActivate(playBtn, () => {
      const slide = slides[slideIndex];
      if (slide?.video) playVideo(slide);
    });

    function focusFront() {
      if (gateEl && !gateEl.hidden && gateBtn) gateBtn.focus({ preventScroll: true });
      else frontCard?.focus({ preventScroll: true });
    }

    function syncFrontMedia() {
      const slide = slides[slideIndex];
      const hadGateFocus = document.activeElement === gateBtn;
      stopVideo();
      if (!slide?.video) {
        if (hadGateFocus) frontCard?.focus({ preventScroll: true });
        return;
      }
      if (slide.gate && !gateAccepted) {
        if (gateText) gateText.textContent = slide.gate;
        if (gateEl) gateEl.hidden = false;
        focusFront();
        return;
      }
      startVideo(slide);
      if (hadGateFocus) frontCard?.focus({ preventScroll: true });
    }

    function renderDeck(i: number) {
      fillCard(frontCard, i);
      fillCard(peekCard, wrapIndex(i + 1));
      syncFrontMedia();
      preloadAhead(i);
    }

    /* every card gets the tallest slide's height, so the deck never resizes between cards */
    function syncDeckHeight() {
      if (!frontCard || !dialogDeck || !dialog?.open) return;
      const probe = frontCard.cloneNode(true) as HTMLElement;
      probe.removeAttribute("data-dialog-slide");
      probe.setAttribute("aria-hidden", "true");
      probe.inert = true;
      probe.querySelector("video")?.remove();
      probe.classList.remove("is-out", "is-dragging");
      Object.assign(probe.style, {
        position: "absolute",
        top: "0",
        left: "0",
        width: `${frontCard.offsetWidth}px`,
        minHeight: "",
        transform: "none",
        transition: "none",
        opacity: "",
        visibility: "hidden",
        pointerEvents: "none",
      });
      dialogDeck.appendChild(probe);
      const probeTitle = probe.querySelector<HTMLElement>(".hero-orbit-card__title");
      const probeText = probe.querySelector<HTMLElement>(".hero-orbit-card__text");
      let tallest = 0;
      for (const slide of slides) {
        if (probeTitle) probeTitle.textContent = slide.alt;
        if (probeText) probeText.textContent = slide.text;
        tallest = Math.max(tallest, probe.offsetHeight);
      }
      probe.remove();
      frontCard.style.minHeight = tallest ? `${tallest}px` : "";
    }

    function resetDealClasses() {
      frontCard?.classList.remove("is-out");
      peekCard?.classList.remove("is-promote", "is-hidden");
    }

    function finishPending() {
      if (!pendingFinish) return;
      window.clearTimeout(swapTimer);
      const finish = pendingFinish;
      pendingFinish = null;
      finish();
    }

    function goTo(direction: number) {
      if (!dialog?.open || dialogClosing || !dialogDeck) return;
      finishPending(); // latest input wins: land the running deal first
      slideIndex = wrapIndex(slideIndex + direction);
      if (reduceMotion) {
        renderDeck(slideIndex);
        return;
      }

      if (direction > 0) {
        // the deal: front leaves, peek takes its place, then swap contents with no transition
        dialogDeck.classList.remove("is-swapping");
        frontCard?.classList.add("is-out");
        peekCard?.classList.add("is-promote");
        pendingFinish = () => {
          dialogDeck.classList.add("is-swapping");
          clearInlinePose(frontCard);
          resetDealClasses();
          renderDeck(slideIndex);
          peekCard?.classList.add("is-hidden");
          void dialogDeck.offsetWidth; // commit the rest state with no transition
          dialogDeck.classList.remove("is-swapping");
          peekCard?.classList.remove("is-hidden"); // new peek slides out from behind the front card
        };
        swapTimer = window.setTimeout(finishPending, DEAL_PROMOTE_MS);
      } else {
        // the reverse deal: previous card comes back onto the front, current card recedes to the peek slot
        dialogDeck.classList.add("is-swapping");
        resetDealClasses();
        renderDeck(slideIndex);
        frontCard?.classList.add("is-out");
        peekCard?.classList.add("is-promote");
        void dialogDeck.offsetWidth; // commit the start pose with no transition
        dialogDeck.classList.remove("is-swapping");
        frontCard?.classList.remove("is-out");
        peekCard?.classList.remove("is-promote");
      }
    }

    function openDialog(trigger: HTMLElement) {
      if (!dialog || !frontCard || dialog.open) return;
      const index = slides.findIndex((slide) => slide.el === trigger);
      if (index < 0) return;
      slideIndex = index;
      dialogOpener = trigger;
      dialogClosing = false;
      window.clearTimeout(swapTimer);
      window.clearTimeout(closeTimer);
      pendingFinish = null;
      resetDealClasses();
      dialogDeck?.classList.remove("is-swapping");
      renderDeck(slideIndex);
      delete dialog.dataset.state;
      document.documentElement.style.overflow = "hidden";
      dialog.showModal();
      syncDeckHeight();
      document.fonts?.ready.then(() => { if (dialog.open) syncDeckHeight(); });
      void dialog.offsetWidth; // commit the closed state so the open transition runs
      openFrame = requestAnimationFrame(() => {
        if (dialog.open && !dialogClosing) dialog.dataset.state = "open";
      });
      focusFront();
    }

    function closeDialog() {
      deckDrag = null;
      frontCard?.classList.remove("is-dragging");
      if (!dialog?.open || dialogClosing) return;
      dialogClosing = true;
      window.clearTimeout(swapTimer);
      pendingFinish = null;
      cancelAnimationFrame(openFrame);
      dialog.dataset.state = "closing";
      closeTimer = window.setTimeout(() => dialog.close(), reduceMotion ? 120 : DIALOG_CLOSE_MS);
    }

    /* ---------- deck swipe ---------- */
    function onDeckPointerDown(event: PointerEvent) {
      if (deckDrag || !dialog?.open || dialogClosing || !frontCard) return;
      if (event.pointerType === "mouse" && event.button !== 0) return;
      if ((event.target as Element | null)?.closest(".hero-orbit-card__gate-btn, .hero-orbit-card__play")) return;
      finishPending(); // land any running deal before grabbing the card
      deckDrag = {
        pointerId: event.pointerId,
        startX: event.clientX, startY: event.clientY,
        dx: 0,
        threshold: event.pointerType === "mouse" ? THRESHOLD_MOUSE : THRESHOLD_TOUCH,
        engaged: false, abandoned: false,
        samples: [],
      };
    }

    function onDeckPointerMove(event: PointerEvent) {
      const state = deckDrag;
      if (!state || state.abandoned || event.pointerId !== state.pointerId || !frontCard) return;
      const dx = event.clientX - state.startX;
      const dy = event.clientY - state.startY;
      if (!state.engaged) {
        if (Math.hypot(dx, dy) < state.threshold) return;
        if (Math.abs(dy) >= Math.abs(dx)) { state.abandoned = true; return; } // vertical intent: let the page have it
        state.engaged = true;
        frontCard.style.transition = ""; // drop any spring-back transition so the finger drives 1:1
        state.startX = event.clientX; // absorb the threshold so the card doesn't jump
        try { frontCard.setPointerCapture(state.pointerId); } catch { /* pointer gone */ }
        if (!reduceMotion) frontCard.classList.add("is-dragging");
      }
      state.dx = event.clientX - state.startX;
      const t = event.timeStamp;
      state.samples.push({ t, x: state.dx });
      while (state.samples.length > 2 && t - state.samples[0].t > VELOCITY_WINDOW_MS) state.samples.shift();
      if (!reduceMotion) frontCard.style.transform = deckPose(state.dx);
    }

    function deckReleaseVelocity(state: DeckDrag, releaseTime: number) {
      const first = state.samples[0];
      const last = state.samples[state.samples.length - 1];
      if (!first || !last || last.t <= first.t || releaseTime - last.t >= VELOCITY_STALE_MS) return 0;
      return (last.x - first.x) / (last.t - first.t); // px per ms
    }

    function endDeckDrag(event?: Event) {
      const state = deckDrag;
      if (!state || !frontCard) return;
      const pointerEvent = event as PointerEvent | undefined;
      if (pointerEvent && "pointerId" in pointerEvent && pointerEvent.pointerId !== state.pointerId) return;
      deckDrag = null;
      if (!state.engaged) return;

      try {
        if (frontCard.hasPointerCapture(state.pointerId)) frontCard.releasePointerCapture(state.pointerId);
      } catch { /* ignore */ }
      frontCard.classList.remove("is-dragging");
      if (event?.type === "pointerup") suppressDeckClickUntil = performance.now() + 400;

      const cancelled = event?.type !== "pointerup";
      const dx = state.dx;
      const vx = cancelled ? 0 : deckReleaseVelocity(state, event ? event.timeStamp : performance.now());
      const width = frontCard.offsetWidth;

      if (reduceMotion) {
        if (!cancelled && Math.abs(dx) > DECK_REDUCED_THRESHOLD) goTo(dx < 0 ? 1 : -1);
        return;
      }

      const commit = !cancelled && (
        Math.abs(dx) > width * DECK_COMMIT_RATIO
        || (Math.abs(vx) > DECK_COMMIT_VELOCITY && Math.sign(vx) === Math.sign(dx))
      );

      if (!commit) {
        frontCard.style.transition = "transform 280ms var(--ease-out)";
        frontCard.style.transform = "";
        window.setTimeout(() => {
          if (!deckDrag) frontCard.style.transition = "";
        }, 280);
        return;
      }

      if (dx < 0) {
        // fling out from where the finger let go; goTo(1) promotes the peek and swaps at its finish
        frontCard.style.transition = "transform 220ms var(--ease-out), opacity 220ms var(--ease-out)";
        frontCard.style.transform = `translate3d(${-(width + DECK_FLING_GAP)}px, 0, 0) rotate(${-DECK_MAX_TILT_DEG}deg)`;
        frontCard.style.opacity = "0";
        goTo(1);
      } else {
        clearInlinePose(frontCard);
        goTo(-1);
        startPeekFromFinger(dx);
      }
    }

    function startPeekFromFinger(dx: number) {
      if (!peekCard || !dialogDeck) return;
      dialogDeck.classList.add("is-swapping");
      peekCard.style.transform = deckPose(dx);
      void peekCard.offsetWidth; // commit the finger pose with no transition
      dialogDeck.classList.remove("is-swapping");
      peekCard.style.transform = ""; // falls back to the class pose: recede into the peek slot
    }

    if (dialog && dialogDeck && frontCard && typeof dialog.showModal === "function" && slides.length) {
      dialog.addEventListener("close", () => {
        window.clearTimeout(closeTimer);
        window.clearTimeout(swapTimer);
        pendingFinish = null;
        stopVideo(); // no audio may outlive the dialog
        resetDealClasses();
        clearInlinePose(frontCard);
        clearInlinePose(peekCard);
        if (frontCard) frontCard.style.minHeight = "";
        dialogClosing = false;
        delete dialog.dataset.state;
        document.documentElement.style.overflow = "";
        dialogOpener?.focus({ preventScroll: true });
        dialogOpener = null;
      });

      dialog.addEventListener("cancel", (event) => {
        event.preventDefault();
        closeDialog();
      });

      dialog.addEventListener("click", (event) => {
        if (event.target === dialog) closeDialog(); // backdrop: outside the deck
      });

      dialog.querySelector("[data-dialog-close]")?.addEventListener("click", (event) => {
        event.stopPropagation();
        closeDialog();
      });
      frontCard.addEventListener("click", (event) => {
        if (performance.now() < suppressDeckClickUntil) {
          suppressDeckClickUntil = 0;
          event.preventDefault();
          return;
        }
        goTo(1);
      });
      frontCard.addEventListener("pointerdown", onDeckPointerDown);
      window.addEventListener("pointermove", onDeckPointerMove, { passive: true });
      window.addEventListener("pointerup", endDeckDrag);
      window.addEventListener("pointercancel", endDeckDrag);
      frontCard.addEventListener("lostpointercapture", endDeckDrag);
      frontCard.addEventListener("dragstart", (event) => event.preventDefault());
      dialog.addEventListener("close", () => { deckDrag = null; frontCard.classList.remove("is-dragging"); });

      dialog.addEventListener("keydown", (event) => {
        if (event.key === "ArrowLeft") {
          event.preventDefault();
          goTo(-1);
        } else if (event.key === "ArrowRight") {
          event.preventDefault();
          goTo(1);
        }
      });
    }

    /* ---------- wiring ---------- */
    layoutHeroOrbit();
    mainTrigger?.querySelector<HTMLImageElement>(".hero-main-image")
      ?.addEventListener("load", layoutHeroOrbit, { once: true });
    requestAnimationFrame(layoutHeroOrbit);

    if (heroIsRevealed()) {
      startEntrance();
    } else if (heroSection) {
