---
import BaseLayout from "../layouts/BaseLayout.astro";
import ReceiptProject
  from "../projects/ReceiptProject.astro";

---


<BaseLayout title="Entwan's Portfolio">
  <section class="hero">
    <div class="hero-content">
      <p class="hero-intro">
        Data and problem <span class="hero-green">given.</span><br />
        I turn them into:
      </p>

      <div class="typewriter-wrapper">
        <span id="typewriter"></span>
        <span class="cursor" aria-hidden="true">|</span>
      </div>
    </div>

    <a class="scroll-cue" href="#projects">
      <span>SCROLL TO EXPLORE</span>
      <span class="scroll-arrow">↓</span>
    </a>
  </section>

  <section class="projects-section" id="projects">
    <div class="projects-inner reveal-section">
      <div class="projects-heading">
        <p class="projects-label">SELECTED WORK</p>

        <h2>Some things I've built.</h2>
      </div>

      <div class="project-cards">
        <button
          class="project-card project-card-receipt"
          type="button"
          data-project-open="receipt-project"
          aria-label="Open Receipt project"
        >
          <div class="receipt-card-background">
            <img
              src="/gifs/reciept.gif"
              alt=""
              aria-hidden="true"
            />

            <div class="receipt-card-overlay"></div>
          </div>

          <div class="project-card-image">
            <div class="receipt-card-content">
              <span>
                AI / DATA / FULL STACK
              </span>

              <strong>
                Receipt
              </strong>

              <small>
                Smart grocery budgeting
              </small>
            </div>
          </div>

          <div class="project-card-footer receipt-card-footer">
            <span>Receipt</span>
            <span>01</span>
          </div>
        </button>

        <a class="project-card" href="/projects">
          <div class="project-card-image placeholder-two"></div>

          <div class="project-card-footer">
            <span>Project Beta</span>
            <span>02</span>
          </div>
        </a>

        <a class="project-card" href="/projects">
          <div class="project-card-image placeholder-three"></div>

          <div class="project-card-footer">
            <span>Project Gamma</span>
            <span>03</span>
          </div>
        </a>

        <a class="project-card" href="/projects">
          <div class="project-card-image placeholder-four"></div>

          <div class="project-card-footer">
            <span>Project Delta</span>
            <span>04</span>
          </div>
        </a>

        <a class="project-card" href="/projects">
          <div class="project-card-image placeholder-five"></div>

          <div class="project-card-footer">
            <span>Project Echo</span>
            <span>05</span>
          </div>
        </a>
      </div>
    </div>
  </section>
  <ReceiptProject />
</BaseLayout>

<script>
  const words = [
    "Automation",
    "Predictions",
    "Efficiency",
    "“Yeahh, that makes sense” moments",
    "CooooOol AI things",
  ];

  const element =
    document.querySelector<HTMLElement>("#typewriter");

  const typingSpeed = 85;
  const deletingSpeed = 25;
  const finishedPause = 1000;
  const emptyPause = 500;

  const wait = (time: number) =>
    new Promise<void>((resolve) => {
      setTimeout(resolve, time);
    });

  async function typeWord(word: string) {
    if (!element) return;

    for (let i = 1; i <= word.length; i++) {
      element.textContent = word.slice(0, i);
      await wait(typingSpeed);
    }
  }

  async function deleteWord(word: string) {
    if (!element) return;

    for (let i = word.length; i >= 0; i--) {
      element.textContent = word.slice(0, i);
      await wait(deletingSpeed);
    }
  }

  async function startTypewriter() {
    if (!element) return;

    while (true) {
      for (const word of words) {
        await typeWord(word);
        await wait(finishedPause);

        await deleteWord(word);
        await wait(emptyPause);
      }
    }
  }

  startTypewriter();

  const revealSection =
    document.querySelector<HTMLElement>(".reveal-section");

  if (revealSection) {
    const observer = new IntersectionObserver(
      (entries) => {
        for (const entry of entries) {
          if (entry.isIntersecting) {
            revealSection.classList.add("is-visible");
            observer.disconnect();
          }
        }
      },
      {
        threshold: 0.2,
      }
    );

    observer.observe(revealSection);
  }
</script>

<style>
  /* =========================
     HERO
     ========================= */

  .hero {
    position: relative;

    display: flex;
    align-items: center;
    justify-content: center;

    width: 100%;
    min-height: calc(100vh - 140px);

    padding: 24px;

    overflow: hidden;
  }

  .hero-content {
    position: relative;

    z-index: 1;

    width: min(100%, 680px);

    text-align: left;
  }

  .hero-green {
    color: #4d7657;
  }

  .hero-intro {
    margin: 0;

    font-family: "Instrument Serif", serif;
    font-size: clamp(2.1rem, 4vw, 4.2rem);

    font-weight: 400;

    line-height: 0.98;
    letter-spacing: -0.025em;

    color: #111111;
  }

  .typewriter-wrapper {
    min-height: 2em;

    margin-top: 8px;

    font-family: "Instrument Serif", serif;
    font-size: clamp(2.3rem, 4.2vw, 4.4rem);

    font-style: italic;
    font-weight: 400;

    line-height: 0.95;

    color: #4d7657;
  }

  .cursor {
    display: inline-block;

    margin-left: 2px;

    font-style: normal;

    animation: blink 0.8s steps(1) infinite;
  }

  /* =========================
     SCROLL CUE
     ========================= */

  .scroll-cue {
    position: absolute;

    left: 50%;
    bottom: 28px;

    transform: translateX(-50%);

    display: inline-flex;
    align-items: center;

    gap: 8px;

    padding: 8px 13px;

    border: 1px solid rgba(17, 17, 17, 0.22);
    border-radius: 999px;

    background: rgba(237, 236, 234, 0.72);

    backdrop-filter: blur(8px);
    -webkit-backdrop-filter: blur(8px);

    font-family: "Courier Prime", monospace;
    font-size: 0.62rem;

    letter-spacing: 0.06em;

    white-space: nowrap;

    z-index: 2;

    animation:
      float-scroll-cue 2.8s ease-in-out infinite;

    transition:
      border-color 0.2s ease,
      background 0.2s ease;
  }

  .scroll-cue:hover {
    border-color: rgba(77, 118, 87, 0.7);

    background: rgba(237, 236, 234, 0.95);
  }

  .scroll-arrow {
    color: #4d7657;

    font-size: 0.9rem;
    line-height: 1;
  }

  /* =========================
     PROJECT SECTION
     ========================= */

  .projects-section {
    min-height: 100vh;

    display: flex;
    align-items: center;
    justify-content: center;

    padding: 100px 36px 120px;

    background: #edecea;
  }

  .projects-inner {
    width: min(1200px, 100%);

    margin: 0 auto;

    opacity: 0;

    transform: translateY(50px);

    transition:
      opacity 0.8s ease,
      transform 0.8s cubic-bezier(0.22, 1, 0.36, 1);
  }

  .projects-inner.is-visible {
    opacity: 1;

    transform: translateY(0);
  }

  .projects-heading {
    margin-bottom: 52px;
  }

  .projects-label {
    margin: 0 0 14px;

    font-family: "Courier Prime", monospace;
    font-size: 0.7rem;

    letter-spacing: 0.08em;

    color: #777777;
  }

  .projects-heading h2 {
    margin: 0;

    font-family: "Instrument Serif", serif;
    font-size: clamp(3rem, 5vw, 5.5rem);

    font-weight: 400;

    line-height: 0.95;
    letter-spacing: -0.025em;

    color: #111111;
  }

  /* =========================
     PROJECT CARDS
     ========================= */

  .project-cards {
    display: grid;

    grid-template-columns: repeat(5, minmax(0, 1fr));

    gap: 22px;

    align-items: center;
  }

  .project-card {
    position: relative;

    display: flex;
    flex-direction: column;

    aspect-ratio: 0.72;

    overflow: hidden;

    background: #f6f5f2;

    border: 1px solid rgba(17, 17, 17, 0.18);
    border-radius: 14px;

    box-shadow:
      0 14px 28px rgba(17, 17, 17, 0.06);

    animation:
      card-float 5.6s ease-in-out infinite,
      card-rock 7.2s ease-in-out infinite;

    transition:
      transform 0.28s ease,
      box-shadow 0.28s ease,
      border-color 0.28s ease;
  }

  .project-card:nth-child(1) {
    animation-duration: 5.4s, 7.4s;
    animation-delay: -1.2s, -2.8s;
  }

  .project-card:nth-child(2) {
    animation-duration: 6.3s, 8.1s;
    animation-delay: -3.1s, -0.7s;
  }

  .project-card:nth-child(3) {
    animation-duration: 5.9s, 6.8s;
    animation-delay: -2.2s, -4.1s;
  }

  .project-card:nth-child(4) {
    animation-duration: 6.8s, 7.7s;
    animation-delay: -4.6s, -1.5s;
  }

  .project-card:nth-child(5) {
    animation-duration: 5.1s, 8.4s;
    animation-delay: -0.9s, -3.4s;
  }

  .project-card:hover {
    animation-play-state: paused;

    transform: translateY(-14px) scale(1.03);

    border-color: rgba(77, 118, 87, 0.45);

    box-shadow:
      0 22px 42px rgba(17, 17, 17, 0.1);
  }

  .project-card-image {
    flex: 1;

    min-height: 0;
  }

  .placeholder-one {
    background:
      linear-gradient(
        145deg,
        #d8e1d8,
        #aebdaf
      );
  }

  .placeholder-two {
    background:
      linear-gradient(
        145deg,
        #dedbd1,
        #c8bea6
      );
  }

  .placeholder-three {
    background:
      linear-gradient(
        145deg,
        #d9d5df,
        #b9adca
      );
  }

  .placeholder-four {
    background:
      linear-gradient(
        145deg,
        #d7dfdf,
        #aabbbb
      );
  }

  .placeholder-five {
    background:
      linear-gradient(
        145deg,
        #dfd6cf,
        #c5afa0
      );
  }

  .project-card-footer {
    display: flex;
    align-items: center;
    justify-content: space-between;

    gap: 12px;

    padding: 14px 16px;

    background: #f6f5f2;

    font-family: "Courier Prime", monospace;
    font-size: 0.72rem;

    color: #111111;
  }

  .project-card {
    appearance: none;

    width: 100%;

    padding: 0;

    text-align: left;

    color: inherit;

    cursor: pointer;
  }

  .receipt-card-content {
    width: 100%;
    height: 100%;

    display: flex;
    flex-direction: column;

    padding: 18px;

    color: #111111;
  }

  /* =========================
    RECEIPT CARD
    ========================= */

  .project-card-receipt {
    background:
      linear-gradient(
        145deg,
        #56675b,
        #29342d
      );

    color: #f6f5f2;
  }

  .receipt-card-background {
    position: absolute;

    inset: 0;

    overflow: hidden;

    z-index: 0;
  }

  .receipt-card-background img {
    position: absolute;

    left: 50%;
    bottom: 2%;

    width: 94%;
    height: 94%;

    object-fit: contain;
    object-position: center bottom;

    opacity: 0.62;

    filter:
      blur(2px)
      saturate(0.9);

    transform:
      translateX(-50%)
      scale(1);

    transition:
      transform 0.5s
        cubic-bezier(0.22, 1, 0.36, 1),
      filter 0.5s ease,
      opacity 0.5s ease;
  }

  .receipt-card-overlay {
    position: absolute;

    inset: 0;

    background:
      linear-gradient(
        180deg,
        rgba(33, 44, 36, 0.25) 0%,
        rgba(28, 38, 31, 0.18) 35%,
        rgba(20, 28, 23, 0.72) 100%
      );
  }

  .project-card-receipt
  .project-card-image {
    position: relative;

    z-index: 1;
  }

  .project-card-receipt
  .receipt-card-content {
    position: relative;

    z-index: 2;

    color: #ffffff;
  }

  .project-card-receipt
  .receipt-card-content span {
    color:
      rgba(255, 255, 255, 0.78);
  }

  .project-card-receipt
  .receipt-card-content strong {
    color: #ffffff;

    text-shadow:
      0 2px 18px
      rgba(0, 0, 0, 0.18);
  }

  .project-card-receipt
  .receipt-card-content small {
    color:
      rgba(255, 255, 255, 0.82);
  }

  .receipt-card-footer {
    position: relative;

    z-index: 2;

    background:
      rgba(20, 28, 23, 0.34);

    backdrop-filter:
      blur(10px);

    -webkit-backdrop-filter:
      blur(10px);

    color: #ffffff;

    border-top:
      1px solid
      rgba(255, 255, 255, 0.12);
  }

  .project-card-receipt:hover
  .receipt-card-background img {
    opacity: 0.76;

    filter:
      blur(0.8px)
      saturate(1);

    transform:
      translateX(-50%)
      scale(1.04);
  }

  .receipt-card-content span {
    font-family:
      "Courier Prime",
      monospace;

    font-size: 0.52rem;

    letter-spacing: 0.06em;
  }

  .receipt-card-content strong {
    margin-top: auto;

    font-family:
      "Instrument Serif",
      serif;

    font-size:
      clamp(
        2.3rem,
        3vw,
        4rem
      );

    font-weight: 400;

    line-height: 0.9;
  }

  .receipt-card-content small {
    margin-top: 8px;

    font-family:
      "Courier Prime",
      monospace;

    font-size: 0.58rem;
  }

  /* =========================
     ANIMATIONS
     ========================= */

  @keyframes float-scroll-cue {
    0%,
    100% {
      transform: translate(-50%, 0);
    }

    50% {
      transform: translate(-50%, -6px);
    }
  }

  @keyframes blink {
    0%,
    50% {
      opacity: 1;
    }

    51%,
    100% {
      opacity: 0;
    }
  }

  @keyframes card-float {
    0%,
    100% {
      translate: 0 4px;
    }

    50% {
      translate: 0 -14px;
    }
  }

  @keyframes card-rock {
    0%,
    100% {
      rotate: -1.2deg;
    }

    50% {
      rotate: 1.2deg;
    }
  }

  @keyframes card-float-mobile {
    0%,
    100% {
      translate: 0 2px;
    }

    50% {
      translate: 0 -8px;
    }
  }

  @keyframes card-rock-mobile {
    0%,
    100% {
      rotate: -0.7deg;
    }

    50% {
      rotate: 0.7deg;
    }
  }

  /* =========================
     MOBILE
     ========================= */

  @media (max-width: 640px) {
    .hero {
      min-height: calc(100vh - 110px);

      padding: 24px 18px 120px;
    }

    .hero-content {
      width: 100%;
    }

    .hero-intro {
      font-size: clamp(2rem, 10vw, 3.5rem);

      line-height: 1;
    }

    .typewriter-wrapper {
      min-height: 2.1em;

      margin-top: 12px;

      font-size: clamp(2.2rem, 11vw, 4rem);
    }

    .receipt-card-background img {
      bottom: 2%;

      width: 92%;
      height: 92%;

      opacity: 0.66;

      filter:
        blur(1.5px)
        saturate(0.9);
    }

    .project-card-receipt:hover
    .receipt-card-background img {
      opacity: 0.66;

      filter:
        blur(1.5px)
        saturate(0.9);

      transform:
        translateX(-50%)
        scale(1);
    }

    .scroll-cue {
      bottom: 82px;

      padding: 7px 11px;

      font-size: 0.56rem;
    }

    .projects-section {
      min-height: 100vh;

      padding: 80px 18px 100px;
    }

    .projects-heading {
      margin-bottom: 38px;
    }

    .projects-heading h2 {
      font-size: 3.2rem;
    }

    .project-cards {
      display: flex;

      gap: 14px;

      overflow-x: auto;
      overflow-y: visible;

      padding: 12px 4px 24px;

      scroll-snap-type: x mandatory;

      scrollbar-width: none;
    }

    .project-cards::-webkit-scrollbar {
      display: none;
    }

    .project-card {
      flex: 0 0 68%;

      aspect-ratio: 0.72;

      scroll-snap-align: center;

      animation:
        card-float-mobile 6s ease-in-out infinite,
        card-rock-mobile 8s ease-in-out infinite;
    }

    .project-card:nth-child(1) {
      animation-duration: 5.8s, 7.6s;
      animation-delay: -1.4s, -3.1s;
    }

    .project-card:nth-child(2) {
      animation-duration: 6.5s, 8.3s;
      animation-delay: -3.5s, -0.8s;
    }

    .project-card:nth-child(3) {
      animation-duration: 5.6s, 7.1s;
      animation-delay: -2.4s, -4.3s;
    }

    .project-card:nth-child(4) {
      animation-duration: 6.9s, 8s;
      animation-delay: -4.7s, -1.6s;
    }

    .project-card:nth-child(5) {
      animation-duration: 5.3s, 8.6s;
      animation-delay: -1s, -3.6s;
    }

    .project-card-footer {
      padding: 12px 13px;

      font-size: 0.66rem;
    }
  }

  /* =========================
     REDUCED MOTION
     ========================= */

  @media (prefers-reduced-motion: reduce) {
    .scroll-cue,
    .cursor,
    .project-card {
      animation: none;
    }

    .projects-inner {
      opacity: 1;

      transform: none;

      transition: none;
    }

    .project-card {
      translate: none;
      rotate: none;

      transition: none;
    }
  }
</style>