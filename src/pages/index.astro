    display: block;
    color: #111111;
    font-family: "Instrument Serif", Georgia, serif;
    font-size: 2.9rem;
    font-weight: 400;
    line-height: 1;
    letter-spacing: -0.01em;
    overflow-wrap: anywhere;
  }

  .hero-orbit-card__text {
    display: block;
    color: #666666;
    font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Helvetica, Arial, sans-serif;
    font-size: 1.1rem;
    line-height: 1.6;
    overflow-wrap: anywhere;
    text-wrap: pretty;
  }

  .hero-orbit-dialog__close {
    position: fixed;
    top: 20px;
    right: 20px;
    z-index: 2;
    display: grid;
    place-items: center;
    width: 40px;
    height: 40px;
    padding: 0;
    border: 1px solid rgba(17, 17, 17, 0.08);
    border-radius: 50%;
    background: rgba(255, 255, 255, 0.7);
    backdrop-filter: blur(8px);
    -webkit-backdrop-filter: blur(8px);
    color: #111111;
    font-size: 1.3rem;
    line-height: 1;
    cursor: pointer;
    touch-action: manipulation;
    -webkit-tap-highlight-color: transparent;
    transition:
      background-color 160ms var(--ease-out),
      transform 120ms var(--ease-out);
  }

  .hero-orbit-dialog__close:active {
    transform: scale(0.95);
  }

  .hero-orbit-dialog__close:focus-visible {
    outline: 2px solid rgba(77, 118, 87, 0.6);
    outline-offset: 3px;
  }

  @media (hover: hover) and (pointer: fine) {
    .hero-orbit-dialog__close:hover {
      background: #ffffff;
    }

    .hero-orbit-card.is-front:hover {
      transform: translateY(-2px);
    }

    .hero-orbit-card.is-front:hover .hero-orbit-card__media img {
      transform: scale(1.03);
    }

    .hero-orbit-card.is-front:hover:active {
      transform: scale(0.98);
    }

    .hero-orbit-card.is-front.is-out:hover {
      transform: translateY(18px) scale(0.97);
    }

    .hero-orbit-card__gate-btn:hover {
      background: #4d7657;
      color: #ffffff;
    }
  }

  /* ---------- orbit items ---------- */
  .hero-orbit-items {
    position: absolute;
    inset: 0;
    /* no z-index on purpose: must not form a stacking context, so each
       item can sit below (entrance) or above (settled) the portrait */
    pointer-events: none;
  }

  .hero-orbit-item {
    position: absolute;
    top: 50%;
    left: 50%;
    --orbit-rotation: 0deg;
    z-index: 3;
    display: block;
    width: clamp(78px, 10vw, 138px);
    padding: 0;
    border: 0;
    background: transparent;
    cursor: pointer;
    opacity: 0;
    pointer-events: auto;
    touch-action: pan-y;
    user-select: none;
    -webkit-user-select: none;
    -webkit-touch-callout: none;
    -webkit-tap-highlight-color: transparent;
    transform: translate(-50%, -50%);
    will-change: transform;
    transition: opacity 240ms var(--orbit-ease-out);
  }

  .hero-orbit-item.is-ready {
    opacity: 1;
  }

  .hero-orbit-item:focus-visible {
    z-index: 4;
    outline: 2px solid rgba(77, 118, 87, 0.6);
    outline-offset: 6px;
    border-radius: 14px;
  }

  .hero-orbit-item.is-dragging {
    z-index: 5;
    cursor: grabbing;
  }

  .hero-orbit-item:not(.is-ready),
  .hero-orbit-item.is-behind {
    pointer-events: none;
  }

  .hero-orbit-item.is-behind {
    z-index: 1;
  }

  .hero-orbit-float {
    display: block;
    transform-origin: 50% 60%;
    animation: hero-orbit-float var(--orbit-duration, 5.2s) ease-in-out infinite;
    animation-delay: var(--orbit-delay, 0s);
    transition: filter 160ms var(--orbit-ease-out);
  }

  .hero-orbit-item:focus-visible .hero-orbit-float {
    animation-play-state: paused;
    filter: drop-shadow(0 8px 8px rgba(17, 17, 17, 0.12));
  }

  .hero-orbit-item img {
    display: block;
    width: 100%;
    height: auto;
    pointer-events: none;
    -webkit-user-drag: none;
    transform-origin: center;
    transition: transform 180ms var(--orbit-ease-out);
  }

  .hero-orbit-item:focus-visible img {
    transform: scale(1.12);
  }

  @media (hover: hover) and (pointer: fine) {
    .hero-orbit-item:hover {
      z-index: 4;
    }

    .hero-orbit-item:hover .hero-orbit-float {
      animation-play-state: paused;
      filter: drop-shadow(0 8px 8px rgba(17, 17, 17, 0.12));
    }

    .hero-orbit-item:hover img {
      transform: scale(1.16);
    }
  }

  /* dragging must come after hover so it wins at equal specificity */
  .hero-orbit-item.is-dragging .hero-orbit-float {
    animation-play-state: paused;
    filter: drop-shadow(0 16px 14px rgba(17, 17, 17, 0.2));
  }

  .hero-orbit-item.is-dragging img,
  .hero-orbit-item.is-dragging:hover img {
    transform: scale(1.08);
  }

  /* press: after hover/drag so ordering is explicit; drag still wins via :not(.is-dragging) */
  .hero-orbit-item:active:not(.is-dragging) img {
    transform: scale(0.94);
    transition-duration: 120ms;
  }

  @media (hover: hover) and (pointer: fine) {
    .hero-orbit-item:hover:active:not(.is-dragging) img {
      transform: scale(1.08);
    }
  }

  .hero-orbit-label {
    position: relative;
    z-index: 10;
    display: block;
    width: max-content;
    max-width: 150px;
    margin: 0 auto 5px;
    padding: 4px 7px;
    border: 1px solid rgba(17, 17, 17, 0.1);
    border-radius: 999px;
    background: rgba(237, 236, 234, 0.96);
    color: #555555;
    font: 0.70rem var(--font-reading);
    letter-spacing: 0.06em;
    line-height: 1;
    white-space: nowrap;
    pointer-events: none;
  }

  .orbit-laptop { width: clamp(88px, 12vw, 150px); }
  .orbit-cap { width: clamp(58px, 8vw, 88px); }
  .orbit-gloves { width: clamp(78px, 10vw, 122px); }
  .orbit-soysauce { width: clamp(46px, 6vw, 72px); }

  .hero-main-trigger {
    position: absolute;
    right: 1%;
    bottom: 0;
    z-index: 2;
    width: 72%;
    height: 92%;
    padding: 0;
    border: 0;
    background: transparent;
    transition: filter 180ms ease, transform 180ms ease;
  }

  /* Hover lift only; the portrait has no click action. */
  @media (hover: hover) and (pointer: fine) {
    .hero-main-trigger:hover {
      filter: drop-shadow(0 10px 10px rgba(17, 17, 17, 0.12));
      transform: scale(1.005);
    }

    .hero-main-trigger:hover .hero-main-image {
      transform: scale(1.01);
    }
  }

  .hero-main-label {
    position: absolute;
    top: 24%;
    left: 66%;
    z-index: 1;
    display: block;
    width: max-content;
    padding: 4px 8px;
    border: 1px solid rgba(17, 17, 17, 0.1);
    border-radius: 999px;
    background: rgba(237, 236, 234, 0.86);
    color: #555555;
    font: 0.58rem var(--font-reading);
    letter-spacing: 0.08em;
    transform: translateX(-50%);
  }

  .hero-main-image {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: contain;
    object-position: center bottom;
    filter: drop-shadow(0 10px 12px rgba(17, 17, 17, 0.12));
    transform-origin: center bottom;
    transition: transform 180ms ease;
  }

  @keyframes hero-orbit-float {
    0%, 100% {
      transform: translate3d(calc(-1 * var(--orbit-sway, 0px)), 0, 0) rotate(var(--orbit-rotation));
    }
    50% {
      transform: translate3d(var(--orbit-sway, 0px), calc(-1 * var(--orbit-lift, 8px)), 0) rotate(var(--orbit-rotation));
    }
  }

  .hero-green {
    color: #4d7657;
  }

  .hero-intro {
    flex: 1;

    margin: 0;

    font-family:
      "Instrument Serif",
      serif;

    font-size:
      clamp(
        2.6rem,
        5vw,
        5.4rem
      );

    font-weight: 400;

    line-height: 0.98;

    letter-spacing:
      -0.025em;

    color: #111111;
  }

  .cv-download {
    display: inline-flex;

    align-items: center;
    gap: 12px;

    flex-shrink: 0;

    align-self: flex-start;

    margin-top: 38px;
    padding: 16px 19px 15px;

    border: 1px solid rgba(17, 17, 17, 0.55);
    border-radius: 2px;

    background: rgba(237, 236, 234, 0.82);

    font-family: var(--font-reading);
    font-size: 0.8rem;
    letter-spacing: 0.06em;
    line-height: 1;

    color: #111111;

    box-shadow: 8px 9px 0 rgba(77, 118, 87, 0.24);

    animation: cv-float-rock 3.4s ease-in-out infinite;
    transform-origin: center bottom;

    transition:
      background 0.2s ease,
      border-color 0.2s ease,
      color 0.2s ease,
      box-shadow 0.2s ease,
      transform 0.2s ease;
  }

  .cv-download-arrow {
    font-size: 1rem;
    line-height: 0.7;
  }

  @keyframes cv-float-rock {
    0%, 100% { transform: translateY(0) rotate(-1deg); }
    50% { transform: translateY(-5px) rotate(1deg); }
  }

  @media (hover: hover) and (pointer: fine) {
    .cv-download:hover {
      border-color: #4d7657;
      background: #4d7657;
      color: #ffffff;
      box-shadow: 2px 2px 0 rgba(17, 17, 17, 0.18);
      animation-play-state: paused;
      transform: rotate(0deg) translateY(2px);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .cv-download { animation: none; }
  }

  .fill-game {
    display: grid;
    gap: 14px;
    min-height: 5.8em;
    margin-top: 20px;
    color: #4d7657;
  }

  .fill-options {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    align-items: center;
  }

  .fill-word {
    border: 1px solid rgba(77, 118, 87, 0.45);
    border-radius: 999px;
    padding: 9px 13px 8px;
    background: rgba(255, 255, 255, 0.3);
    font: 400 clamp(0.95rem, 1.7vw, 1.45rem)/0.95 "Instrument Serif", serif;
    letter-spacing: -0.015em;
    transition: background 0.25s ease, border-color 0.25s ease, color 0.25s ease, transform 0.25s ease;
  }

  .fill-word.is-active {
