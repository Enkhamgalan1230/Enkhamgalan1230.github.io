    let lastWidth = window.innerWidth;
    let resizeFrame = 0;
    window.addEventListener("resize", () => {
      if (resizeFrame) return;
      resizeFrame = requestAnimationFrame(() => {
        resizeFrame = 0;
        const width = window.innerWidth;
        if (width === lastWidth) return;
