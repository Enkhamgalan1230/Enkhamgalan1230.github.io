      },
      getBoundingClientRect() {
        return {
          top: 0,
          left: 0,
          width: window.innerWidth,
          height: window.innerHeight,
        };
      },
      pinType: "fixed",
    });

    const projectsSnapSection = document.querySelector<HTMLElement>(
      "[data-scroll-snap-section='projects']",
    );

    const projectsSnapContent = projectsSnapSection?.querySelector<HTMLElement>(
      ".projects-inner",
    );

    const kumoGameSnapSection = document.querySelector<HTMLElement>(
      "[data-scroll-snap-section='kumo-game']",
