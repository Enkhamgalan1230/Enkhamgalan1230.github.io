        scrollTrigger: {
          id: `section-reveal-${sectionId}`,
          trigger: section,
          start: "top 90%",
          end: "bottom 10%",
          scrub: 0.65,
          invalidateOnRefresh: true,
        },
      })
        .fromTo(
          section,
          {
            opacity: 0.68,
            scale: 0.975,
            y: 22,
          },
          {
            opacity: 1,
            scale: 1,
            y: 0,
            duration: 0.5,
            ease: "power2.out",
          },
        )
        .to(section, {
          opacity: 0.72,
          scale: 0.98,
          y: -18,
          duration: 0.5,
          ease: "power2.inOut",
        });

      sectionRevealTimelines.push(sectionTimeline);
    });
      }, 80);
    };

    const projectMedia = document.querySelectorAll<HTMLImageElement | HTMLVideoElement>(
      "img, video",
    );

    projectMedia.forEach((media) => {
      media.addEventListener("load", refreshProjectScroll);
      media.addEventListener("loadedmetadata", refreshProjectScroll);
    });

