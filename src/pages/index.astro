      gsap.ticker.remove(onGsapTick);
      window.clearTimeout(refreshTimer);
      window.removeEventListener("load", refreshProjectScroll);
      window.removeEventListener("resize", refreshProjectScroll);
      projectMedia.forEach((media) => {
        media.removeEventListener("load", refreshProjectScroll);
        media.removeEventListener("loadedmetadata", refreshProjectScroll);
