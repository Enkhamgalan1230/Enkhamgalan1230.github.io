      }
    });

    projectsSnapContent?.style.setProperty("transition", "none");
    kumoGameSnapContent?.style.setProperty("transition", "none");

    const projectsSnapTimeline = projectsSnapSection && projectsSnapContent
      ? gsap.timeline({
          defaults: {
            ease: "power2.out",
          },
          scrollTrigger: {
            id: "projects-scroll-snap",
            trigger: projectsSnapSection,
            start: "top top",
            end: "+=800",
            pin: true,
            pinSpacing: true,
            scrub: 0.8,
            anticipatePin: 1,
            invalidateOnRefresh: true,
            snap: {
              snapTo: "labelsDirectional",
              inertia: false,
              duration: { min: 0.16, max: 0.3 },
              delay: 0.3,
              ease: "power1.inOut",
            },
          },
        })
          .addLabel("enter")
          .fromTo(
            projectsSnapContent,
            {
              opacity: 0.6,
              scale: 0.95,
              y: 24,
            },
            {
              opacity: 1,
              scale: 1,
              y: 0,
              duration: 0.28,
            },
